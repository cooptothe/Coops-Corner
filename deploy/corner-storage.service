[Unit]
Description=Corner disk retention and verified ledger compaction below 50 percent
After=postgresql.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/srv/corner/app
ExecStart=/usr/bin/python3 /usr/local/lib/corner-storage/corner_storage.py --apply
TimeoutStartSec=2h
KillSignal=SIGINT
TimeoutStopSec=60
UMask=0077
Nice=10
