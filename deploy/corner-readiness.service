[Unit]
Description=Corner anonymous HTTPS readiness check (no odds or payment calls)
After=network-online.target corner-staging-web.service
Wants=network-online.target

[Service]
Type=oneshot
User=corneradmin
Group=corneradmin
WorkingDirectory=/srv/corner/app
ExecStart=/srv/corner/app/.venv-api/bin/python -m pipelines.release_probe --samples 1 --concurrency 1 --output /srv/corner/app/retained/release-evidence/public-readiness.json
TimeoutStartSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/corner/app/retained/release-evidence
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
