tml":null,"page_type":"Reference","side":null,"media_type":null,"media_html":null,"media_image":null,"media_code":null,"group0":null,"group1":null,"group2":null}],"promo":{"title":"THE SPORTRADAR  BASKETBALL API","text":"Welcome to the Sportradar developer hub. You'll find comprehensive guides and documentation to help you start working with Sportradar as quickly as possible, as well as support if you get stuck. Let's jump right in!","content_type":"buttons","html":null,"button_primary":"reference","button_secondary":"changelog"}},"footer":{"readme_logo":"show"},"logo":{"size":"default","dark_mode":{"uri":null,"url":null,"name":null,"width":null,"height":null,"color":null,"links":{"original_url":null}},"main":{"uri":null,"url":"https://files.readme.io/6ca30cb-small-Sportradar_logo_RGB_white-300x50.png","name":"Sportradar_logo_RGB_white-300x50.png","width":300,"height":50,"color":"#ffcfcf","links":{"original_url":"https://files.readme.io/16086f6-Sportradar_logo_RGB_white-300x50.png"}},"favicon":{"uri":"/images/64f1ecf37047e1042cd24fd8","url":"https://files.readme.io/cca962f-small-Radar_sportradar_sr.png","name":"cca962f-small-Radar_sportradar_sr.png","width":16,"height":17,"color":"#ff0000","links":{"original_url":"https://files.readme.io/e5de6dc-Radar_sportradar_sr.png"}}},"typography":{"heading_font":null,"body_font":null,"code_font":null,"spacing":null,"custom_heading":{"url":null,"filename":null,"format":null},"custom_code":{"url":null,"filename":null,"format":null},"custom_body":{"regular":{"url":null,"filename":null,"format":null},"medium":{"url":null,"filename":null,"format":null},"semibold":{"url":null,"filename":null,"format":null}}},"ai":{"dropdown":"disabled","options":{"ask_ai":"disabled","chatgpt":"enabled","claude":"enabled","clipboard":"enabled","view_as_markdown":"enabled","mcp":{"command":"enabled","config":"enabled","cursor":"enabled","vscode":"enabled"}}},"custom_code":{"css":"header .Button_secondary_text:not(:disabled):not(.Button_secondary_text.Button_disabled):hover, .Button_secondary_text:not(:disabled):not(.Button_secondary_text.Button_disabled)[aria-expanded=true] {\n    background: none;\n    color: white !important;\n}\n\n/* Sticky Header */\n/* Make the header sticky */\n.rm-Header {\n    position: sticky !important;\n    top: 0 !important;\n    z-index: 100;\n}\n\n.rm-VersionDropdown {\n    display: block ! Important;\n}\n\n/* Left Nav Scroll Fix */\n.reference-redesign.Nav3C5f8FcjkaHj {\n    max-height: 80vh !important;\n    overflow-y: auto;\n    padding-bottom: 2vh;\n}\n\n/* Right Side Ref Section - need space up top */\n.rm-Playground {\n    margin-top: 20px;\n}\n\n/* Hide \"Docs\" dropdown (could use JS but causes issuess?) */\n.rm-Header-bottom>div>nav>div:nth-child(2),\n#ssr-main>div>header>div.Header-bottom2eLKOFXMEmh5.rm-Header-bottom>div>nav>div:nth-child(2),\n#ssr-main>div>header>div.Header-bottom2eLKOFXMEmh5.rm-Header-bottom>div>nav>div:nth-child(3) {\n    display: none;\n}\n\n/* browser will scroll down by 100px from the top for anchors*/\ndiv,\na {\n    scroll-margin-top: 100px !important;\n}\n\n.footer-links a:hover {\n    text-decoration: underline !important;\n}\n\n.field-description a[href],\n.field-description a:not([href='']),\n.markdown-body a[href],\n.markdown-body a:not([href='']) {\n    text-decoration: none;\n}\n\n/* Adjust the position of the TOC to account for the sticky header */\n.content-toc {\n    position: sticky !important;\n    top: 91px !important;\n}\n\n.rm-Sidebar {\n    top: 121px !important;\n}\n\n/* ==========================================================\n   SPORTRADAR README PROJECT PICKER — CUSTOM CSS\n   Rewritten 2026-09-10.\n\n   Scoping rules — please keep to these:\n\n   1. Scope ONLY on `.rm-ProjectPicker-menu`. That is a stable class\n      ReadMe commits to. The previous version was scoped on\n      `.Box2uBHSWG8DzPz.Box_pop1YKwQaFwZu8z`, which are webpack\n      CSS-module hashes that ReadMe regenerates whenever that\n      component changes. The menu now ships as\n      `class=\"Box Menu Menu_light rm-ProjectPicker-menu\"` — the\n      hashes are gone, which is why every rule here stopped matching.\n      Never reintroduce a hashed class name.\n\n   2. Select items by `[href^=\"/\u003csubdomain>/\"]`, never by\n      `:nth-child()`. The picker re-indexes whenever a project is\n      added, removed, renamed or reordered in the dash, which\n      scrambled the whole grid.\n\n   To add a sport: add its href to the \"sport tiles\" selector list,\n   give it a grid position in the row block, and add its icon URL.\n   ========================================================== */\n\n/* ---------- WIDE LAYOUT (>= 1100px): 1 service rail + 6-col sport grid ---------- */\n@media screen and (min-width: 1100px) {\n\n  .rm-ProjectPicker-menu {\n    display: grid !important;\n    grid-template-columns: 280px repeat(6, calc((1100px - 280px) / 6)) !important;\n    grid-template-rows: repeat(28, 9px) !important;\n    width: 1100px !important;\n    min-width: 1100px !important;\n    max-width: 1100px !important;\n    height: 252px !important;\n    max-height: 252px !important;\n    overflow: hidden !important;\n    padding: 0 !important;\n    column-count: unset !important;\n    background: #eceff1 !important;\n    align-items: stretch !important;\n    gap: 0 !important;\n  }\n\n  .rm-ProjectPicker-menu a.Menu-Item {\n    box-sizing: border-box !important;\n    line-height: 1.3 !important;\n    max-height: none !important;\n    text-align: left !important;\n    font-family: Source Sans Pro, sans-serif !important;\n    width: auto !important;\n    display: flex !important;\n    align-items: center !important;\n    overflow: hidden !important;\n\n    /* Strip ReadMe's own per-item chrome so tiles sit flush in their grid\n       cell and read as one table. ReadMe's Menu-Item now ships with a\n       margin, a corner radius and a border on all four sides; without\n       these resets every tile is inset inside its cell and looks shrunken.\n       The rules below re-add only the borders this layout wants. */\n    margin: 0 !important;\n    border: none !important;\n    border-radius: 0 !important;\n    box-shadow: none !important;\n    min-height: 0 !important;\n    min-width: 0 !important;\n    height: auto !important;\n    outline: none !important;\n  }\n\n  /* ---------- Service rail (grid column 1) ---------- */\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-getting-started/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-api/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-odds/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-images-content/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-insights/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-widgets/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-broadcast/\"] {\n    grid-column: 1 !important;\n    background: #eceff1 !important;\n    border-bottom: 1px solid #fff !important;\n    border-right: 1px solid #ddd !important;\n    text-transform: uppercase !important;\n    font-size: 11.5px !important;\n    font-weight: 700 !important;\n    color: #1a237e !important;\n    padding: 0 14px !important;\n    letter-spacing: 0.02em !important;\n    transition: background 0.15s, color 0.15s !important;\n    white-space: nowrap !important;\n    align-self: stretch !important;\n  }\n\n  /* Service rail order, top to bottom */\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-getting-started/\"] { grid-row: 1 / span 4 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-api/\"]             { grid-row: 5 / span 4 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-odds/\"]            { grid-row: 9 / span 4 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-images-content/\"]  { grid-row: 13 / span 4 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-insights/\"]        { grid-row: 17 / span 4 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-widgets/\"]         { grid-row: 21 / span 4 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-broadcast/\"]       { grid-row: 25 / span 4 !important; }\n\n  /* Service rail hover (every rail item except SPORTS API, which is a static header) */\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-getting-started/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-odds/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-images-content/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-insights/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-widgets/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-broadcast/\"]:hover {\n    background: #ff0000 !important;\n    color: #fff !important;\n  }\n\n  /* SPORTS API — the label for the sport grid to its right, not a link */\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-api/\"] {\n    background: #1a237e !important;\n    color: #fff !important;\n    border-bottom: 1px solid #283593 !important;\n    border-right: 1px solid #283593 !important;\n    pointer-events: none !important;\n    position: relative !important;\n  }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-api/\"]::after {\n    content: '' !important;\n    position: absolute !important;\n    right: -8px !important;\n    top: 50% !important;\n    transform: translateY(-50%) !important;\n    border: 8px solid transparent !important;\n    border-left-color: #1a237e !important;\n    z-index: 10 !important;\n  }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-api/\"]::before {\n    content: '\\25B6' !important;\n    position: absolute !important;\n    right: 10px !important;\n    top: 50% !important;\n    transform: translateY(-50%) !important;\n    font-size: 14px !important;\n    color: rgba(255, 255, 255, 0.7) !important;\n    pointer-events: none !important;\n    /* override the sport-tile icon box below */\n    width: auto !important;\n    min-width: 0 !important;\n    height: auto !important;\n    margin-right: 0 !important;\n    background-image: none !important;\n    display: inline !important;\n  }\n\n  /* ---------- Sport tiles (grid columns 2-7) ---------- */\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-soccer/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-basketball/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-football/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-baseball/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-hockey/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-cricket/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-racing/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-tennis/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-golf/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-mma/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-rugby/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-handball/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-aussie-football/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-badminton/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-bandy/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-darts/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-field-hockey/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-futsal/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-snooker/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-squash/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-table-tennis/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-volleyball/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-baseline/\"] {\n    background: #fafafa !important;\n    color: #283593 !important;\n    font-size: 12px !important;\n    font-weight: 400 !important;\n    text-transform: none !important;\n    padding: 0 8px !important;\n    justify-content: flex-start !important;\n    border-bottom: 0.5px solid #eeeeee !important;\n    border-right: 0.5px solid #e0e0e0 !important;\n    border-top: none !important;\n    letter-spacing: 0 !important;\n    transition: background 0.12s, color 0.12s !important;\n    white-space: nowrap !important;\n    text-overflow: ellipsis !important;\n    align-self: stretch !important;\n    gap: 6px !important;\n  }\n\n  /* Sport grid row 1 */\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-soccer/\"]          { grid-column: 2 !important; grid-row: 1 / span 7 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-basketball/\"]      { grid-column: 3 !important; grid-row: 1 / span 7 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-football/\"]        { grid-column: 4 !important; grid-row: 1 / span 7 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-baseball/\"]        { grid-column: 5 !important; grid-row: 1 / span 7 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-hockey/\"]          { grid-column: 6 !important; grid-row: 1 / span 7 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-cricket/\"]         { grid-column: 7 !important; grid-row: 1 / span 7 !important; }\n  /* Sport grid row 2 */\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-racing/\"]          { grid-column: 2 !important; grid-row: 8 / span 7 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-tennis/\"]          { grid-column: 3 !important; grid-row: 8 / span 7 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-golf/\"]            { grid-column: 4 !important; grid-row: 8 / span 7 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[hre