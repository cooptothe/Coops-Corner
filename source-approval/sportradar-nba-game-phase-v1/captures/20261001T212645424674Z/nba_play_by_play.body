; }\n  .rm-ProjectPicker-menu a[href^=\"/sportradar-darts/\"]::before           { background-image: url('https://files.readme.io/390cd3b-Darts_target.svg') !important; }\n  .rm-ProjectPicker-menu a[href^=\"/sportradar-field-hockey/\"]::before    { background-image: url('https://files.readme.io/7479e94-Field_Hockey.svg') !important; }\n  .rm-ProjectPicker-menu a[href^=\"/sportradar-futsal/\"]::before          { background-image: url('https://files.readme.io/0db4cff-Futsal.svg') !important; }\n  .rm-ProjectPicker-menu a[href^=\"/sportradar-snooker/\"]::before         { background-image: url('https://files.readme.io/4e537d4-Snooker_Billiards_pool.svg') !important; }\n  .rm-ProjectPicker-menu a[href^=\"/sportradar-squash/\"]::before          { background-image: url('https://files.readme.io/58ff631-Squash_tennis_racket.svg') !important; }\n  .rm-ProjectPicker-menu a[href^=\"/sportradar-table-tennis/\"]::before    { background-image: url('https://files.readme.io/954dfa4-Table_tennis_ping_pong_paddle_racket.svg') !important; }\n  .rm-ProjectPicker-menu a[href^=\"/sportradar-volleyball/\"]::before      { background-image: url('https://files.readme.io/d5f6552-Volleyball_beach_water.svg') !important; }\n  .rm-ProjectPicker-menu a[href^=\"/sportradar-baseline/\"]::before        { background-image: url('https://files.readme.io/5782de5a675dc8cdff56ee7c72cba94f3d99117b3904334353eccb5c0fcd08dc-Arrow_Bullet.png') !important; }\n\n  /* Legacy hook: inline \u003cimg class=\"sr-sport-icon\"> if any item ever carries one */\n  .rm-ProjectPicker-menu a.Menu-Item img.sr-sport-icon {\n    width: 16px !important;\n    height: 16px !important;\n    object-fit: contain !important;\n    opacity: 1 !important;\n    flex-shrink: 0 !important;\n  }\n}\n\n/* ---------- NARROW LAYOUT (\u003c 1100px): plain single-column list ----------\n   This block used to be nested inside the min-width:1100px query above, so\n   it could never match and the dropdown had no styling at all on small\n   screens. Keep it at the top level.                                      */\n@media screen and (max-width: 1099px) {\n  .rm-ProjectPicker-menu {\n    display: flex !important;\n    flex-direction: column !important;\n    width: auto !important;\n    min-width: 200px !important;\n    max-width: 320px !important;\n    height: auto !important;\n    max-height: 70vh !important;\n    overflow-y: auto !important;\n    overflow-x: hidden !important;\n    grid-template-columns: unset !important;\n    grid-template-rows: unset !important;\n    padding: 4px 0 !important;\n    background: #fff !important;\n  }\n  .rm-ProjectPicker-menu a.Menu-Item {\n    grid-column: unset !important;\n    grid-row: unset !important;\n    width: 100% !important;\n    background: #fff !important;\n    color: #1a237e !important;\n    font-size: 13px !important;\n    font-weight: 600 !important;\n    padding: 8px 16px !important;\n    margin: 0 !important;\n    border: none !important;\n    border-bottom: 0.5px solid #f0f0f0 !important;\n    border-radius: 0 !important;\n    box-shadow: none !important;\n    /* min-height:0 drops ReadMe's 36px floor so row height is just text +\n       padding; flex:0 0 auto stops the rows compressing to nothing when\n       something constrains the container's height. Both are needed. */\n    min-height: 0 !important;\n    flex: 0 0 auto !important;\n    text-transform: none !important;\n    white-space: nowrap !important;\n    display: flex !important;\n    align-items: center !important;\n    order: unset !important;\n    position: static !important;\n    pointer-events: auto !important;\n  }\n  .rm-ProjectPicker-menu a.Menu-Item:hover {\n    background: #e8eaf6 !important;\n    color: #1a237e !important;\n  }\n  .rm-ProjectPicker-menu a.Menu-Item::after,\n  .rm-ProjectPicker-menu a.Menu-Item::before {\n    display: none !important;\n  }\n}\n\n/* ---------- Projects hidden from the picker at every width ---------- */\n.rm-ProjectPicker-menu a[href*=\"sportradar-additional\"],\n.rm-ProjectPicker-menu a[href*=\"sportradar-thirdparty\"],\n.rm-ProjectPicker-menu a[href*=\"testbasketball\"],\n.rm-ProjectPicker-menu a[href*=\"sportradar-updates\"] {\n  display: none !important;\n}\n\n/*API Reference Pages - move all custom markdown BELOW body params, etc. */\n.rm-ReferenceMain .rm-Article {\n    display: flex;\n    flex-direction: column;\n}\n\n.rm-ParamContainer {\n    order: 1;\n}\n\n.rm-ReferenceMain .rm-Article .rm-APISectionHeader {\n    order: 3;\n}\n\n[class^=\"APIResponseSchemaPicker\"] {\n    order: 6;\n}\n\n\n.field-description,\n.markdown-body {\n    order: 7;\n    display: flow-root;\n}\n\nheader.APISectionHeader3LN_-QIR0m7x.rm-APISectionHeader {\n    order: 7;\n}\n\n.rm-ReferenceMain .markdown-body {\n    margin-top: 10px\n}\n\n[class^=\"Footer-desktop\"] {\n    order: 8;\n}\n\n/*Hide left mobile nav items*/\n.Header-left-nav2xWPWMNHOGf_ {\n    display: none !important;\n    right: 0px;\n}\n\n.VersionBadge_green3W-ZN3BtOcAO {\n    display: none !important;\n}\n\n/*Hide Request History Section*/\n.rm-ReferenceMain article .Reference-section {\n    display: none;\n}\n\ndiv[class^=\"MobileFlyout\"] a[class^=\"NavItem-item\"]:nth-child(n+2):nth-child(-n+6) {\n    display: none;\n}\n\ndiv[class^=\"MobileFlyout\"] {\n    right: 0px;\n}\n\n\n.Header3zzata9F_ZPQ {\n    background-color: #283593;\n    position: fixed;\n}\n\n.rm-Header-top {\n    background-color: #283593;\n    height: 56px;\n    align-items: center;\n    font-size: 1rem;\n    border-bottom: none;\n}\n\n.Header-topuTMpygDG4e1V,\n.rm-Header-top,\n.Header3zzata9F_ZPQ.rm-Header {\n    height: 56px;\n}\n\n.rm-Header-bottom {\n    font-size: .9rem;\n    background-color: #283593;\n    /*padding-bottom:.2rem;*/\n}\n\n.Header-right21PC2XTT6aMg {\n    display: flex;\n}\n\n.Flyout95xhYIIoTKtc {\n    right: 0;\n    left: auto;\n    -webkit-animation: none;\n}\n\n\n.Flyout95xhYIIoTKtc.Flyout_opened3uIGGx28QgO7.rm-Flyout {\n    right: 0;\n    left: auto;\n    -webkit-animation: none;\n}\n\n.footer.container>* {\n    justify-content: center;\n    max-width: 1440px !important;\n    padding-left: 2rem !important;\n    padding-right: 2rem !important;\n    display: flex;\n    padding-top: .75rem !important;\n    padding-bottom: .75rem !important;\n    margin-left: auto !important;\n    margin-right: auto !important;\n}\n\n/*hide staging preview*/\n.Header-staging2fhBvH-z5mvq.Banner2qY-Hhfqm_Gx.Banner_secondary1reFai47T0j4.Banner_smUPcJRlth4_Dl.Banner_fixeda1mFpjcc1TJ6 {\n    display: none;\n}\n\n.App {\n    font-family: Source Sans Pro !important;\n    text-rendering: geometricPrecision;\n}\n\n/*targets fonts in body*/\nh1,\nh2,\na:not(.fa),\np,\n.toc-list,\n.Sidebar-item23D-2Kd61_k3 {\n    font-family: Source Sans Pro !important;\n    text-rendering: geometricPrecision;\n    /*font-size:1rem;*/\n}\n\n/*left side bar*/\n.reference-redesign .Sidebar-link2Dsha-r-GKh2 {\n    font-size: 1rem;\n}\n\n/*table of contents font size*/\n.content-toc a {\n    font-size: 1rem;\n}\n\n/*Release Log H1 Class*/\nh1.ChangelogPost_title1wfGHpCMrYb1.ChangelogPost_titleexcerpttFbeBG-OZgYd a {\n    font-family: Source Sans Pro !important;\n    text-rendering: geometricPrecision;\n    font-size: 1.35rem;\n    font-weight: 600;\n}\n\nh2.heading.heading-2.header-scroll {\n    font-family: Source Sans Pro !important;\n    text-rendering: geometricPrecision;\n    font-size: 1.35rem;\n    font-weight: 600;\n}\n\nh3.heading.heading-3.header-scroll {\n    font-family: Source Sans Pro;\n    text-rendering: geometricPrecision;\n    font-size: 1.15rem;\n    font-weight: 600;\n}\n\n/*entire center column*/\n.rm-Article {\n    font-family: Source Sans Pro;\n    text-rendering: geometricPrecision;\n    padding: 64px 40px !important;\n}\n\n/*code font*/\n.cm-s-neo {\n    font-size: 100%;\n}\n\n/*code snippet font*/\n.cm-s-neo>* {\n    font-size: 95%;\n}\n\n.CodeTabs-toolbar {\n    font-family: Source Sans Pro;\n    text-rendering: geometricPrecision;\n    font-size: 115%;\n}\n\n.rm-Header-bottom {\n    margin: 0;\n}\n\n.Main-QuickNav-container1OiLvjSDusO6 {\n    padding: 4px 20px 10px;\n}\n\n.reference-redesign.Nav3C5f8FcjkaHj.rm-Sidebar_guides .rm-Sidebar {\n    padding-top: 0px;\n}\n\n.reference-redesign .Sidebar1t2G1ZJq-vU1 {\n    padding: 12px;\n}\n\n/*.Box2uBHSWG8DzPz.Box_pop1YKwQaFwZu8z.Menu.Menu_light.Box>* {\n  width:10%;\n} */\n\n/*Secondary Dropdown Items -  */\n.Menu-Item.Menu-Item-alignIcon_left.Menu-Item_link {\n    font-size: .95rem;\n}\n\n/*Remove GET from sidebar display*/\n.rm-Sidebar-list .APIMethod {\n    display: none;\n}\n\n/*Remove \"Defaults to\" text in sandboxes*/\ndiv[class^=\"Param-default-label\"] {\n    display: none !important;\n}\n\n/*h1 in body*/\n.App .rm-SuggestedEdits header h1,\n.App .rm-SuggestionDiff header h1,\n.App .rm-Guides header h1,\n.App .rm-ReferenceMain header h1,\n.App .rm-Changelog header h1,\n.App .rm-Discuss header h1,\n.App .rm-CustomPage header h1 {\n    font-weight: 600;\n}\n\ncode {\n    font-size: 85%;\n}\n\n/*Sandbox text*/\n.rm-ParamContainer a {\n  font-size: inherit !important;\n}\n\np {font-size:1rem;}\n\n.rm-ReferenceMain .rm-Article {\n    padding: 60px 20px !important;\n}\n\n/* Tables only when inside \u003cdetails class=\"Accordion\"> */\ndetails.Accordion :is(table, thead, tbody, tfoot, th, td) {\n  font-size: 12px !important;\n}\n\n.rm-ReferenceMain  .markdown-body table td, .markdown-body table th {\n  padding: 6px 10px !important;\n}\n\n.Accordion-content a {\n    font-size: 12px !important;\n}\n\n/* Accordion-content only if it contains a table */\n.rm-ReferenceMain .Accordion-content {\n  padding:0 !important;\n\n}\n\n/* Hide sandbox enums */\n[class^=\"Param-enum-section\"] {\n    display: none;\n}\n\n/* Custom Cards styles - added by ReadMe Support */\n.readme-tailwind .Card {\n  --Card-bg-color: rgba(var(--color-bg-page-inverse-rgb, 0, 0, 0), 0);\n  --Card-bg-color-hover: rgba(var(--color-bg-page-inverse-rgb, 0, 0, 0), 0.05);\n  --Card-border-color: var(--color-border-default, #e5e5e5);\n  --Card-layout: column;\n  --Card-padding: 1.5em;\n}\n\n.readme-tailwind .CardsGrid {\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)) !important;\n}\n\n.readme-tailwind .Card .Card-icon.text-gray-100 {\n  color: var(--Card-icon-color, #6b7280) !important;\n}\n\n.readme-tailwind .Card img {\n  margin-left: 0;\n  margin-bottom: 0.5em;\n}\n\n.readme-tailwind .Card .Card-title {\n  margin-bottom: 0;\n}\n\n\n@media screen and (max-width: 768px) {\n.Header-topuTMpygDG4e1V,\n.rm-Header-top,\n.Header3zzata9F_ZPQ.rm-Header {\n    height: auto;\n}\n}\n\n\n@media (max-width: 768px) {\n    .Header-leftADQdGVqx1wqU {\n        display: block;\n    }\n\nnav.Header-leftADQdGVqx1wqU.Header-subnavnVH8URdkgvEl {\n    display: none;\n}\n}\n\n/* Sign Up Button */\n/* Container fix for Desktop */\n.rm-Article-header {\n  display: flex !important;\n  justify-content: space-between !important;\n  align-items: center !important;\n  width: 100% !important;\n  border-bottom: 1px solid #eeeeee;\n  padding-bottom: 15px;\n  margin-bottom: 20px;\n}\n\n/* Blue Sportradar CTA Button Styles */\n#sr-signup-cta.custom-cta-button {\n  display: inline-flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n  \n  background-color: #001E62 !important; /* Sportradar Dark Blue */\n  color: #ffffff !important;\n  \n  padding: 10px 22px !important;\n  border-radius: 4px !important;\n  font-weight: 700 !important;\n  font-size: 14px !important;\n  text-decoration: none !important;\n  white-space: nowrap !important;\n  margin-left: 20px !important; \n  \n  transition: all 0.2s ease-in-out !important;\n  box-shadow: 0 2px 5px rgba(0, 30, 98, 0.2) !important;\n}\n\n#sr-signup-cta.custom-cta-button:hover {\n  background-color: #002d91 !important;\n  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15) !important;\n  transform: translateY(-1px);\n}\n\n/** * MOBILE/TABLET FIX\n * Hide the button on screens smaller than 991px \n * to prevent squishing the header text.\n */\n@media (max-width: 991px) {\n  #sr-signup-cta.custom-cta-button {\n    display: none !important;\n  }\n  \n  .rm-Article-header {\n    display: block !important; /* Resets to standard ReadMe title layout */\n  }\n}\n\n/* ============================================================\n   Statistics Summary - Custom CSS\n   Paste into ReadMe:  Project Settings > Appearance > Custom CSS\n   ------------------------------------------------------------\n   Scoped to the .stat-card / .stat-availability classes so it\n   will not affect any other page in the project.\n   All sizing uses variables at the top - change once, applies\n   to every Statistics Summary page (MLB, NBA, NFL, etc.).\n   ============================================================ */\n\n:root {\n  --stat-card-bg:        #ffffff;     /* explicit - do NOT use a theme var; some ReadMe themes paint these dark */\n  --stat-card-border:    #e3e3df;\n  --stat-accent:         #1d6fb8;   /* Sportradar-ish link blue; adjust to brand */\n  --stat-text:           #2b2b2b;\n  --stat-muted:          #6b6b6b;\n  --stat-radius:         8px;\n  --stat-font-size:      13px;       /* shrink terms slightly so nothing wraps */\n  --stat-col-min:        220px;      /* min column width before count drops */\n  --stat-gap:            28px;\n  --stat-highlight:      #fff3bf;    /* yellow behind a matched term */\n  --stat-highlight-text: #1a1a1a;\n}\n\n/* ---------- Filter / search box ---------- */\n.stat-filter {\n  position: sticky;        /* stays in view while the customer scrolls */\n  top: 0;\n  z-index: 5;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 12px 0;\n  margin-bottom: 8px;\n  background: var(--color-bg-page, #fff);\n}\n.stat-filter input,\n.stat-filter-input {\n  flex: 1 1 auto;\n  max-width: 420px;\n  font-size: 14px;\n  padding: 9px 14px;\n  border: 1px solid var(--stat-card-border);\n  border-radius: var(--stat-radius);\n  outline: none;\n  transition: border-color 0.12s ease, box-shadow 0.12s ease;\n}\n.stat-filter input:focus,\n.stat-filter-input:focus {\n  border-color: var(--stat-accent);\n  box-shadow: 0 0 0 3px rgba(29, 111, 184, 0.15);\n}\n.stat-filter-count {\n  font-size: 13px;\n  color: var(--stat-muted);\n  white-space: nowrap;\n}\n\n/* Highlight state - a data point whose text matches the filter */\n.stat-card .stat-points li.is-match,\n.stat-card .stat-points li.is-match a {\n  background: var(--stat-highlight) !important;\n  color: var(--stat-highlight-text) !important;\n  font-weight: 500;\n  border-radius: 3px;\n  padding-left: 4px;\n  margin-left: -4px;\n}\n/* Dim state - non-matching points fade back when a filter is active */\n.stat-points.filtering li:not(.is-match) {\n  opacity: 0.25;\n}\n/* A whole category with zero matches collapses out of the way. The JS\n   sets .is-empty directly on the card AND its dropdown, and\n   .is-empty-heading on the heading. ReadMe's theme sets headings to\n   display:flex with high specificity, so we over-specify here (html\n   prefix + attribute selector) AND use !important to guarantee the win. */\nhtml .stat-card.is-empty,\nhtml .stat-availability.is-empty {\n  display: none !important;\n}\n/* Heading of a category with no matches. Multiple selectors of rising\n   specificity so at least one beats ReadMe's heading layout rule. */\nh2.is-empty-heading,\nhtml h2.is-empty-heading,\nh2[class].is-empty-heading,\n.is-empty-heading {\n  display: none !important;\n  visibility: hidden !important;\n  height: 0 !important;\n  margin: 0 !important;\n  padding: 0 !important;\n  overflow: hidden !important;\n}\n/* Any stray note paragraph belonging to an emptied category */\nhtml .stat-card.is-empty + p { display: none !important; }\n\n/* ---------- The data-point card ---------- */\n/* High-specificity, !important background because some ReadMe themes\n   render these container divs with a dark code-block style. We force a\n   light card so the terms and the yellow filter highlight stay legible. */\n.stat-card,\ndiv.stat-card {\n  background: var(--stat-card-bg) !important;\n  color: var(--stat-text) !important;\n  border: 1px solid var(--stat-card-border);\n  border-left: 3px solid var(--stat-accent);\n  border-radius: 0 var(--stat-radius) var(--stat-radius) 0;\n  padding: 18px 22px;\n  margin: 8px 0 0 0;\n}\n.stat-card .stat-points li,\n.stat-card .stat-points li a {\n  color: var(--stat-text) !important;   /* ensure dark text on the light card */\n}\n\n/* The key fix: terms live in ONE flat list and CSS flows them into\n   columns automatically. No hand-balanced 3-column tables, so every\n   card spans the full content width and adding a term needs no\n   re-balancing. */\n.stat-card .stat-points {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  column-width: var(--stat-col-min);   /* auto column count by width */\n  column-gap: var(--stat-gap);\n}\n\n.stat-card .stat-points li {\n  break-inside: avoid;                 /* never split a term across columns */\n  font-size: var(--stat-font-size);\n  line-height: 1.45;                   /* tighter - less empty vertical gap */\n  margin-bottom: 1px;\n  color: var(--stat-text);\n  white-space: nowrap;                 /* keep each term on one line       */\n  overflow: hidden;\n  text-overflow: ellipsis;             /* safety net for any extreme term  */\n  padding-right: 6px;\n}\n\n/* ---------- The \"Available in\" dropdown ---------- */\n.stat-availability,\ndetails.stat-availability {\n  margin: 0 0 28px 0;\n  border: 1px solid var(--stat-card-border);\n  border-top: none;                    /* visually continues the card      */\n  border-radius: 0 0 var(--stat-radius) var(--stat-radius);\n  background: var(--stat-card-bg) !important;\n}\n\n.stat-availability > summary {\n  cursor: pointer;\n  list-style: none;                    /* remove default disclosure marker */\n  padding: 11px 18px;\n  font-size: 13px;\n  font-weight: 500;\n  color: var(--stat-accent);\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  user-select: none;\n  transition: background 0.12s ease;\n}\n.stat-availability > summary::-webkit-details-marker { display: none; }\n\n/* Custom chevron that clearly signals \"this opens\" and rotates on open */\n.stat-availability > summary::before {\n  content: \"\";\n  width: 8px;\n  height: 8px;\n  border-right: 2px solid var(--stat-accent);\n  border-bottom: 2px solid var(--stat-accent);\n  transform: rotate(-45deg);           /* points right when closed         */\n  transition: transform 0.15s ease;\n  flex: 0 0 auto;\n}\n.stat-availability[open] > summary::before {\n  transform: rotate(45deg);            /* points down when open            */\n}\n.stat-availability > summary:hover {\n  background: #f3f6fa;\n}\n\n.stat-count {\n  color: var(--stat-muted);\n  font-weight: 400;\n  font-size: 12px;\n}\n\n/* Endpoint links flow into responsive columns, same as data points */\n.stat-availability .stat-endpoints {\n  list-style: none;\n  margin: 0;\n  padding: 4px 18px 16px 34px;\n  column-width: 240px;\n  column-gap: var(--stat-gap);\n}\n.stat-availability .stat-endpoints li {\n  break-inside: avoid;\n  line-height: 1.9;\n  font-size: 13px;\n}\n.stat-availability .stat-endpoints a {\n  text-decoration: none;\n  border-bottom: 1px solid transparent;\n}\n.stat-availability .stat-endpoints a:hover {\n  border-bottom-color: currentColor;\n}\n\n/* ---------- Always light ---------- */\n/* These cards intentionally stay light in every mode. We do NOT follow\n   prefers-color-scheme: a dark card made the yellow filter highlight and\n   the dimmed non-matches illegible. Forcing light keeps the reference\n   page predictable and print-friendly. */\n\n/* ---------- Print / PDF ---------- */\n/* When a customer prints to PDF, expand all dropdowns and drop the\n   interactive chrome so every endpoint list is fully visible. */\n@media print {\n  /* --- FIX FOR \"only one page prints\" --- */\n  /* ReadMe renders the page inside a fixed-height, internally-scrolling\n     container. The print engine only captures the visible slice and then\n     emits blank pages for the rest. These rules release every common\n     wrapper ReadMe uses so the full document flows onto paper.\n     If a future ReadMe update renames a wrapper and this regresses,\n     inspect the page, find the element with its own scrollbar, and add\n     its selector to this list. */\n  html, body,\n  #root, .App, .rm-Guides, .rm-Article, .rm-Container,\n  [class*=\"rm-\"][class*=\"Content\"],\n  [class*=\"content\"], main, article {\n    height: auto !important;\n    max-height: none !important;\n    overflow: visible !important;\n    position: static !important;\n  }\n\n  /* Hide the logged-in editor toolbar / admin chrome that prints as a\n     floating dark bar on every page. */\n  [class*=\"SuggestedEdit\"],\n  [class*=\"AdminBar\"],\n  [class*=\"rm-Header\"],\n  nav, header { display: none !important; }\n\n  .stat-availability[open],\n  .stat-availability {\n    border-color: #ccc;\n  }\n  /* Force-open content for print even if collapsed on screen */\n  .stat-availability .stat-endpoints { display: block !important; }\n  .stat-card,\n  .stat-availability { break-inside: avoid; }\n  .stat-availability > summary::before { transform: rotate(45deg); }\n  .stat-card { background: #fff; }\n}\n\n/* Move Reference page indentation */\narticle.rm-Article#content {\n  padding-left: 1.5rem;\n}\n\n\n/* Hide AskAI button during trial */\n.rm-AskAi button,\n.rm-AskAi-button,\n[class*=\"Header-ask-ai-button\"] {\n  display: none !important;\n}\n\n/* Only reveal when JS sees ?askai=1 */\nhtml.askai-enabled .rm-AskAi button,\nhtml.askai-enabled .rm-AskAi-button,\nhtml.askai-enabled [class*=\"Header-ask-ai-button\"] {\n  display: inline-flex !important;\n}\n.rm-Header-bottom > div > nav > div:nth-child(3) {\n display:block !important;\n}\n\n@media screen and (min-width: 769px) {\n  .rm-CustomPage {\n    margin-top: 40px;\n  }\n}","js":"// ******************************************************************************************\n\n\n// ****PiwikPro*****\n\n(function(window, document, dataLayerName, id) {\n  window[dataLayerName]=window[dataLayerName]||[],window[dataLayerName].push({start:(new Date).getTime(),event:\"stg.start\"});var scripts=document.getElementsByTagName('script')[0],tags=document.createElement('script');\n  function stgCreateCookie(a,b,c){var d=\"\";if(c){var e=new Date;e.setTime(e.getTime()+24*c*60*60*1e3),d=\"; expires=\"+e.toUTCString();f=\"; SameSite=Strict\"}document.cookie=a+\"=\"+b+d+f+\"; path=/\"}\n  var isStgDebug=(window.location.href.match(\"stg_debug\")||document.cookie.match(\"stg_debug\"))&&!window.location.href.match(\"stg_disable_debug\");stgCreateCookie(\"stg_debug\",isStgDebug?1:\"\",isStgDebug?14:-1);\n  var qP=[];dataLayerName!==\"dataLayer\"&&qP.push(\"data_layer_name=\"+dataLayerName),isStgDebug&&qP.push(\"stg_debug\");var qPString=qP.length>0?(\"?\"+qP.join(\"&\")):\"\";\n  tags.async=!0,tags.src=\"https://sportradar.containers.piwik.pro/\"+id+\".js\"+qPString,scripts.parentNode.insertBefore(tags,scripts);\n  !function(a,n,i){a[n]=a[n]||{};for(var c=0;c\u003ci.length;c++)!function(i){a[n][i]=a[n][i]||{},a[n][i].api=a[n][i].api||function(){var a=[].slice.call(arguments,0);\"string\"==typeof a[0]&&window[dataLayerName].push({event:n+\".\"+i+\":\"+a[0],parameters:[].slice.call(arguments,1)})}}(i[c])}(window,\"ppms\",[\"tm\",\"cm\"]);\n  })(window, document, 'dataLayer', 'c90e0d31-40ac-4bfd-8b5f-ef633dfbbe37');\n  \n  \n  \n  // **Signup Button**\n  (function() {\n    const marketMap = {\n      'mlb': 'https://marketplace.sportradar.com/products/64076f13822569c8fbf1fd7c',\n      'global-baseball': 'https://marketplace.sportradar.com/products/652fadc8459a02f489d9ff7c',\n      'nfl': 'https://marketplace.sportradar.com/products/64d179bb0a92ec119620d9d5',\n      'ncaafb': 'https://marketplace.sportradar.com/products/64d18a87d2568e006318b660',\n      'ufl': 'https://marketplace.sportradar.com/products/65c4f5fe1c99c00ecd81872a',\n      'global-american-football': 'https://marketplace.sportradar.com/products/652fbab03bc9b0cb71d1d6a9',\n      'global-basketball': 'https://marketplace.sportradar.com/products/652fb0103bc9b0cb71d1d134',\n      'nba': 'https://marketplace.sportradar.com/products/64d186778ad4bfe2bd064a26',\n      'g-league': 'https://marketplace.sportradar.com/products/64d2ce434d1090ba4a675cba',\n      'ncaamb': 'https://marketplace.sportradar.com/products/6504a21b5f79552ba0b8003c',\n      'ncaawb': 'https://marketplace.sportradar.com/products/6504a1af5f79552ba0b7ff9e',\n      'synergy-basketball': 'https://marketplace.sportradar.com/products/68a87e46e87e4b2ecbfc7212',\n      'unrivaled': 'https://marketplace.sportradar.com/products/69148fd83a35998993f91409',\n      'wnba': 'https://marketplace.sportradar.com/products/64d2c7dd6b8b339e3ce4f7b8',\n      'aussie-rules': 'https://marketplace.sportradar.com/products/652fa7f511a759a67b0640d9',\n      'bandminton': 'https://marketplace.sportradar.com/products/652fa9d03bc9b0cb71d1cf7f',\n      'bandy': 'https://marketplace.sportradar.com/products/652faced459a02f489d9fbff',\n      'beach-soccer': 'https://marketplace.sportradar.com/products/652fbba4cf0671cf96f980dd',\n      'cricket': 'https://marketplace.sportradar.com/products/652fb2675ab138506bb6f672',\n      'curling': 'https://marketplace.sportradar.com/products/652fb305459a02f489da04d9',\n      'cycling': 'https://marketplace.sportradar.com/products/652fb3e6459a02f489da0878',\n      'darts': 'https://marketplace.sportradar.com/products/652fb497459a02f489da0c17',\n      'field-hockey': 'https://marketplace.sportradar.com/products/652fb564459a02f489da0fbe',\n      'floorball': 'https://marketplace.sportradar.com/products/652fba153bc9b0cb71d1d2f5',\n      'futsal': 'https://marketplace.sportradar.com/products/652fc0293bc9b0cb71d1d8a0',\n      'golf': 'https://marketplace.sportradar.com/products/6501ee32cd795eb374057bc5',\n      'handball': 'https://marketplace.sportradar.com/products/652fc0fe3bc9b0cb71d1dc67',\n      'global-ice-hockey': 'https://marketplace.sportradar.com/products/652fc75f91cb7d6acdef2142',\n      'ncaamh': 'https://marketplace.sportradar.com/products/64ef566c9b750f4d54d28555',\n      'nhl': 'https://marketplace.sportradar.com/products/64ef56469b750f4d54d28503',\n      'mma': 'https://marketplace.sportradar.com/products/652fc88991cb7d6acdef2532',\n      'f1': 'https://marketplace.sportradar.com/products/652fca7c91cb7d6acdef2ed6',\n      'formula-e': 'https://marketplace.sportradar.com/products/652fcaeb91cb7d6acdef32b9',\n      'indy-lights': 'https://marketplace.sportradar.com/products/652fcbbc91cb7d6acdef36a0',\n      'indycar': 'https://marketplace.sportradar.com/products/652fcc44604a88e96bd77d0e',\n      'motogp': 'https://marketplace.sportradar.com/products/652fccb3604a88e96bd780fd',\n      'nascar': 'https://marketplace.sportradar.com/products/64efb181a6abd32e000d8450',\n      'rally': 'https://marketplace.sportradar.com/products/652fcd54604a88e96bd784f0',\n      'olympic-medals': 'https://marketplace.sportradar.com/products/66507d78729b8b37add601bd',\n      'pesapallo': 'https://marketplace.sportradar.com/products/652fc9b791cb7d6acdef290d',\n      'rugby': 'https://marketplace.sportradar.com/products/652fcdeb8805049528df13b5',\n      'snooker': 'https://marketplace.sportradar.com/products/6530f1bd9092f74387e646f8',\n      'soccer': 'https://marketplace.sportradar.com/products/64ff63efabf21f142352ee6b',\n      'squash': 'https://marketplace.sportradar.com/products/653153e64c579e32d10a0f52',\n      'table-tennis': 'https://marketplace.sportradar.com/products/653154816a6635c3544c0750',\n      'tennis': 'https://marketplace.sportradar.com/products/6501e20f236aba44b550bdae',\n      'beach-volleyball': 'https://marketplace.sportradar.com/products/653155ba6a6635c3544c0be2',\n      'indoor-volleyball': 'https://marketplace.sportradar.com/products/6531568e4c579e32d10a16c5',\n      'waterpolo': 'https://marketplace.sportradar.com/products/653158004c579e32d10a1b1b',\n      'winter-sports': 'https://marketplace.sportradar.com/products/65315989feb01a58ef689029',\n      'images': 'https://marketplace.sportradar.com/products/categories/images-editorials?domain=media-tech',\n      'editorial': 'https://marketplace.sportradar.com/products/categories/images-editorials?domain=media-tech',\n      'oc-futures': 'https://marketplace.sportradar.com/products/6553a74b4f5b4577563927bd',\n      'oc-live-odds': 'https://marketplace.sportradar.com/products/6765996ea1f380e469a27947',\n      'oc-player-props': 'https://marketplace.sportradar.com/products/6553a6f6d0d7bbe334422809',\n      'oc-prematch': 'https://marketplace.sportradar.com/products/6553a667d0d7bbe334421e30',\n      'oc-regular': 'https://marketplace.sportradar.com/products/6553a5954f5b4577563917ce',\n      'probabilities': 'https://marketplace.sportradar.com/products/6531638f69406a56c7137c50',\n      'gen-ai-overview': 'https://marketplace.sportradar.com/products/6a1f348945048ac218efb97d',\n      'default': 'https://marketplace.sportradar.com/signup'\n    };\n  \n    function updateCTA() {\n      const pageTitle = document.querySelector('h1');\n      if (!pageTitle) return;\n  \n      const currentPath = window.location.pathname.toLowerCase();\n      let btn = document.getElementById('sr-signup-cta');\n  \n      // 1. HARD EXCLUSION: Never show on Widgets project\n      if (currentPath.includes('/widgets/')) {\n        if (btn) btn.remove();\n        return;\n      }\n\n      // 1b. HARD EXCLUSION: Pages that should never show the CTA\n    const excludedPaths = [\n      '/getting-started/docs/simulations',\n      '/getting-started/docs/api-security-enhancements',\n    ];\n    if (excludedPaths.some(path => currentPath.includes(path))) {\n      if (btn) btn.remove();\n      return;\n    }\n  \n      // 2. CHECK FOR OVERVIEW: Button only appears if path contains 'overview' or 'getting-started'\n      const isOverviewPage = currentPath.includes('overview');\n      const isGettingStarted = currentPath.includes('getting-started');\n  \n      if (!isOverviewPage && !isGettingStarted) {\n        if (btn) btn.remove();\n        return;\n      }\n  \n      // 3. Determine the specific sport link\n      let targetLink = null;\n      const sortedKeys = Object.keys(marketMap).sort((a, b) => b.length - a.length);\n  \n      for (const key of sortedKeys) {\n        if (currentPath.includes(key) && key !== 'default') {\n          targetLink = marketMap[key];\n          break;\n        }\n      }\n  \n      // 4. Fallback for Getting Started if no sport match found\n      if (!targetLink && isGettingStarted) {\n        targetLink = marketMap['default'];\n      }\n  \n      // 5. Render/Update/Remove\n      if (targetLink) {\n        if (!btn) {\n          btn = document.createElement('a');\n          btn.id = 'sr-signup-cta';\n          btn.innerText = 'Add Trial in Marketplace';\n          btn.className = 'custom-cta-button';\n          btn.target = '_blank';\n          btn.rel = 'noopener noreferrer';\n          \n          const headerContainer = pageTitle.parentElement;\n          if (headerContainer) {\n            headerContainer.style.display = 'flex';\n            headerContainer.style.width = '100%';\n            headerContainer.style.justifyContent = 'space-between';\n            headerContainer.style.alignItems = 'center';\n            pageTitle.after(btn);\n          }\n        }\n        btn.href = targetLink;\n      } else {\n        if (btn) btn.remove();\n      }\n    }\n  \n    const observer = new MutationObserver(updateCTA);\n    observer.observe(document.body, { childList: true, subtree: true });\n    updateCTA();\n  })();\n  \n  // ===========================\n  // Ask AI gated auto-open\n  // ===========================\n  \n  (() => {\n    const PARAM_NAME = 'askai';\n    const PARAM_VALUE = '1';\n    const HTML_CLASS = 'askai-enabled';\n  \n    const params = new URLSearchParams(window.location.search);\n    const shouldOpenAskAi = params.get(PARAM_NAME) === PARAM_VALUE;\n  \n    // No ?askai=1 = do nothing. CSS should keep Ask AI hidden.\n    if (!shouldOpenAskAi) return;\n  \n    // Temporarily reveal Ask AI so we can click it.\n    document.documentElement.classList.add(HTML_CLASS);\n  \n    const findAskAiButton = () => {\n      const directMatches = [\n        document.querySelector('.rm-AskAi button'),\n        document.querySelector('.rm-AskAi-button'),\n        document.querySelector('[class*=\"Header-ask-ai-button\"]'),\n      ].filter(Boolean);\n  \n      const byText = [...document.querySelectorAll('button')].find(btn =>\n        btn.textContent &&\n        btn.textContent.trim().toLowerCase().includes('ask ai')\n      );\n  \n      return [...directMatches, byText].find(Boolean) || null;\n    };\n  \n    const clickButton = btn => {\n      btn.scrollIntoView({ block: 'center', inline: 'center' });\n  \n      ['pointerdown', 'mousedown', 'mouseup', 'click'].forEach(type => {\n        btn.dispatchEvent(new MouseEvent(type, {\n          bubbles: true,\n          cancelable: true,\n          view: window\n        }));\n      });\n    };\n  \n    const cleanupUrlAndHideButton = () => {\n      const url = new URL(window.location.href);\n      url.searchParams.delete(PARAM_NAME);\n      window.history.replaceState({}, '', url.toString());\n  \n      // Give the Ask AI panel a moment to open, then hide the button again.\n      setTimeout(() => {\n        document.documentElement.classList.remove(HTML_CLASS);\n      }, 250);\n    };\n  \n    const openAskAi = () => {\n      const btn = findAskAiButton();\n      if (!btn) return false;\n  \n      clickButton(btn);\n      cleanupUrlAndHideButton();\n  \n      console.log('Ask AI auto-opened');\n      return true;\n    };\n  \n    const start = () => {\n      if (openAskAi()) return;\n  \n      const askAiObserver = new MutationObserver(() => {\n        if (openAskAi()) {\n          askAiObserver.disconnect();\n          clearTimeout(timeout);\n        }\n      });\n  \n      askAiObserver.observe(document.documentElement, {\n        childList: true,\n        subtree: true\n      });\n  \n      const timeout = setTimeout(() => {\n        askAiObserver.disconnect();\n        document.documentElement.classList.remove(HTML_CLASS);\n        console.warn('Ask AI button was not found.');\n      }, 10000);\n    };\n  \n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', start);\n    } else {\n      start();\n    }\n  })();\n  \n  \n  // ******************************************************************************************\n  // ****Dropdown Parent Clip****\n  // Clips the project picker dropdown container to prevent empty space below sport grid\n  // ******************************************************************************************\n  \n  /* ==========================================================\n     SPORTRADAR README DROPDOWN — CUSTOM JS\n     Paste into: Appearance > Custom JS\n     ========================================================== */\n  \n  // Clip parent on dropdown open — scoped to project picker ONLY\n  const observer = new MutationObserver(() => {\n      // Only target the Dropdown-content that belongs to the project picker,\n      // not any other dropdown on the page (e.g. Request Examples, field tooltips).\n      const projectPickerMenu = document.querySelector('.rm-ProjectPicker-menu');\n      const parent = projectPickerMenu && projectPickerMenu.closest('.Dropdown-content_opened');\n      if (parent) {\n        if (window.innerWidth >= 1100) {\n          parent.style.setProperty('overflow', 'hidden', 'important');\n          parent.style.setProperty('max-height', '252px', 'important');\n          parent.style.setProperty('padding', '0', 'important');\n          parent.style.setProperty('margin-top', '0', 'important');\n          parent.style.setProperty('min-width', '1100px', 'important');\n        } else {\n          parent.style.removeProperty('overflow');\n          parent.style.removeProperty('max-height');\n          parent.style.removeProperty('padding');\n          parent.style.removeProperty('margin-top');\n          parent.style.removeProperty('min-width');\n        }\n      }\n  });\n  observer.observe(document.body, { subtree: true, attributes: true, attributeFilter: ['class'] });\n  \n  // ============================================================\n  //  Statistics Summary - Custom JS\n  //  Paste into ReadMe: Project Settings > Appearance > Custom JS\n  //  ------------------------------------------------------------\n  //   1. FILTER BOX - the script builds its own search box and\n  //      inserts it directly above the first stat card. It does not\n  //      depend on any HTML surviving in the Markdown.\n  //   2. PRINT EXPAND - opens every \"Available in\" dropdown before\n  //      printing, then restores them.\n  //\n  //  Defensive install: retries on a timer AND via MutationObserver,\n  //  inserts relative to the first card (no sibling-walking), and\n  //  wraps insertion in try/catch so a DOM quirk can't silently kill\n  //  it. Logs to console with a [StatsFilter] prefix so issues are\n  //  visible if anything goes wrong.\n  // ============================================================\n  \n  (function () {\n    \"use strict\";\n  \n    var BOX_ID = \"statFilter\";\n    var COUNT_ID = \"statFilterCount\";\n    var LOG = \"[StatsFilter] \";\n\n    // Placeholder examples for the filter box.\n    //\n    // Resolution order:\n    //   1. PER-PAGE MARKER (most specific, always wins): if the page\n    //      includes an element like\n    //        \u003cspan class=\"stat-filter-examples\" data-examples=\"a, b, c\" hidden>\u003c/span>\n    //      its data-examples value is used verbatim. This lets any single\n    //      page declare its own examples regardless of URL, which matters\n    //      because some products share a sport-word path (e.g. both NFL and\n    //      Global American Football live under /football/).\n    //   2. URL PATH MAP (fallback): sport-word match for the deeper,\n    //      play-level products.\n    //   3. GENERIC FALLBACK: terms that exist across virtually every feed.\n    function filterExamples() {\n      // 1. Per-page marker.\n      try {\n        var marker = document.querySelector(\".stat-filter-examples\");\n        if (marker) {\n          var ex = (marker.getAttribute(\"data-examples\") || \"\").trim();\n          if (ex) return ex;\n        }\n      } catch (e) { /* fall through to path logic */ }\n\n      // 2. URL path map.\n      var path = (window.location.pathname || \"\").toLowerCase();\n      var map = [\n        [\"handball\",   \"goals, shots, saves\"],\n        [\"rugby\",      \"tries, tackles, scrums\"],\n        [\"baseball\",   \"pitch, stolen, on-base\"],\n        [\"basketball\", \"rebounds, assists, fouls\"],\n        [\"football\",   \"rushing, tackles, sacks\"],\n        [\"hockey\",     \"goals, assists, penalties\"],\n        [\"soccer\",     \"goals, assists, offside\"],\n        [\"tennis\",     \"aces, break points, serves\"],\n        [\"golf\",       \"strokes, birdies, fairways\"],\n        [\"racing\",     \"laps, position, points\"],\n        [\"odds\",       \"market, odds, book\"]\n      ];\n      for (var i = 0; i \u003c map.length; i++) {\n        if (path.indexOf(map[i][0]) !== -1) return map[i][1];\n      }\n\n      // 3. Generic fallback.\n      return \"competitor, score, season\";\n    }\n\n    function buildBox() {\n      // Only trust the live DOM. Do NOT rely on a cached \"installed\"\n      // flag: ReadMe re-renders the page client-side and can remove the\n      // box while a flag would still say it exists, blocking reinstall.\n      if (document.getElementById(BOX_ID)) return true;\n  \n      var firstCard = document.querySelector(\".stat-card\");\n      if (!firstCard) return false;            // cards not rendered yet\n  \n      try {\n        var wrap = document.createElement(\"div\");\n        wrap.className = \"stat-filter\";\n  \n        var input = document.createElement(\"input\");\n        input.type = \"text\";\n        input.id = BOX_ID;\n        input.className = \"stat-filter-input\";\n        input.setAttribute(\"autocomplete\", \"off\");\n        input.placeholder = \"Filter data points (e.g. \" + filterExamples() + \")...\";\n  \n        var count = document.createElement(\"span\");\n        count.className = \"stat-filter-count\";\n        count.id = COUNT_ID;\n  \n        wrap.appendChild(input);\n        wrap.appendChild(count);\n  \n        // Insert the box immediately before the first card. Use the\n        // card's OWN parent so we never rely on DOM structure we can't\n        // see. If a heading sits right above, place the box above that.\n        var ref = firstCard;\n        var prev = firstCard.previousElementSibling;\n        if (prev && prev.tagName === \"H2\") ref = prev;\n  \n        ref.parentNode.insertBefore(wrap, ref);\n        console.log(LOG + \"filter box installed\");\n        return true;\n      } catch (err) {\n        console.log(LOG + \"install failed:\", err);\n        return false;\n      }\n    }\n  \n    function runFilter(query) {\n      var q = (query || \"\").trim().toLowerCase();\n      var total = 0;\n  \n      document.querySelectorAll(\".stat-card\").forEach(function (card) {\n        var list = card.querySelector(\".stat-points\");\n        if (!list) return;\n        var cardMatches = 0;\n  \n        list.querySelectorAll(\"li\").forEach(function (li) {\n          var term = (li.getAttribute(\"data-term\") || li.textContent || \"\").toLowerCase();\n          var hit = q !== \"\" && term.indexOf(q) !== -1;\n          li.classList.toggle(\"is-match\", hit);\n          if (hit) cardMatches++;\n        });\n  \n        list.classList.toggle(\"filtering\", q !== \"\");\n  \n        var heading = card.previousElementSibling;\n        while (heading && heading.tagName !== \"H2\") heading = heading.previousElementSibling;\n  \n        var empty = q !== \"\" && cardMatches === 0;\n        card.classList.toggle(\"is-empty\", empty);\n        if (heading) heading.classList.toggle(\"is-empty-heading\", empty);\n\n        // Also hide the category's \"available in\" dropdown when the card\n        // is empty. The \u003cdetails class=\"stat-availability\"> is a SIBLING of\n        // the card (not a child), so walk forward to the next one. Stop if\n        // we hit the next heading/card so we never grab another category's\n        // dropdown.\n        var drop = card.nextElementSibling;\n        while (drop &&\n               !(drop.classList && drop.classList.contains(\"stat-availability\"))) {\n          if (drop.tagName === \"H2\" ||\n              (drop.classList && drop.classList.contains(\"stat-card\"))) {\n            drop = null;\n            break;\n          }\n          drop = drop.nextElementSibling;\n        }\n        if (drop) drop.classList.toggle(\"is-empty\", empty);\n\n        total += cardMatches;\n      });\n  \n      var c = document.getElementById(COUNT_ID);\n      if (c) c.textContent = q === \"\" ? \"\" : total + (total === 1 ? \" match\" : \" matches\");\n    }\n  \n    // Delegated listeners survive ReadMe's client-side re-renders\n    document.addEventListener(\"input\", function (e) {\n      if (e.target && e.target.id === BOX_ID) runFilter(e.target.value);\n    });\n    document.addEventListener(\"keydown\", function (e) {\n      if (e.key === \"Escape\" && e.target && e.target.id === BOX_ID) {\n        e.target.value = \"\";\n        runFilter(\"\");\n      }\n    });\n  \n    // --- Install strategy: try now, on a short poll, and on DOM changes ---\n    function attempt() { return buildBox(); }\n  \n    // 1) Immediate + DOM ready\n    attempt();\n    if (document.readyState === \"loading\") {\n      document.addEventListener(\"DOMContentLoaded\", attempt);\n    }\n  \n    // 2) Short poll (handles ReadMe rendering cards a beat after load)\n    var tries = 0;\n    var poll = setInterval(function () {\n      tries++;\n      if (attempt() || tries > 40) clearInterval(poll);  // ~10s max\n    }, 250);\n  \n    // 3) MutationObserver for client-side page navigation. If the box\n    //    gets removed by a page swap, rebuild it.\n    var obs = new MutationObserver(function () {\n      if (!document.getElementById(BOX_ID) && document.querySelector(\".stat-card\")) {\n        attempt();\n      }\n    });\n    if (document.body) obs.observe(document.body, { childList: true, subtree: true });\n  \n    // ---------- PRINT EXPAND ----------\n    var opened = [];\n    window.addEventListener(\"beforeprint\", function () {\n      opened = [];\n      document.querySelectorAll(\"details.stat-availability\").forEach(function (d) {\n        if (!d.open) { d.open = true; opened.push(d); }\n      });\n    });\n    window.addEventListener(\"afterprint\", function () {\n      opened.forEach(function (d) { d.open = false; });\n      opened = [];\n    });\n  \n    console.log(LOG + \"loaded\");\n  })();\n","html":{"header":"\u003c!-- TRUENDO Privacy Center -->\n\u003cscript id=\"truendoAutoBlock\" type=\"text/javascript\" src=\"https://cdn-geo.priv.center/a684e5d8-c7ac-43b2-8ae3-1cbbc0091beb/?id=a684e5d8-c7ac-43b2-8ae3-1cbbc0091beb\">\u003c/script>\n\u003c!-- End TRUENDO Privacy Center -->\n\n\u003clink rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n\u003clink rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n\u003clink href=\"https://fonts.googleapis.com/css2?family=Source+Sans+Pro:ital,wght@0,200;0,300;0,400;0,600;0,700;0,900;1,200;1,300;1,400;1,600;1,700;1,900&display=swap\" rel=\"stylesheet\">\n\n\u003cscript>\n  // Utility sleep function.\n  const sleep = (ms) => new Promise(resolve => setTimeout(resolve, ms));\n\n  // Global flag to ensure auto-toggle happens only once.\n  window.autoToggleDone = window.autoToggleDone || false;\n\n  async function processRefinementList() {\n    console.log(\"Processing refinement list...\");\n\n    // Phase 1: Wait for the \"More\" button each time, and click it only if its text is \"MORE\".\n    let moreButton = null;\n    const maxWaitTime = 10000; // 10 seconds max wait time\n    const startTime = Date.now();\n    while (!moreButton && (Date.now() - startTime) \u003c maxWaitTime) {\n      moreButton = document.querySelector(\"button.RefinementList-Button2fUR5J_rHDXh\");\n      if (!moreButton) {\n        console.log(\"More button not found yet, waiting 500ms...\");\n        await sleep(500);\n      }\n    }\n    if (moreButton) {\n      // Only click if its text is exactly \"MORE\" (case-insensitive).\n      if (moreButton.textContent.trim().toUpperCase() === \"MORE\") {\n        console.log(\"Found More button with text 'MORE'. Clicking it.\");\n        moreButton.click();\n      } else {\n        console.log(\"Button text is not 'MORE' (likely 'LESS'); not clicking to avoid closing the list.\");\n      }\n    } else {\n      console.warn(\"More button was not found within the wait period.\");\n    }\n\n    // Phase 2: Wait 1 second for the list to load.\n    console.log(\"Waiting 1 second for the list to load...\");\n    await sleep(500);\n\n    // Phase 3: Process the list items.\n    const examples = document.querySelector(\"[class*='RefinementList']\");\n    if (!examples) {\n      console.warn(\"RefinementList container not found.\");\n      return;\n    }\n    console.log(\"Found RefinementList container.\");\n\n    const categoryLabels = examples.querySelectorAll(\".Toggle-label\");\n    const checkboxes = examples.querySelectorAll(\".Toggle-input\");\n    const urlPath = window.location.pathname.toLowerCase();\n    let toggledCategoryIndex = -1;\n\n    // Define unwanted categories.\n    const isUnwanted = (categoryTitle) => {\n      return categoryTitle.startsWith(\"sportradar\") || categoryTitle === \"sports api\";\n    };\n\n    // Auto-toggle the checkbox only the first time.\n    if (!window.autoToggleDone) {\n      for (let index = 0; index \u003c categoryLabels.length; index++) {\n        const label = categoryLabels[index];\n        const categoryTitle = label.textContent.trim().toLowerCase();\n\n        // Skip unwanted categories.\n        if (isUnwanted(categoryTitle)) {\n          console.log(`Skipping toggling for unwanted category: ${categoryTitle}`);\n          continue;\n        }\n\n        // Create a slug and check against the URL.\n        const slug = categoryTitle.replace(/ /g, \"-\");\n        if (urlPath.includes(slug) && toggledCategoryIndex === -1) {\n          const checkbox = checkboxes[index];\n          if (checkbox) {\n            console.log(`Toggling checkbox for category: ${categoryTitle}`);\n            // If already checked, uncheck first.\n            if (checkbox.checked) {\n              console.log(`Checkbox for ${categoryTitle} is already checked. Unchecking first.`);\n              checkbox.click();\n              await sleep(500); // Brief pause after unchecking.\n            }\n            checkbox.click();\n            console.log(`Checkbox for ${categoryTitle} is now checked.`);\n            toggledCategoryIndex = index;\n          }\n        }\n      }\n      // Mark that auto-toggle is complete.\n      window.autoToggleDone = true;\n    } else {\n      console.log(\"Auto-toggle already performed; skipping toggling step.\");\n    }\n\n    // Phase 4: Wait 1 second after toggling.\n    console.log(\"Waiting 1 second after toggling for list rearrangement...\");\n    await sleep(800);\n\n    // Phase 5: Hide unwanted categories.\n    categoryLabels.forEach(label => {\n      const categoryTitle = label.textContent.trim().toLowerCase();\n      if (isUnwanted(categoryTitle)) {\n        const listItem = label.closest(\"li\");\n        if (listItem) {\n          console.log(`Hiding list item for unwanted category: ${categoryTitle}`);\n          listItem.style.display = 'none';\n        } else {\n          console.warn(`List item for ${categoryTitle} not found.`);\n        }\n      }\n    });\n  }\n\n  // Utility: Wait for a specific element to be available.\n  function waitForElement(selector, timeout = 10000) {\n    return new Promise((resolve, reject) => {\n      const startTime = Date.now();\n      const interval = setInterval(() => {\n        const el = document.querySelector(selector);\n        if (el) {\n          clearInterval(interval);\n          resolve(el);\n        } else if (Date.now() - startTime > timeout) {\n          clearInterval(interval);\n          reject(new Error(`Element not found: ${selector}`));\n        }\n      }, 100);\n    });\n  }\n\n  // Attach a listener to the specific header search button.\n  async function initSearchButtonListener() {\n    try {\n      // Use a specific selector to target the correct search button.\n      const searchButton = await waitForElement('div.rm-Header-search.Header-searchtb6Foi0-D9Vx > button.rm-SearchToggle');\n      searchButton.addEventListener('click', () => {\n        // Allow a brief delay for the modal to render.\n        setTimeout(() => {\n          processRefinementList();\n        }, 300); // Adjust the delay if needed.\n      });\n      console.log(\"Search button listener attached.\");\n    } catch (error) {\n      console.error(\"Failed to attach search button listener:\", error);\n    }\n  }\n\n  // Initialize when the DOM is fully loaded.\n  document.addEventListener('DOMContentLoaded', () => {\n    initSearchButtonListener();\n  });\n\u003c/script>\n","home_footer":null,"page_footer":"\u003cdiv style=\"background:#E7EAF6;float:left; width:100%; max-width:100%; margin:0 auto;\" class=\"footer container\">\n  \u003cdiv style=\"max-width:960px; margin:0 auto; padding-left:2rem; padding-right:2rem: display: flex; justify-content: space-between; align-items: center;\">\n    \u003cp style=\"color:#1A237E;display:inline-block;\">&copy; Sportradar AG, St. Gallen, Switzerland\u003c/p>\n    \u003cnav class=\"footer-links\">\n      \u003ca style=\"color:#1A237E;\" href=\"https://sportradar.com/privacy-notice\">Privacy Policy\u003c/a>&nbsp;&nbsp;&nbsp;|&nbsp;&nbsp;&nbsp;\n      \u003ca style=\"color:#1A237E;\" href=\"/terms-and-conditions\">Terms and Conditions\u003c/a>&nbsp;&nbsp;&nbsp;|&nbsp;&nbsp;&nbsp;\n      \u003ca style=\"color:#1A237E;\" href=\"https://sportradar.com/contact\">Contact Us\u003c/a>\n    \u003c/nav>\n  \u003c/div>\n\u003c/div>\n"}},"header":{"type":"overlay","gradient_color":null,"subnav":{"alignment":"start"},"link_style":"buttons","overlay":{"fill":"cover","type":"custom","position":"top-left","image":{"uri":null,"url":null,"name":null,"width":null,"height":null,"color":null,"links":{"original_url":null}}}},"navigation":{"collapsible_categories":"disabled","breadcrumbs":"disabled","first_page":"reference","left":[],"logo_link":"homepage","page_icons":"enabled","right":[{"type":"link_url","title":"Coverage Matrix","url":"https://coverage-matrix.sportradar.com/","custom_page":null},{"type":"link_url","title":"Documentation","url":"https://developer.sportradar.com/getting-started","custom_page":null},{"type":"link_url","title":"Change Log","url":"https://developer.sportradar.com/sportradar-updates/changelog","custom_page":null},{"type":"link_url","title":"Log In","url":"https://marketplace.sportradar.com/login","custom_page":null},{"type":"link_url","title":"Contact Us","url":"https://sportradar.com/contact/","custom_page":null}],"search_modal":"classic","sub_nav":[],"subheader_layout":"dropdown","version":"enabled","links":{"home":{"label":"Home","visibility":"disabled"},"graphql":{"label":"GraphQL","visibility":"disabled","schema":null},"guides":{"label":"Guides","alias":"Integration Guides","visibility":"enabled"},"reference":{"label":"API Reference","alias":"Reference Docs","visibility":"enabled"},"recipes":{"label":"Recipes","alias":null,"visibility":"disabled"},"changelog":{"label":"Changelog","alias":"Release Log","visibility":"disabled"},"discussions":{"label":"Discussions","alias":null,"visibility":"disabled"}}}},"i18n":{"defaultLanguage":"en","languages":[{"code":"en","type":"manual"}],"state":"enabled","do_not_translate_words":[],"ai_unlocked_languages":null}}},"version":{"_id":"63517a18c854d800a4cfe75f","version":"8","version_clean":"8.0.0","codename":"Current versions","is_stable":true,"is_beta":false,"is_hidden":false,"is_deprecated":false,"categories":["63517a18c854d800a4cfe760","63517a18c854d800a4cfe760","63517a18c854d800a4cfe765","6375319cf0a6b40018f50938","637531a27afde90083c00b4b","637531aadd1fdf002e115ada","637531b0e9d46800691e5b9c","637531ba16354900178d2de1","63b4a57caac1d0002488a240","63b4a581b5ce3b023df652d3","63b4a587f4522100a58e7e63","63b4a59031fc5a0215d6d5e0","63b4a595b65f3900635f0867","650de0e327f7491c5b23762e","66ce1f9d2174ab0032bd2bbc","66ce1faed3aefb0019bc96c8","66d9b9a9a3910300439e916a","66ed6a365578500025b2d325","6718d0ec0b0d9400110fd151","6718d312fd71f0006e0b393b","6718d4985d0fc80066eae464"],"project":"63517a19c854d800a4cfec52","releaseDate":"2022-08-03T16:41:07.456Z","createdAt":"2022-08-03T16:41:07.456Z","__v":23,"updatedAt":"2026-02-13T13:54:44.443Z","pdfStatus":"complete","apiRegistries":[{"filename":"draft.json","uuid":"feow2jmbjixipu"},{"filename":"nba-g-league.json","uuid":"54s0x1smbgmtkfn"},{"filename":"nba.json","uuid":"636h2n1cmalh0acg"},{"filename":"ncaa-mens-basketball.json","uuid":"feow13mbjnaatq"},{"filename":"wnba.json","uuid":"73rphmbgmqr6u"},{"filename":"global-basketball.json","uuid":"73rp2vmbgu6cj1"},{"filename":"global-basketball-probabilities.json","uuid":"1ozl01dmbkvl0rm"},{"filename":"ncaa-womens-basketball.json","uuid":"6yyoop1lmadk0zgv"},{"filename":"unrivaled.json","uuid":"2vnp00093lmhxvex3b"},{"filename":"Synergy-Basketball.json","uuid":"47k18mligk14h"}],"source":"readme"}},"i18n":{"language":"en","translations":{"en":{"common":{"ai":{"aiOpenFailed":"Failed to open SuperHub AI panel.","askAi":"Ask AI","askAiAriaLabel":"Open Ask AI Assistant","chatgpt":"Open in ChatGPT","claude":"Open in Claude","copied":"Copied","mdCopy":"Copy Page","mdOpenFailed":"Failed to open as markdown","mdView":"View as Markdown","mcp":{"appNotFound":"{{app}} does not appear to be installed.","command":"Copy MCP Command","config":"Copy MCP Config","copied":"Copied to clipboard!","cursor":"Connect to Cursor","downloadApp":"Download {{app}}","header":"MCP","vscode":"Connect to VS Code"},"noMdToCopy":"No markdown content available to copy.","openFailed":"Failed to open {{option}}.","settings":{"askAiRequired":"Ask AI must be enabled for your project","description":"Adds a dropdown menu for sharing docs with AI assistants.","disabledInternal":"Disabled for internal docs — set to public to enable","dropdownOptions":"Dropdown Options","preview":"Preview","saveFailed":"Failed to save AI dropdown configuration. Please try again.","title":"AI Dropdown"}},"aiInlineEditor":{"disabled":"The AI inline editor has been disabled for this project."},"apiConfig":{"allRequests":"All Requests","allRequestsFilter":"All Requests","apiKeysNotFound":"No API keys found.","apiKeysNotSynced":"API keys are not synced with this developer hub.","apiRequests":"API Requests","authentication":"Authentication","credentials":"Credentials","dayFilter":"Last 24 Hours","emptyStatePrompt":"Make a request to see them here or \u003ca>Try It\u003c/a>!","error":"Error","errorRequestsFilter":"400 & 500","gettingStarted":"Getting Started","logInPrompt":"Log in to see your API keys","monthFilter":"Last 30 Days","moreErrors":"More Errors","moreRequests":"More Requests","myRecentErrors":"My Recent Errors","myRecentRequests":"My Recent Requests","myRequests":"My Requests","myTopEndpoints":"My Top Endpoints","personalizedDocsSetup":"Set up \u003cButton>Personalized Docs\u003c/Button> to show users their API keys.","pickALanguage":"Pick a language","popularEndpoints":"Popular Endpoints","success":"Success","weekFilter":"Past week","yourApiKeys":"Your API Keys"},"attribution":"by {{attribution}}","auth":{"any":"any","apiKey":"API Key","apiKeyPrompt":"Get API Key","apiKeyShow":"Show API Key","apiKeyHide":"Hide API Key","apiKeyToggle":"Toggle API Key","apiInfo":"API Info","authenticate":"Authenticate","authorize":"Authorize","authorizationUrl":"Authorization URL","authorizedScopes":"Authorized scopes for this token","authorizedScopesEmpty":"Token has no authorized scopes","bearer":"Bearer","clearSelection":"Clear Selection","clientId":"Client ID","deselectAll":"Deselect All","credentialMessage":"{{projectName}} accepts {{count}} credential methods. You can use {{option}} of them.","credentialsFor":"Credentials for {{name}}","credentialsForMd":"Credentials for `{{name}}`","either":"eitherLog in to use your API keys","grantType":"Grant Type","info":{"base64":"Your username and password will be combined with a : to form a base64-encoded string: `ENCODED_TOKEN`","basic":"Your username and password are being sent in the [header](https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/Authorization) of the request.","bearer":"\n  Bearer authentication gives access to the “bearer of the token” and must be sent in the Authorization header. For example:\n  ```bash\n  curl --request POST \\\n       --url https://httpbin.org/anything/bearer\n       --header 'Authorization: Bearer BEARER_TOKEN'\n  ```\n  ","cookie":"Your API Key is being sent as a [cookie](https://developer.mozilla.org/en-US/docs/Web/HTTP/Cookies).","header":"Your API Key is sent in the request [header](https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers).","jwt":"The bearer token's format is JSON Web Token (JWT). Read more at [JWT.io](https://jwt.io/).","query":"Your API Key is being sent as a query parameter in the [URL](https://developer.mozilla.org/en-US/docs/Web/API/URL)."},"infoTable":{"contact":"Contact","description":"Description","identifier":"Identifier","license":"License","name":"Name","termsOfService":"Terms of Service","title":"Title","summary":"Summary","url":"URL","version":"Version"},"information":"Information","label":"Label","lastUsed":"Last Used","logInPrompt":"Log in to use your API keys","logIn":"Log In","logOut":"Log Out","or":"or","password":"password","passwordHideLabel":"Hide","passwordShowLabel":"Show","reAuthorize":"Re-Authorize","required":"required","requiredScopes":"Required Scopes","requiredScopesMissingMsg_one":"Missing {{count}} required scope","requiredScopesMissingMsg_other":"Missing {{count}} required scopes","scopes":"Scopes","scopeGroupAllRequired":"All {{count}} scopes required","scopesOrRequired":"At least 1 scope group required","scopesMissingCount":"({{count}} missing from this token)","scopesMissingMsg_one":"This operation requires {{count}} additional scope","scopesMissingMsg_other":"This operation requires {{count}} additional scopes","scopesRequiredMsg":"Scopes required for this operation","scopesRequiredNoneMsg":"No scopes required for this operation","selectAll":"Select All","selectCredentials":"Select Credentials","token":"token","tokenDetails":"Token Details","tokenRotationMessage":"We recommend you rotate this token.","tokenUrl":"Token URL","useOwnToken":"Use Your Own Token","username":"username"},"close":"Close","colorScheme":{"dark":"Dark","light":"Light","system":"System","title":"Color Scheme"},"changelog":{"added":"Added","deprecated":"Deprecated","fixed":"Fixed","improved":"Improved","removed":"Removed","title":"Changelog"},"copyToClipboard":{"copiedFull":"Copied to clipboard!","copiedShort":"Copied!","copyFull":"Copy to clipboard","copyShort":"Copy","failed":"Failed to copy to clipboard.","unable":"Unable to copy"},"discussions":{"addCommentLabel":"Add Comment","adminLabel":"Admin","answered":"Answered","askQuestion":"Ask a Question","backToAll":"Back to all","blankBodyError":"Your post body cannot be blank.","blankCommentError":"Your comment cannot be blank.","blankPostError":"Your post cannot be blank.","blankTitleError":"Your post title cannot be blank.","cancelButtonLabel":"Cancel","commentAndMarkAnswered":"Comment and mark answered","commentAndReopen":"Comment and reopen","deleteButtonLabel":"Delete","deleteCommentConfirmation":"Are you sure you want to delete this comment?","deleteCommentPermanentConfirmation":"Are you sure you want to permanently delete this comment?","deleteComentSuccess":"This comment has been deleted","deletePermanentlyButtonLabel":"Permanently Delete","deletePostConfirmation":"Are you sure you want to delete this post?","editButtonLabel":"Edit","editedLabel":"edited","emailInputAriaLabel":"name@email.com","emailInputPlaceholder":"Your Email","errorMessagePrefix":"Error:","faqAddLabel":"Add to FAQ","faqRemoveLabel":"Remove from FAQ","faqsLabel":"FAQs","logInToComment":"\u003cb>Log in\u003c/b> to add a comment.","markAsAnswered":"Mark as answered","markAsUnanswered":"Mark as unanswered","markCommentSpamLabel":"Mark this comment as spam","markPostSpamLabel":"Mark this post as spam","nameAndEmailError":"Please fill out your name and email.","nameInputAriaLabel":"Your name","nameInputPlaceholder":"Full name","permanentlyDeleteLabel":"Permanently delete","questionInputAriaLabel":"New question","recaptchaInvalidError":"Invalid ReCaptcha tokens.","recaptchaRequiredError":"Please complete the reCaptcha verification.","recentLabel":"Recent","saveButtonLabel":"Save","submitButtonLabel":"Post Question","tagButtonLabel":"Tag","tagInputPlaceholder":"Enter tag","titleInputAriaLabel":"Question title","titleInputPlaceholder":"Your question title","unansweredLabel":"Unanswered","voteCountLabel":"{{count}} vote","voteCountLabel_plural":"{{count}} votes"},"docsAudit":{"disabled":"The AI Docs Audit has been disabled for this project.","scheduleDisabled":"Disabled by admin"},"emptyState":{"changelog":{"title":"No Changelogs"},"discussion":{"actionLabel":"New Question","description":"Nobody's asked a question yet. Be the first!","title":"No Discussions"},"guide":{"title":"No Guides"},"recipe":{"title":"No Recipes"},"reference":{"title":"No API Endpoints"}},"llmsTxt":{"documentation":"Documentation","documentationFor":"Documentation for {{name}}","groupIndexHint":"Each project below either links to its own llms.txt, which contains a full index of that project's documentation, or inlines the index its authors wrote by hand. Where links are listed, the section and category ones narrow to that part of the docs.","heading":"{{name}} Documentation","hubBanner":"For AI agents: visit {{url}} for an index of all pages formatted in Markdown and endpoints in OpenAPI.","indexLink":"{{title}} index","mdSuffixHint":"Append .md to any documentation page URL to get its markdown version.","openapiDefinition":"OpenAPI definition","openapiIntroNote":"This is the part of the API’s OpenAPI definition that covers servers and authentication. Each endpoint page has its own operation.","pageNotFound":"Page not found. The full index is at {{url}}. Use the agentTools in the front matter above to search the docs or browse the index.","projectDocumentation":"{{name}} documentation","queryCapabilityHint":"To search every page by keyword, fetch {{url}} with your own terms. Results come back most relevant first.","queryFailedHint":"Search is temporarily unavailable, so this is the complete index rather than the pages matching `{{query}}`.","queryNoResultsHint":"No pages matched `{{query}}`. Fetch {{url}} for the complete index.","queryResultsHint":"Pages matching `{{query}}`, most relevant first. Fetch {{url}} for the complete index.","searchResults":"Search Results","sectionIndexNote":"full section index","siblingPages":"Sibling pages","siteIndexHint":"The index for every project on this site is at {{url}}.","splitCategoriesHint":"Category links narrow to a single category.","splitIndexHint":"Each section below links to its own llms.txt, which indexes every page in that section.","subPages":"Sub pages","subsetIndexHint":"