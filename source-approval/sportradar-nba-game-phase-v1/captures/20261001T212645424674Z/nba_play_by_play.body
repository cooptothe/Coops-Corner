de lang- theme-undefined\" data-lang=\"\">name\u003c/code>\u003c/td>\u003ctd>\u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">event\u003c/code> - \u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">on_court\u003c/code> - \u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">home\u003c/code> / \u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">away\u003c/code>\u003c/td>\u003ctd>String\u003c/td>\u003ctd>Team name\u003cbr/>\u003cbr/>ex. \u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">Kings\u003c/code>\u003c/td>\u003c/tr>\u003ctr>\u003ctd>\u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">reference\u003c/code>\u003c/td>\u003ctd>\u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">event\u003c/code> - \u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">on_court\u003c/code> - \u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">home\u003c/code> / \u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">away\u003c/code>\u003c/td>\u003ctd>String\u003c/td>\u003ctd>League reference ID of a team\u003cbr/>\u003cbr/>ex. \u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">1610612750\u003c/code>\u003c/td>\u003c/tr>\u003ctr>\u003ctd>\u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">sr_id\u003c/code>\u003c/td>\u003ctd>\u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">event\u003c/code> - \u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">on_court\u003c/code> - \u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">home\u003c/code> / \u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">away\u003c/code>\u003c/td>\u003ctd>GUID\u003c/td>\u003ctd>Unique Sportradar ID of a team\u003cbr/>\u003cbr/>ex. \u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">sr:team:3415\u003c/code>\u003c/td>\u003c/tr>\u003c/tbody>\u003c/table>\u003c/div>\u003c/div>\u003c/div>\u003c/details>\u003c/div>","css":"/*! tailwindcss v4.1.17 | MIT License | https://tailwindcss.com */\n@layer theme, base, components, utilities;\n@layer utilities;\n"},"opts":{"hardBreaks":true,"alwaysThrow":false,"compatibilityMode":false,"copyButtons":true,"correctnewlines":false,"markdownOptions":{"fences":true,"commonmark":true,"gfm":true,"ruleSpaces":false,"listItemIndent":"1","spacedTable":true,"paddedTable":true},"normalize":true,"lazyImages":true,"reusableContent":{"tags":{},"disabled":false,"serialize":true,"wrap":true},"safeMode":false,"settings":{"position":true},"theme":"light","customBlocks":{},"componentTypes":{},"resourceID":"/branches/8/reference/nba-play-by-play","resourceType":"page","components":{},"baseUrl":"/basketball","terms":[{"_id":"65e71b1221b9b7001fe37191","term":"Quad 1","definition":"Home games vs. RPI teams ranked in the top 30; neutral games vs. 1-50; away games vs. 1-75."},{"_id":"65e71b2a21b9b7001fe37194","term":"Quad 2","definition":"Home vs. 31-75 teams; neutral vs. 51-100; away vs. 76-135."},{"_id":"65e71b39d336bd0f86df4881","term":"Quad 3","definition":"Home vs. 76-160 teams; neutral vs. 101-200; away vs. 136-240."},{"_id":"65e71b46e0733e007e48f910","term":"Quad 4","definition":"Home vs. 161-plus teams; neutral vs. 201-plus; away vs. 241-plus."},{"_id":"66563e6a66d6fb000fd5fccc","term":"RESTful","definition":"An architectural style for an application programming interface (API) that uses HTTP requests to access and use data."},{"_id":"667d7697fed2aa002443acee","term":"General Sport API","definition":"The General Sport APIs provide a breadth of coverage across numerous leagues worldwide. All General Sport APIs follow a consistent structure and format between sports, making it easy to consume the data across different leagues or competitions."},{"_id":"66df15b4a637880061088401","term":"GraphQL","definition":"Click [here](https://graphql.org/learn/) to learn more about GraphQL!"},{"_id":"67a0f8eeeed30a00304bafeb","term":"Rolling Quota","definition":"Our rolling 30-day schedule means calls from 31 days prior are removed from your quota each day.\n\nFor example, a rolling 30-day period at the end of a month could include requests from the 1st to the 30th. The following day would take requests made from the 2nd to the 31st."},{"term":"Quad 1","definition":"Home games vs. RPI teams ranked in the top 30; neutral games vs. 1-50; away games vs. 1-75.","_id":"692497cca2be85c6ca237f5b"},{"term":"Quad 2","definition":"Home vs. 31-75 teams; neutral vs. 51-100; away vs. 76-135.","_id":"692497cca2be85c6ca237f5c"},{"term":"Quad 3","definition":"Home vs. 76-160 teams; neutral vs. 101-200; away vs. 136-240.","_id":"692497cca2be85c6ca237f5d"},{"term":"Quad 4","definition":"Home vs. 161-plus teams; neutral vs. 201-plus; away vs. 241-plus.","_id":"692497cca2be85c6ca237f5e"},{"term":"RESTful","definition":"An architectural style for an application programming interface (API) that uses HTTP requests to access and use data.","_id":"692497cca2be85c6ca237f5f"},{"term":"General Sport API","definition":"The General Sport APIs provide a breadth of coverage across numerous leagues worldwide. All General Sport APIs follow a consistent structure and format between sports, making it easy to consume the data across different leagues or competitions.","_id":"692497cca2be85c6ca237f60"},{"term":"GraphQL","definition":"Click [here](https://graphql.org/learn/) to learn more about GraphQL!","_id":"692497cca2be85c6ca237f61"},{"term":"Rolling Quota","definition":"Our rolling 30-day schedule means calls from 31 days prior are removed from your quota each day.\n\nFor example, a rolling 30-day period at the end of a month could include requests from the 1st to the 30th. The following day would take requests made from the 2nd to the 31st.","_id":"692497cca2be85c6ca237f62"},{"term":"Elam Ending","definition":"The game clock is turned off for the final \"Elam\" period. A target score is established based on the leading team’s current score plus a fixed value. The first team to reach the target score on a made basket wins.","_id":"692497cca2be85c6ca237f63"},{"term":"Quad 1","definition":"Home games vs. RPI teams ranked in the top 30; neutral games vs. 1-50; away games vs. 1-75.","_id":"692497cca2be85c6ca237f64"},{"term":"Quad 2","definition":"Home vs. 31-75 teams; neutral vs. 51-100; away vs. 76-135.","_id":"692497cca2be85c6ca237f65"},{"term":"Quad 3","definition":"Home vs. 76-160 teams; neutral vs. 101-200; away vs. 136-240.","_id":"692497cca2be85c6ca237f66"},{"term":"Quad 4","definition":"Home vs. 161-plus teams; neutral vs. 201-plus; away vs. 241-plus.","_id":"692497cca2be85c6ca237f67"},{"term":"RESTful","definition":"An architectural style for an application programming interface (API) that uses HTTP requests to access and use data.","_id":"692497cca2be85c6ca237f68"},{"term":"General Sport API","definition":"The General Sport APIs provide a breadth of coverage across numerous leagues worldwide. All General Sport APIs follow a consistent structure and format between sports, making it easy to consume the data across different leagues or competitions.","_id":"692497cca2be85c6ca237f69"},{"term":"GraphQL","definition":"Click [here](https://graphql.org/learn/) to learn more about GraphQL!","_id":"692497cca2be85c6ca237f6a"},{"term":"Rolling Quota","definition":"Our rolling 30-day schedule means calls from 31 days prior are removed from your quota each day.\n\nFor example, a rolling 30-day period at the end of a month could include requests from the 1st to the 30th. The following day would take requests made from the 2nd to the 31st.","_id":"692497cca2be85c6ca237f6b"},{"term":"marquee","definition":"A big, spotlighted event that is meant to draw attention and generate excitement.","_id":"692497cca2be85c6ca237f6c"},{"term":"Quad 1","definition":"Home games vs. RPI teams ranked in the top 30; neutral games vs. 1-50; away games vs. 1-75.","_id":"692497cca2be85c6ca237f6d"},{"term":"Quad 2","definition":"Home vs. 31-75 teams; neutral vs. 51-100; away vs. 76-135.","_id":"692497cca2be85c6ca237f6e"},{"term":"Quad 3","definition":"Home vs. 76-160 teams; neutral vs. 101-200; away vs. 136-240.","_id":"692497cca2be85c6ca237f6f"},{"term":"Quad 4","definition":"Home vs. 161-plus teams; neutral vs. 201-plus; away vs. 241-plus.","_id":"692497cca2be85c6ca237f70"},{"term":"RESTful","definition":"An architectural style for an application programming interface (API) that uses HTTP requests to access and use data.","_id":"692497cca2be85c6ca237f71"},{"term":"General Sport API","definition":"The General Sport APIs provide a breadth of coverage across numerous leagues worldwide. All General Sport APIs follow a consistent structure and format between sports, making it easy to consume the data across different leagues or competitions.","_id":"692497cca2be85c6ca237f72"},{"term":"GraphQL","definition":"Click [here](https://graphql.org/learn/) to learn more about GraphQL!","_id":"692497cca2be85c6ca237f73"},{"term":"Rolling Quota","definition":"Our rolling 30-day schedule means calls from 31 days prior are removed from your quota each day.\n\nFor example, a rolling 30-day period at the end of a month could include requests from the 1st to the 30th. The following day would take requests made from the 2nd to the 31st.","_id":"692497cca2be85c6ca237f74"},{"term":"GUID","definition":"Global Unique Identifier","_id":"692497cca2be85c6ca237f75"}],"variables":{"user":{},"defaults":[{"name":"x-api-key","source":"security","type":"apiKey","_id":"692496faad25b92dd30fbffd"}]}}},"sidebar":[{"pages":[{"deprecated":false,"hidden":false,"isBodyEmpty":false,"renderable":{"status":true},"slug":"overview","title":"Basketball API Overview","type":"basic","updatedAt":"2026-10-01T21:23:46.000Z","pages":[],"category":"/branches/8/categories/reference/Intro","uri":"/branches/8/reference/overview","parent":null}],"title":"Intro","uri":"/branches/8/categories/reference/Intro"},{"pages":[{"