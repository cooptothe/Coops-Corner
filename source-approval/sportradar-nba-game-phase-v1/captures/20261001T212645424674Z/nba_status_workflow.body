rtant;\n  }\n\n  /* Sport tile hover */\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-soccer/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-basketball/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-football/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-baseball/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-hockey/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-cricket/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-racing/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-tennis/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-golf/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-mma/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-rugby/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-handball/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-aussie-football/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-badminton/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-bandy/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-darts/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-field-hockey/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-futsal/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-snooker/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-squash/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-table-tennis/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-volleyball/\"]:hover {\n    background: #e8eaf6 !important;\n    color: #1a237e !important;\n  }\n\n  /* \"More Sports\" reads as a soft catch-all */\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-baseline/\"] {\n    font-style: italic !important;\n    color: #5c6bc0