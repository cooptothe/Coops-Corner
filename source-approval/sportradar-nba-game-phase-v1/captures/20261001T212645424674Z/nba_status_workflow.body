e,"changelog":false,"discuss":false,"suggested_edits":false,"logs":false,"custompages":true,"tutorials":false},"id":"63a30795be9ed202ac6b4d1c","name":"Squash","subdomain":"sportradar-squash","subpath":"squash","nav_names":{"docs":"","reference":"Docs","changelog":"Release Log","discuss":"","tutorials":"","recipes":""}},{"modules":{"landing":false,"docs":false,"examples":true,"reference":true,"graphql":false,"changelog":false,"discuss":false,"suggested_edits":false,"logs":false,"custompages":true,"tutorials":false},"id":"63a30759085aa0067f56f2d1","name":"Table Tennis","subdomain":"sportradar-table-tennis","subpath":"table-tennis","nav_names":{"docs":"","reference":"Docs","changelog":"Release Log","discuss":"","tutorials":"","recipes":""}},{"modules":{"landing":false,"docs":true,"examples":true,"reference":true,"graphql":false,"changelog":false,"discuss":false,"suggested_edits":false,"logs":false,"custompages":true,"tutorials":false},"id":"63a12bba08a2590050299abb","name":"Tennis","subdomain":"sportradar-tennis","subpath":"tennis","nav_names":{"docs":"Integration Guides","reference":"Docs","changelog":"Release","discuss":"","tutorials":"","recipes":""}},{"modules":{"landing":false,"docs":false,"examples":true,"reference":true,"graphql":false,"changelog":false,"discuss":false,"suggested_edits":false,"logs":false,"custompages":true,"tutorials":false},"id":"63a3068c9fa932064de08253","name":"Volleyball","subdomain":"sportradar-volleyball","subpath":"volleyball","nav_names":{"docs":"","reference":"Docs","changelog":"Release Log","discuss":"","tutorials":"","recipes":""}},{"modules":{"landing":false,"docs":false,"examples":true,"reference":true,"graphql":false,"changelog":false,"discuss":false,"suggested_edits":false,"logs":false,"custompages":true,"tutorials":false},"id":"6351742404e475002ab33a13","name":"More Sports","subdomain":"sportradar-baseline","subpath":"more-sports","nav_names":{"docs":"","reference":"Docs","changelog":"Release Log","discuss":"","tutorials":"","recipes":""}},{"modules":{"landing":false,"docs":true,"examples":true,"reference":false,"graphql":false,"changelog":true,"discuss":false,"suggested_edits":false,"logs":false,"custompages":true,"tutorials":false},"id":"64c15b76c823b4006c9a4f4a","name":"sportradar-updates","subdomain":"sportradar-additional","subpath":"sportradar-updates","nav_names":{"docs":"","reference":"","changelog":"Release Log","discuss":"","recipes":"","tutorials":""}}],"urlManagerOpts":{"lang":"en","parent":{"subdomain":"sportradar-group","childrenProjects":["getting-started","insights","images-and-editorials","widgets","odds","broadcast","sports-api","aussie-rules-football","badminton","bandy","baseball","basketball","cricket","darts","field-hockey","football","futsal","golf","handball","ice-hockey","mma","racing","rugby","snooker","soccer","squash","table-tennis","tennis","volleyball","more-sports","sportradar-updates","odds-partner"]},"project":{"subdomain":"basketball"},"version":"8"}},"customBlocks":[{"name":"NBA Coverage Levels","project":"63517a19c854d800a4cfec52","processing_status":null,"renderable":{"status":true},"source":"## Coverage Levels\n\nWe provide two different levels of detail to ensure maximum coverage. We combine coverage levels with the correct feeds to ensure you are getting the most comprehensive data offering in the most efficient manner possible. Full coverage is available for all regular and postseason games. Most preseason games will also have full coverage, though in some rare cases extended boxscore may be used.\n\n\u003cb>Full\u003c/b> – We provide live play-by-play coverage for the entire game. We provide updated scores and time remaining as well as team- and player-level data in near real time.\n\n\u003cb>Extended Boxscore\u003c/b> – We provide scores, time remaining, and team leaders (assists, points, and rebounds), in a timely manner, as the game progresses. We provide team- and player-level data for the game within 30 minutes of the official results being posted.\n\n\u003cCallout icon=\"🏀\" theme=\"default\">\n  ### Preseason Coverage Note:\n\n  Preseason coverage of NBA games may vary. Some games may be **extended boxscore** coverage due to on-venue data-entry being unavailable.\n\n  API data latency will vary compared to regular season games, due to collection and processing differences. Preseason games serve as a testing ground, often resulting in changes and adjustments to data collection methods. As a result, data updates may not be as timely or consistent as the regular season.\n\u003c/Callout>","tag":"NBACoverageLevels","type":"content","updated_at":"2025-08-18T19:03:38.000Z","uri":"/branches/8/custom_blocks/NBACoverageLevels","links":{"project":"/projects/me"},"usage":{"page_count":null,"project_count":null},"branch":{"uri":"/branches/8","name":"8"}},{"name":"NBA Game Status Definitions","project":"63517a19c854d800a4cfec52","processing_status":null,"renderable":{"status":true},"source":"* `scheduled` - The game is scheduled to occur.\n* `created` – The game has been created and we have begun logging information.\n* `inprogress` – The game is in progress.\n* `halftime` - The game is currently at halftime.\n* `complete` – The game is over, but stat validation is not complete.\n* `closed` – The game is over and the stats have been validated.\n* `cancelled` – The game has been cancelled. No makeup game will be played as a result.\n* `delayed` – The start of the game is currently delayed or the game has gone from in progress to delayed for some reason.\n* `postponed` – The game has been postponed, to be made up at another day and time. Once the makeup game is announced, a new game and ID will be created and scheduled on the announced makeup date. \n* `time-tbd` – The game has been scheduled, but a time has yet to be announced.\n* `if-necessary` – The game will be scheduled if it is required.\n* `unnecessary` – The series game was scheduled to occur, but will not take place due to one team clinching the series early.","tag":"NBAGameStatusDefinitions","type":"content","updated_at":"2025-08-18T19:03:39.000Z","uri":"/branches/8/custom_blocks/NBAGameStatusDefinitions","links":{"project":"/projects/me"},"usage":{"page_count":null,"project_count":null},"branch":{"uri":"/branches/8","name":"8"}}],"document":{"allow_crawlers":"enabled","processing_status":null,"renderable":{"status":true},"slug":"nba-ig-game-status-workflow","state":"current","title":"Game Status Workflow","type":"basic","updated_at":"2026-09-01T10:22:59.000Z","uri":"/branches/8/guides/nba-ig-game-status-workflow","appearance":{"icon":{"name":null,"type":null},"table_of_contents":"default"},"category":{"uri":"/branches/8/categories/guides/NBA%20Integration%20Guide"},"href":{"dash":"https://dash.readme.com/project/sportradar-basketball/v8/docs/nba-ig-game-status-workflow","hub":"https://developer.sportradar.com/basketball/docs/nba-ig-game-status-workflow","github_url":null},"links":{"project":"/projects/me"},"parent":{"uri":null},"privacy":{"view":"public"},"project":{"name":"Basketball","subdomain":"sportradar-basketball","uri":"/projects/me"},"content":{"body":"## Intro\n\nAn NBA game travels through many statuses in its lifecycle. Leverage the game `status` to inform on the appropriate endpoint to retrieve.\n\nGame status is available in every **Schedule** and **Game** endpoint. To retrieve a game's initial status and schedule information it would be most appropriate to request the [Schedule](https://developer.sportradar.com/basketball/reference/nba-schedule) or [Daily Schedule](https://developer.sportradar.com/basketball/reference/nba-daily-schedule) endpoints.\n\n```xml Schedule Snippet (XML)\n\u003cgame id=\"a06b10fa-fd80-4058-9e0a-d3d1d69cb6f1\" status=\"scheduled\" coverage=\"full\" scheduled=\"2024-10-22T23:30:00Z\"\n      track_on_court=\"true\" sr_id=\"sr:match:52631111\" reference=\"0022400061\"\n      home_team=\"583eccfa-fb46-11e1-82cb-f4ce4684ea4c\" away_team=\"583ec70e-fb46-11e1-82cb-f4ce4684ea4c\">\n```\n```json Schedule Snippet (JSON)\n  {\n  \"games\": [\n    {\n      \"id\": \"a06b10fa-fd80-4058-9e0a-d3d1d69cb6f1\",\n      \"status\": \"scheduled\",\n      \"coverage\": \"full\",\n      \"scheduled\": \"2024-10-22T23:30:00Z\",\n      \"track_on_court\": true,\n      \"sr_id\": \"sr:match:52631111\",\n      \"reference\": \"0022400061\",\n      \"time_zones\": {\n        \"venue\": \"US/Eastern\",\n        \"home\": \"US/Eastern\",\n        \"away\": \"US/Eastern\"\n      },\n      \"venue\": {\n        \"id\": \"7d69b080-91ca-53c9-9302-45c1a72c5549\",\n        \"name\": \"TD Garden\",\n        \"capacity\": 18624,\n        \"address\": \"100 Legends Way\",\n        \"city\": \"Boston\",\n        \"state\": \"MA\",\n        \"zip\": \"02114\",\n        \"country\": \"USA\",\n        \"sr_id\": \"sr:venue:5940\",\n        \"location\": {\n          \"lat\": \"42.366303\",\n          \"lng\": \"-71.062228\"\n        }\n      },\n      \"broadcasts\": [\n        {\n          \"network\": \"TNT\",\n          \"type\": \"TV\",\n          \"locale\": \"National\",\n          \"channel\": \"245\"\n        }\n      ],\n      \"home\": {\n        \"name\": \"Boston Celtics\",\n        \"alias\": \"BOS\",\n        \"id\": \"583eccfa-fb46-11e1-82cb-f4ce4684ea4c\",\n        \"sr_id\": \"sr:team:3422\",\n        \"reference\": \"1610612738\"\n      },\n      \"away\": {\n        \"name\": \"New York Knicks\",\n        \"alias\": \"NYK\",\n        \"id\": \"583ec70e-fb46-11e1-82cb-f4ce4684ea4c\",\n        \"sr_id\": \"sr:team:3421\",\n        \"reference\": \"1610612752\"\n      }\n    }\n  ]\n}\n```\n\n\u003cbr />\n\n***\n\n\u003cNBACoverageLevels />\n\n\u003cbr />\n\n***\n\n## Game Status Definitions\n\nBelow are each of the valid game statuses you can expect to see in the NBA API. Reference these definitions for precise detail on what each game state signifies.\n\n\u003cNBAGameStatusDefinitions />\n\n\u003cbr />\n\n***\n\n## Game Workflows\n\nSee the below diagrams for common game status flows, with context around each update.\n\n\u003cbr />\n\n### Standard Game\n\nBelow is the flow for a typical NBA game from `scheduled` to `closed`.\n\n\u003cdiv style={{border: \"1px solid #C5CAE9\", borderRadius: \"12px\", overflow: \"hidden\", margin: \"4px 0 8px\"}}>\n  \u003cdiv style={{background: \"linear-gradient(90deg, #1A237E 0%, #283593 60%, #3949AB 100%)\", color: \"#FFFFFF\", padding: \"10px 18px\", display: \"flex\", alignItems: \"baseline\", justifyContent: \"space-between\", flexWrap: \"wrap\", gap: \"4px 12px\"}}>\n    \u003cspan style={{fontWeight: 700, fontSize: \"14px\", letterSpacing: \"0.02em\"}}>Standard Game Flow\u003c/span>\n    \u003cspan style={{fontSize: \"12px\", opacity: 0.8}}>scheduled to closed, with what each move signals\u003c/span>\n  \u003c/div>\n  \u003cdiv style={{padding: \"12px 18px\", background: \"#FFFFFF\", display: \"flex\", flexDirection: \"column\", gap: \"10px\"}}>\n    \u003cdiv style={{display: \"flex\", flexWrap: \"wrap\", gap: \"8px\", alignItems: \"center\"}}>\n      \u003cspan style={{minWidth: \"96px\", fontSize: \"12px\", color: \"#6B7280\", fontWeight: 700}}>1. Pregame\u003c/span>\n      \u003cspan style={{display: \"inline-block\", minWidth: \"118px\", textAlign: \"center\", padding: \"4px 10px\", borderRadius: \"999px\", border: \"1px solid #C5CAE9\", background: \"#F3F6FA\", color: \"#1A237E\", fontSize: \"12.5px\", fontWeight: 600, fontFamily: \"SFMono-Regular, Menlo, Consolas, monospace\", whiteSpace: \"nowrap\"}}>scheduled\u003c/span>\n      \u003cspan style={{flex: \"1 1 260px\", fontSize: \"12px\", color: \"#6B7280\"}}>The game is scheduled to occur, with a determined date and time. Status appears in every schedule and game feed.\u003c/span>\n    \u003c/div>\n    \u003cdiv style={{display: \"flex\", flexWrap: \"wrap\", gap: \"8px\", alignItems: \"center\"}}>\n      \u003cspan style={{minWidth: \"96px\", fontSize: \"12px\", color: \"#6B7280\", fontWeight: 700}}>2. Preload\u003c/span>\n      \u003cspan style={{display: \"inline-block\", minWidth: \"118px\", textAlign: \"center\", padding: \"4px 10px\", borderRadius: \"999px\", border: \"1px solid #C5CAE9\", background: \"#F3F6FA\", color: \"#1A237E\", fontSize: \"12.5px\", fontWeight: 600, fontFamily: \"SFMono-Regular, Menlo, Consolas, monospace\", whiteSpace: \"nowrap\"}}>created\u003c/span>\n      \u003cspan style={{flex: \"1 1 260px\", fontSize: \"12px\", color: \"#6B7280\"}}>Game data (rosters, officials, and more) pre-loads, and each team's roster is applied to the game. Game starters (starters=\"true\") display about 45 minutes before the start of the game; player participation (played=\"true\") updates for starters before the game, and for other players as they appear in the game.\u003c/span>\n    \u003c/div>\n    \u003cdiv style={{display: \"flex\", flexWrap: \"wrap\", gap: \"8px\", alignItems: \"center\"}}>\n      \u003cspan style={{minWidth: \"96px\", fontSize: \"12px\", color: \"#6B7280\", fontWeight: 700}}>3. Jump ball\u003c/span>\n      \u003cspan style={{display: \"inline-block\", minWidth: \"118px\", textAlign: \"center\", padding: \"4px 10px\", borderRadius: \"999px\", border: \"1px solid #C5CAE9\", background: \"#F3F6FA\", color: \"#1A237E\", fontSize: \"12.5px\", fontWeight: 600, fontFamily: \"SFMono-Regular, Menlo, Consolas, monospace\", whiteSpace: \"nowrap\"}}>inprogress\u003c/span>\n      \u003cspan style={{flex: \"1 1 260px\", fontSize: \"12px\", color: \"#6B7280\"}}>Set after the jump ball. Poll the game feeds for realtime updates; game feeds can reach inprogress before the schedule feeds, whose status updates on a timer.\u003c/span>\n    \u003c/div>\n    \u003cdiv style={{display: \"flex\", flexWrap: \"wrap\", gap: \"8px\", alignItems: \"center\"}}>\n      \u003cspan style={{minWidth: \"96px\", fontSize: \"12px\", color: \"#6B7280\", fontWeight: 700}}>4. Break\u003c/span>\n      \u003cspan style={{display: \"inline-block\", minWidth: \"118px\", textAlign: \"center\", padding: \"4px 10px\", borderRadius: \"999px\", border: \"1px solid #C5CAE9\", background: \"#F3F6FA\", color: \"#1A237E\", fontSize: \"12.5px\", fontWeight: 600, fontFamily: \"SFMono-Regular, Menlo, Consolas, monospace\", whiteSpace: \"nowrap\"}}>halftime\u003c/span>\n      \u003cspan style={{flex: \"1 1 260px\", fontSize: \"12px\", color: \"#6B7280\"}}>The game is at halftime.\u003c/span>\n    \u003c/div>\n    \u003cdiv style={{display: \"flex\", flexWrap: \"wrap\", gap: \"8px\", alignItems: \"center\"}}>\n      \u003cspan style={{minWidth: \"96px\", fontSize: \"12px\", color: \"#6B7280\", fontWeight: 700}}>5. Second half\u003c/span>\n      \u003cspan style={{display: \"inline-block\", minWidth: \"118px\", textAlign: \"center\", padding: \"4px 10px\", borderRadius: \"999px\", border: \"1px solid #C5CAE9\", background: \"#F3F6FA\", color: \"#1A237E\", fontSize: \"12.5px\", fontWeight: 600, fontFamily: \"SFMono-Regular, Menlo, Consolas, monospace\", whiteSpace: \"nowrap\"}}>inprogress\u003c/span>\n      \u003cspan style={{flex: \"1 1 260px\", fontSize: \"12px\", color: \"#6B7280\"}}>Play resumes at the beginning of the second half.\u003c/span>\n    \u003c/div>\n    \u003cdiv style={{display: \"flex\", flexWrap: \"wrap\", gap: \"8px\", alignItems: \"center\"}}>\n      \u003cspan style={{minWidth: \"96px\", fontSize: \"12px\", color: \"#6B7280\", fontWeight: 700}}>6. Final score\u003c/span>\n      \u003cspan style={{display: \"inline-block\", minWidth: \"118px\", textAlign: \"center\", padding: \"4px 10px\", borderRadius: \"999px\", border: \"1px solid #C5CAE9\", background: \"#F3F6FA\", color: \"#1A237E\", fontSize: \"12.5px\", fontWeight: 600, fontFamily: \"SFMono-Regular, Menlo, Consolas, monospace\", whiteSpace: \"nowrap\"}}>complete\u003c/span>\n      \u003cspan style={{flex: \"1 1 260px\", fontSize: \"12px\", color: \"#6B7280\"}}>The game is over and the score is correct; all other game statistics are reviewed and verified in the post-game verification process.\u003c/span>\n    \u003c/div>\n    \u003cdiv style={{display: \"flex\", flexWrap: \"wrap\", gap: \"8px\", alignItems: \"center\"}}>\n      \u003cspan style={{minWidth: \"96px\", fontSize: \"12px\", color: \"#6B7280\", fontWeight: 700}}>7. Validated\u003c/span>\n      \u003cspan style={{display: \"inline-block\", minWidth: \"118px\", textAlign: \"center\", padding: \"4px 10px\", borderRadius: \"999px\", border: \"1px solid #070D44\", background: \"#070D44\", color: \"#FFFFFF\", fontSize: \"12.5px\", fontWeight: 700, fontFamily: \"SFMono-Regular, Menlo, Consolas, monospace\", whiteSpace: \"nowrap\"}}>closed\u003c/span>\n      \u003cspan style={{flex: \"1 1 260px\", fontSize: \"12px\", color: \"#6B7280\"}}>All stats are validated. Post-game verification covers player and team statistics, game attendance and duration, and referees. Adjustments can still land after closed; follow the Daily Change Log.\u003c/span>\n    \u003c/div>\n  \u003c/div>\n  \u003cdiv style={{padding: \"8px 18px\", borderTop: \"1px solid #E8EAF6\", fontSize: \"12px\", color: \"#6B7280\", background: \"#FAFAFA\"}}>complete marks the game over with the score correct; closed marks every stat validated.\u003c/div>\n\u003c/div>\n\u003cbr />\n\n***\n\n### Time-TBD\n\nBelow is the flow of a `time-tbd` game. Once this game reaches `scheduled` status it follows the [Standard Game](https://developer.sportradar.com/basketball/docs/nba-ig-game-status-workflow#standard-game) flow.\n\n\u003cdiv style={{border: \"1px solid #C5CAE9\", borderRadius: \"12px\", overflow: \"hidden\", margin: \"4px 0 8px\"}}>\n  \u003cdiv style={{background: \"linear-gradient(90deg, #1A237E 0%, #283593 60%, #3949AB 100%)\", color: \"#FFFFFF\", padding: \"10px 18px\", display: \"flex\", alignItems: \"baseline\", justifyContent: \"space-between\", flexWrap: \"wrap\", gap: \"4px 12px\"}}>\n    \u003cspan style={{fontWeight: 700, fontSize: \"14px\", letterSpacing: \"0.02em\"}}>Time TBD\u003c/span>\n    \u003cspan style={{fontSize: \"12px\", opacity: 0.8}}>a placeholder status that resolves to scheduled\u003c/span>\n  \u003c/div>\n  \u003cdiv style={{padding: \"12px 18px\", background: \"#FFFFFF\", display: \"flex\", flexDirection: \"column\", gap: \"10px\"}}>\n    \u003cdiv style={{display: \"flex\", flexWrap: \"wrap\", gap: \"8px\", alignItems: \"center\"}}>\n      \u003cspan style={{minWidth: \"96px\", fontSize: \"12px\", color: \"#6B7280\", fontWeight: 700}}>No time yet\u003c/span>\n      \u003cspan style={{display: \"inline-block\", minWidth: \"118px\", textAlign: \"center\", padding: \"3px 9px\", borderRadius: \"999px\", border: \"2px solid #2962FF\", background: \"#FFFFFF\", color: \"#1A237E\", fontSize: \"12.5px\", fontWeight: 600, fontFamily: \"SFMono-Regular, Menlo, Consolas, monospace\", whiteSpace: \"nowrap\"}}>time-tbd\u003c/span>\n      \u003cspan style={{flex: \"1 1 260px\", fontSize: \"12px\", color: \"#6B7280\"}}>The game has been scheduled, but a time has yet to be announced.\u003c/span>\n    \u003c/div>\n    \u003cdiv style={{display: \"flex\", flexWrap: \"wrap\", gap: \"8px\", alignItems: \"center\"}}>\n      \u003cspan style={{minWidth: \"96px\", fontSize: \"12px\", color: \"#6B7280\", fontWeight: 700}}>Resolved\u003c/span>\n      \u003cspan style={{display: \"inline-block\", minWidth: \"118px\", textAlign: \"center\", padding: \"4px 10px\", borderRadius: \"999px\", border: \"1px solid #C5CAE9\", background: \"#F3F6FA\", color: \"#1A237E\", fontSize: \"12.5px\", fontWeight: 600, fontFamily: \"SFMono-Regular, Menlo, Consolas, monospace\", whiteSpace: \"nowrap\"}}>scheduled\u003c/span>\n      \u003cspan style={{flex: \"1 1 260px\", fontSize: \"12px\", color: \"#6B7280\"}}>A determined date and time are announced, and the status appears in every schedule and game feed.\u003c/span>\n    \u003c/div>\n  \u003c/div>\n  \u003cdiv style={{padding: \"8px 18px\", borderTop: \"1px solid #E8EAF6\", fontSize: \"12px\", color: \"#6B7280\", background: \"#FAFAFA\"}}>Once the game reaches scheduled, it follows the Standard Game flow.\u003c/div>\n\u003c/div>\n\u003cbr />\n\n***\n\n### Delayed\n\nBelow is the flow of a `delayed` game.\n\nA game can be delayed before it starts or during play. Once a delayed game moves to `inprogress` it follows the [Standard Game](https://developer.sportradar.com/basketball/docs/nba-ig-game-status-workflow#standard-game) flow.\n\n\u003cdiv style={{border: \"1px solid #C5CAE9\", borderRadius: \"12px\", overflow: \"hidden\", margin: \"4px 0 8px\"}}>\n  \u003cdiv style={{background: \"linear-gradient(90deg, #1A237E 0%, #283593 60%, #3949AB 100%)\", color: \"#FFFFFF\", padding: \"10px 18px\", display: \"flex\", alignItems: \"baseline\", justifyContent: \"space-between\", flexWrap: \"wrap\", gap: \"4px 12px\"}}>\n    \u003cspan style={{fontWeight: 700, fontSize: \"14px\", letterSpacing: \"0.02em\"}}>Delayed Game\u003c/span>\n    \u003cspan style={{fontSize: \"12px\", opacity: 0.8}}>a hold before or during play; the game keeps its ID\u003c/span>\n  \u003c/div>\n  \u003cdiv style={{padding: \"12px 18px\", background: \"#FFFFFF\", display: \"flex\", flexDirection: \"column\", gap: \"10px\"}}>\n    \u003cdiv style={{display: \"flex\", flexWrap: \"wrap\", gap: \"8px\", alignItems: \"center\"}}>\n      \u003cspan style={{minWidth: \"96px\", fontSize: \"12px\", color: \"#6B7280\", fontWeight: 700}}>Held up\u003c/span>\n      \u003cspan style={{display: \"inline-block\", minWidth: \"118px\", textAlign: \"center\", padding: \"4px 10px\", borderRadius: \"999px\", border: \"1px solid #C5CAE9\", background: \"#F3F6FA\", color: \"#1A237E\", fontSize: \"12.5px\", fontWeight: 600, fontFamily: \"SFMono-Regular, Menlo, Consolas, monospace\", whiteSpace: \"nowrap\"}}>scheduled\u003c/span>\n      \u003cspan style={{display: \"inline-block\", minWidth: \"118px\", textAlign: \"center\", padding: \"4px 10px\", borderRadius: \"999px\", border: \"1px solid #C5CAE9\", background: \"#F3F6FA\", color: \"#1A237E\", fontSize: \"12.5px\", fontWeight: 600, fontFamily: \"SFMono-Regular, Menlo, Consolas, monospace\", whiteSpace: \"nowrap\"}}>inprogress\u003c/span>\n      \u003cspan style={{flex: \"1 1 260px\", fontSize: \"12px\", color: \"#6B7280\"}}>A delay can begin before or during a game: the start of a scheduled game is held up, or a game already in progress is interrupted.\u003c/span>\n    \u003c/div>\n    \u003cdiv style={{display: \"flex\", flexWrap: \"wrap\", gap: \"8px\", alignItems: \"center\"}}>\n      \u003cspan style={{minWidth: \"96px\", fontSize: \"12px\", color: \"#6B7280\", fontWeight: 700}}>On hold\u003c/span>\n      \u003cspan style={{display: \"inline-block\", minWidth: \"118px\", textAlign: \"center\", padding: \"3px 9px\", borderRadius: \"999px\", border: \"2px solid #2962FF\", background: \"#FFFFFF\", color: \"#1A237E\", fontSize: \"12.5px\", fontWeight: 600, fontFamily: \"SFMono-Regular, Menlo, Consolas, monospace\", whiteSpace: \"nowrap\"}}>delayed\u003c/span>\n      \u003cspan style={{flex: \"1 1 260px\", fontSize: \"12px\", color: \"#6B7280\"}}>The game is delayed. It keeps its game ID and stays on the schedule and game feeds in delayed status; keep polling for the next status change.\u003c/span>\n    \u003c/div>\n    \u003cdiv style={{display: \"flex\", flexWrap: \"wrap\", gap: \"8px\", alignItems: \"center\"}}>\n      \u003cspan style={{minWidth: \"96px\", fontSize: \"12px\", color: \"#6B7280\", fontWeight: 700}}>Resumed\u003c/span>\n      \u003cspan style={{display: \"inline-block\", minWidth: \"118px\", textAlign: \"center\", padding: \"4px 10px\", borderRadius: \"999px\", border: \"1px solid #C5CAE9\", background: \"#F3F6FA\", color: \"#1A237E\", fontSize: \"12.5px\", fontWeight: 600, fontFamily: \"SFMono-Regular, Menlo, Consolas, monospace\", whiteSpace: \"nowrap\"}}>inprogress\u003c/span>\n      \u003cspan style={{flex: \"1 1 260px\", fontSize: \"12px\", color: \"#6B7280\"}}>Play begins, or picks up where it left off, under the same game ID, and the game continues through the Standard Game flow.\u003c/span>\n    \u003c/div>\n    \u003cdiv style={{display: \"flex\", flexWrap: \"wrap\", gap: \"8px\", alignItems: \"center\"}}>\n      \u003cspan style={{minWidth: \"96px\", fontSize: \"12px\", color: \"#6B7280\", fontWeight: 700}}>Not played\u003c/span>\n      \u003cspan style={{display: \"inline-block\", minWidth: \"118px\", textAlign: \"center\", padding: \"4px 10px\", borderRadius: \"999px\", border: \"1px solid #B71C1C\", background: \"#B71C1C\", color: \"#FFFFFF\", fontSize: \"12.5px\", fontWeight: 700, fontFamily: \"SFMono-Regular, Menlo, Consolas, monospace\", whiteSpace: \"nowrap\"}}>postponed\u003c/span>\n      \u003cspan style={{flex: \"1 1 260px\", fontSize: \"12px\", color: \"#6B7280\"}}>If the game cannot continue that day, it moves to postponed. Once the makeup game is announced, a new game and ID are created and scheduled on the announced makeup date.\u003c/span>\n    \u003c/div>\n  \u003c/div>\n  \u003cdiv style={{padding: \"8px 18px\", borderTop: \"1px solid #E8EAF6\", fontSize: \"12px\", color: \"#6B7280\", background: \"#FAFAFA\"}}>Delayed is a holding status, not an end state: the game returns to inprogress under the same game ID or moves on to postponed.\u003c/div>\n\u003c/div>\n\u003cbr />\n\n***\n\n### Postponed\n\nBelow is the flow of a `postponed` game.\n\nOnce a new game is created in `scheduled` status, it follows the [Standard Game](https://developer.sportradar.com/basketball/docs/nba-ig-game-status-workflow#standard-game) flow.\n\n\u003cdiv style={{border: \"1px solid #C5CAE9\", borderRadius: \"12px\", overflow: \"hidden\", margin: \"4px 0 8px\"}}>\n  \u003cdiv style={{background: \"linear-gradient(90deg, #1A237E 0%, #283593 60%, #3949AB 100%)\", color: \"#FFFFFF\", padding: \"10px 18px\", display: \"flex\", alignItems: \"baseline\", justifyContent: \"space-between\", flexWrap: \"wrap\", gap: \"4px 12px\"}}>\n    \u003cspan style={{fontWeight: 700, fontSize: \"14px\", letterSpacing: \"0.02em\"}}>Postponed Game\u003c/span>\n    \u003cspan style={{fontSize: \"12px\", opacity: 0.8}}>the makeup arrives as a new game ID\u003c/span>\n  \u003c/div>\n  \u003cdiv style={{padding: \"12px 18px\", background: \"#FFFFFF\", display: \"flex\", flexDirection: \"column\", gap: \"10px\"}}>\n    \u003cdiv style={{display: \"flex\", flexWrap: \"wrap\", gap: \"8px\", alignItems: \"center\"}}>\n      \u003cspan style={{minWidth: \"96px\", fontSize: \"12px\", color: \"#6B7280\", fontWeight: 700}}>1. On the books\u003c/span>\n      \u003cspan style={{display: \"inline-block\", minWidth: \"118px\", textAlign: \"center\", padding: \"4px 10px\", borderRadius: \"999px\", border: \"1px solid #C5CAE9\", background: \"#F3F6FA\", color: \"#1A237E\", fontSize: \"12.5px\", fontWeight: 600, fontFamily: \"SFMono-Regular, Menlo, Consolas, monospace\", whiteSpace: \"nowrap\"}}>scheduled\u003c/span>\n      \u003cspan style={{flex: \"1 1 260px\", fontSize: \"12px\", color: \"#6B7280\"}}>The game is scheduled to occur, with a determined date and time. Status appears in every schedule and game feed.\u003c/span>\n    \u003c/div>\n    \u003cdiv style={{display: \"flex\", flexWrap: \"wrap\", gap: \"8px\", alignItems: \"center\"}}>\n      \u003cspan style={{minWidth: \"96px\", fontSize: \"12px\", color: \"#6B7280\", fontWeight: 700}}>2. Pushed\u003c/span>\n      \u003cspan style={{display: \"inline-block\", minWidth: \"118px\", textAlign: \"center\", padding: \"4px 10px\", borderRadius: \"999px\", border: \"1px solid #B71C1C\", background: \"#B71C1C\", color: \"#FFFFFF\", fontSize: \"12.5px\", fontWeight: 700, fontFamily: \"SFMono-Regular, Menlo, Consolas, monospace\", whiteSpace: \"nowrap\"}}>postponed\u003c/span>\n      \u003cspan style={{flex: \"1 1 260px\", fontSize: \"12px\", color: \"#6B7280\"}}>The game will be made up at another day and time. Once the makeup game is announced, a new game and ID are created and scheduled on the announced makeup date; request the schedule feeds regularly to identify makeup games.\u003c/span>\n    \u003c/div>\n    \u003cdiv style={{display: \"flex\", flexWrap: \"wrap\", gap: \"8px\", alignItems: \"center\"}}>\n      \u003cspan style={{minWidth: \"96px\", fontSize: \"12px\", color: \"#6B7280\", fontWeight: 700}}>3. Rescheduled\u003c/span>\n      \u003cspan style={{display: \"inline-block\", minWidth: \"118px\", textAlign: \"center\", padding: \"4px 10px\", borderRadius: \"999px\", border: \"1px solid #C5CAE9\", background: \"#F3F6FA\", color: \"#1A237E\", fontSize: \"12.5px\", fontWeight: 600, fontFamily: \"SFMono-Regular, Menlo, Consolas, monospace\", whiteSpace: \"nowrap\"}}>scheduled\u003c/span>\n      \u003cspan style={{flex: \"1 1 260px\", fontSize: \"12px\", color: \"#6B7280\"}}>A new game, with a new game ID, is created in scheduled status when a determined date and time are announced. The postponed and rescheduled game IDs are not linked within the API.\u003c/span>\n    \u003c/div>\n  \u003c/div>\n  \u003cdiv style={{padding: \"8px 18px\", borderTop: \"1px solid #E8EAF6\", fontSize: \"12px\", color: \"#6B7280\", background: \"#FAFAFA\"}}>The original entry keeps the postponed status; the makeup game follows the Standard Game flow under its new ID.\u003c/div>\n\u003c/div>\n\u003cbr />\n\n***\n\n### Cancelled\n\nBelow is the flow of a `cancelled` game.\n\nA cancelled game will remain in `cancelled` status. See game `5126d64c-1865-4ef6-87ce-e64ec9581e1b` as an example.\n\n\u003cdiv style={{border: \"1px solid #C5CAE9\", borderRadius: \"12px\", overflow: \"hidden\", margin: \"4px 0 8px\"}}>\n  \u003cdiv style={{background: \"linear-gradient(90deg, #1A237E 0%, #283593 60%, #3949AB 100%)\", color: \"#FFFFFF\", padding: \"10px 18px\", display: \"flex\", alignItems: \"baseline\", justifyContent: \"space-between\", flexWrap: \"wrap\", gap: \"4px 12px\"}}>\n    \u003cspan style={{fontWeight: 700, fontSize: \"14px\", letterSpacing: \"0.02em\"}}>Cancelled Game\u003c/span>\n    \u003cspan style={{fontSize: \"12px\", opacity: 0.8}}>a terminal status with no makeup game\u003c/span>\n  \u003c/div>\n  \u003cdiv style={{padding: \"12px 18px\", background: \"#FFFFFF\", display: \"flex\", flexDirection: \"column\", gap: \"10px\"}}>\n    \u003cdiv style={{display: \"flex\", flexWrap: \"wrap\", gap: \"8px\", alignItems: \"center\"}}>\n      \u003cspan style={{minWidth: \"96px\", fontSize: \"12px\", color: \"#6B7280\", fontWeight: 700}}>1. On the books\u003c/span>\n      \u003cspan style={{display: \"inline-block\", minWidth: \"118px\", textAlign: \"center\", padding: \"4px 10px\", borderRadius: \"999px\", border: \"1px solid #C5CAE9\", background: \"#F3F6FA\", color: \"#1A237E\", fontSize: \"12.5px\", fontWeight: 600, fontFamily: \"SFMono-Regular, Menlo, Consolas, monospace\", whiteSpace: \"nowrap\"}}>scheduled\u003c/span>\n      \u003cspan style={{flex: \"1 1 260px\", fontSize: \"12px\", color: \"#6B7280\"}}>The game is scheduled to occur, with a determined date and time. Status appears in every schedule and game feed.\u003c/span>\n    \u003c/div>\n    \u003cdiv style={{display: \"flex\", flexWrap: \"wrap\", gap: \"8px\", alignItems: \"center\"}}>\n      \u003cspan style={{minWidth: \"96px\", fontSize: \"12px\", color: \"#6B7280\", fontWeight: 700}}>2. Called off\u003c/span>\n      \u003cspan style={{display: \"inline-block\", minWidth: \"118px\", textAlign: \"center\", padding: \"4px 10px\", borderRadius: \"999px\", border: \"1px solid #B71C1C\", background: \"#B71C1C\", color: \"#FFFFFF\", fontSize: \"12.5px\", fontWeight: 700, fontFamily: \"SFMono-Regular, Menlo, Consolas, monospace\", whiteSpace: \"nowrap\"}}>cancelled\u003c/span>\n      \u003cspan style={{flex: \"1 1 260px\", fontSize: \"12px\", color: \"#6B7280\"}}>The game has been cancelled, and no makeup game will be played.\u003c/span>\n    \u003c/div>\n  \u003c/div>\n  \u003cdiv style={{padding: \"8px 18px\", borderTop: \"1px solid #E8EAF6\", fontSize: \"12px\", color: \"#6B7280\", background: \"#FAFAFA\"}}>Cancelled is terminal: the game remains in cancelled status.\u003c/div>\n\u003c/div>\n\u003cbr />\n\n***\n\n## Game State Samples\n\nClick the links below for sample data of Game feeds by game state.\n\n* [scheduled](https://api-docs.sportradar.us/nba/NBA_API_Scheduled_Samples.zip)\n* [created](https://api-docs.sportradar.us/nba/NBA_API_Created_Samples.zip)\n* [inprogress](https://api-docs.sportradar.us/nba/NBA_API_Inprogress_Samples.zip)\n* [closed](https://api-docs.sportradar.us/nba/NBA_API_Closed_Samples.zip)\n\n\u003cCallout icon=\"🏀\" theme=\"default\">\n  ### Simulations\n\n  We would also suggest using our **[Simulations](https://developer.sportradar.com/getting-started/docs/simulations)** to view each of these game states and test your integration.\n\u003c/Callout>\n\n\u003cbr />\n\n***\n\n## Weekly Data Entry\n\nThis section provides important NBA data update timings for schedules, statistics, rankings, depth charts, and more.\n\nThe daily data entry workflow is the same every day of the week:\n\n* Final game times set for the day's games (10am CT)\n* Game stats validated and moved to `closed` status (60 minutes after the game goes final)\n* Rankings updated (60 minutes after the last game goes final)\n* Seasonal stats validation (all day)\n* Injuries (all day)\n* Transactions (all day)\n\nTransactions and injuries are monitored and updated throughout the day, using a combination of official and reliable sources.\n\n\u003cbr />\n\n### Important Dates\n\nThe NBA schedule becomes available in mid-August. Game times and dates are initially validated two weeks before the game and confirmed on the day of the game.","excerpt":null,"link":{"url":null,"new_tab":false},"next":{"description":null,"pages":[]}},"metadata":{"description":"This document provides information on how to leverage game statuses in the NBA API to retrieve game data, including coverage levels, game status definitions, and common game status flows. It also includes sample data for different game states and information on weekly data entry workflows.","keywords":null,"title":"NBA Game Status Workflow","x_import":null,"image":{"uri":null,"url":null}}},"meta":{"baseUrl":"/basketball","description":"This document provides information on how to leverage game statuses in the NBA API to retrieve game data, including coverage levels, game status definitions, and common game status flows. It also includes sample data for different game states and information on weekly data entry workflows.","hidden":false,"image":[],"metaTitle":"NBA Game Status Workflow","robots":"index","slug":"nba-ig-game-status-workflow","title":"Game Status Workflow","type":"docs","updatedAt":"2026-09-01T10:22:59.000Z"},"rdmd":{"dehydrated":{"toc":"\u003cnav aria-label=\"Table of contents\" class=\"rm-ToC\">\u003cul class=\"toc-list\">\u003cli class=\"toc-children\">\u003cul>\u003cli>\u003ca href=\"#intro\">Intro\u003c/a>\u003c/li>\u003cli>\u003ca href=\"#game-status-definitions\">Game Status Definitions\u003c/a>\u003c/li>\u003cli>\u003ca href=\"#game-workflows\">Game Workflows\u003c/a>\u003c/li>\u003cli>\u003cul>\u003cli>\u003ca href=\"#standard-game\">Standard Game\u003c/a>\u003c/li>\u003cli>\u003ca href=\"#time-tbd\">Time-TBD\u003c/a>\u003c/li>\u003cli>\u003ca href=\"#delayed\">Delayed\u003c/a>\u003c/li>\u003cli>\u003ca href=\"#postponed\">Postponed\u003c/a>\u003c/li>\u003cli>\u003ca href=\"#cancelled\">Cancelled\u003c/a>\u003c/li>\u003c/ul>\u003c/li>\u003cli>\u003ca href=\"#game-state-samples\">Game State Samples\u003c/a>\u003c/li>\u003cli>\u003ca href=\"#weekly-data-entry\">Weekly Data Entry\u003c/a>\u003c/li>\u003cli>\u003cul>\u003cli>\u003ca href=\"#important-dates\">Important Dates\u003c/a>\u003c/li>\u003c/ul>\u003c/li>\u003c/ul>\u003c/li>\u003c/ul>\u003c/nav>","body":"\u003cstyle>/*! tailwindcss v4.1.17 | MIT License | https://tailwindcss.com */\n@layer theme, base, components, utilities;\n@layer utilities;\n\u003c/style>\u003ch2 class=\"heading heading-2 header-scroll\">\u003cdiv class=\"heading-anchor anchor waypoint\" id=\"intro\">\u003c/div>\u003cdiv class=\"heading-text\">Intro\u003c/div>\u003ca aria-label=\"Skip link to Intro\" class=\"heading-anchor-icon fa fa-regular fa-anchor\" href=\"#intro\">\u003c/a>\u003c/h2>\n\u003cp>An NBA game travels through many statuses in its lifecycle. Leverage the game \u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">status\u003c/code> to inform on the appropriate endpoint to retrieve.\u003c/p>\n\u003cp>Game status is available in every \u003cstrong>Schedule\u003c/strong> and \u003cstrong>Game\u003c/strong> endpoint. To retrieve a game&#x27;s initial status and schedule information it would be most appropriate to request the \u003ca href=\"https://developer.sportradar.com/basketball/reference/nba-schedule\" target=\"\" title=\"\">Schedule\u003c/a> or \u003ca href=\"https://developer.sportradar.com/basketball/reference/nba-daily-schedule\" target=\"\" title=\"\">Daily Schedule\u003c/a> endpoints.\u003c/p>\n\u003cdiv class=\"CodeTabs CodeTabs_initial theme-undefined\">\u003cdiv class=\"CodeTabs-toolbar\">\u003cbutton type=\"button\" value=\"xml\">Schedule Snippet (XML)\u003c/button>\u003cbutton type=\"button\" value=\"json\">Schedule Snippet (JSON)\u003c/button>\u003c/div>\u003cdiv class=\"CodeTabs-inner\">\u003cpre>\u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">&lt;game id=&quot;a06b10fa-fd80-4058-9e0a-d3d1d69cb6f1&quot; status=&quot;scheduled&quot; coverage=&quot;full&quot; scheduled=&quot;2024-10-22T23:30:00Z&quot;\n      track_on_court=&quot;true&quot; sr_id=&quot;sr:match:52631111&quot; reference=&quot;0022400061&quot;\n      home_team=&quot;583eccfa-fb46-11e1-82cb-f4ce4684ea4c&quot; away_team=&quot;583ec70e-fb46-11e1-82cb-f4ce4684ea4c&quot;&gt;\u003c/code>\u003c/pre>\u003cpre>\u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">  {\n  &quot;games&quot;: [\n    {\n      &quot;id&quot;: &quot;a06b10fa-fd80-4058-9e0a-d3d1d69cb6f1&quot;,\n      &quot;status&quot;: &quot;scheduled&quot;,\n      &quot;coverage&quot;: &quot;full&quot;,\n      &quot;scheduled&quot;: &quot;2024-10-22T23:30:00Z&quot;,\n      &quot;track_on_court&quot;: true,\n      &quot;sr_id&quot;: &quot;sr:match:52631111&quot;,\n      &quot;reference&quot;: &quot;0022400061&quot;,\n      &quot;time_zones&quot;: {\n        &quot;venue&quot;: &quot;US/Eastern&quot;,\n        &quot;home&quot;: &quot;US/Eastern&quot;,\n        &quot;away&quot;: &quot;US/Eastern&quot;\n      },\n      &quot;venue&quot;: {\n        &quot;id&quot;: &quot;7d69b080-91ca-53c9-9302-45c1a72c5549&quot;,\n        &quot;name&quot;: &quot;TD Garden&quot;,\n        &quot;capacity&quot;: 18624,\n        &quot;address&quot;: &quot;100 Legends Way&quot;,\n        &quot;city&quot;: &quot;Boston&quot;,\n        &quot;state&quot;: &quot;MA&quot;,\n        &quot;zip&quot;: &quot;02114&quot;,\n        &quot;country&quot;: &quot;USA&quot;,\n        &quot;sr_id&quot;: &quot;sr:venue:5940&quot;,\n        &quot;location&quot;: {\n          &quot;lat&quot;: &quot;42.366303&quot;,\n          &quot;lng&quot;: &quot;-71.062228&quot;\n        }\n      },\n      &quot;broadcasts&quot;: [\n        {\n          &quot;network&quot;: &quot;TNT&quot;,\n          &quot;type&quot;: &quot;TV&quot;,\n          &quot;locale&quot;: &quot;National&quot;,\n          &quot;channel&quot;: &quot;245&quot;\n        }\n      ],\n      &quot;home&quot;: {\n        &quot;name&quot;: &quot;Boston Celtics&quot;,\n        &quot;alias&quot;: &quot;BOS&quot;,\n        &quot;id&quot;: &quot;583eccfa-fb46-11e1-82cb-f4ce4684ea4c&quot;,\n        &quot;sr_id&quot;: &quot;sr:team:3422&quot;,\n        &quot;reference&quot;: &quot;1610612738&quot;\n      },\n      &quot;away&quot;: {\n        &quot;name&quot;: &quot;New York Knicks&quot;,\n        &quot;alias&quot;: &quot;NYK&quot;,\n        &quot;id&quot;: &quot;583ec70e-fb46-11e1-82cb-f4ce4684ea4c&quot;,\n        &quot;sr_id&quot;: &quot;sr:team:3421&quot;,\n        &quot;reference&quot;: &quot;1610612752&quot;\n      }\n    }\n  ]\n}\u003c/code>\u003c/pre>\u003c/div>\u003c/div>\n\u003cbr/>\n\u003chr/>\n\u003cdiv class=\"readme-tailwind\">\u003ch2 class=\"heading heading-2 header-scroll\">\u003cdiv class=\"heading-anchor anchor waypoint\" id=\"coverage-levels\">\u003c/div>\u003cdiv class=\"heading-text\">Coverage Levels\u003c/div>\u003ca aria-label=\"Skip link to Coverage Levels\" class=\"heading-anchor-icon fa fa-regular fa-anchor\" href=\"#coverage-levels\">\u003c/a>\u003c/h2>\n\u003cp>We provide two different levels of detail to ensure maximum coverage. We combine coverage levels with the correct feeds to ensure you are getting the most comprehensive data offering in the most efficient manner possible. Full coverage is available for all regular and postseason games. Most preseason games will also have full coverage, though in some rare cases extended boxscore may be used.\u003c/p>\n\u003cp>\u003cb>Full\u003c/b> – We provide live play-by-play coverage for the entire game. We provide updated scores and time remaining as well as team- and player-level data in near real time.\u003c/p>\n\u003cp>\u003cb>Extended Boxscore\u003c/b> – We provide scores, time remaining, and team leaders (assists, points, and rebounds), in a timely manner, as the game progresses. We provide team- and player-level data for the game within 30 minutes of the official results being posted.\u003c/p>\n\u003cblockquote class=\"callout callout_default\" theme=\"🏀\">\u003cspan class=\"callout-icon\">🏀\u003c/span>\u003ch3 class=\"heading heading-3 header-scroll\">\u003cdiv class=\"heading-anchor anchor waypoint\" id=\"preseason-coverage-note\">\u003c/div>\u003cdiv class=\"heading-text\">Preseason Coverage Note:\u003c/div>\u003ca aria-label=\"Skip link to Preseason Coverage Note:\" class=\"heading-anchor-icon fa fa-regular fa-anchor\" href=\"#preseason-coverage-note\">\u003c/a>\u003c/h3>\u003cp>Preseason coverage of NBA games may vary. Some games may be \u003cstrong>extended boxscore\u003c/strong> coverage due to on-venue data-entry being unavailable.\u003c/p>\u003cp>API data latency will vary compared to regular season games, due to collection and processing differences. Preseason games serve as a testing ground, often resulting in changes and adjustments to data collection methods. As a result, data updates may not be as timely or consistent as the regular season.\u003c/p>\u003c/blockquote>\u003c/div>\n\u003cbr/>\n\u003chr/>\n\u003ch2 class=\"heading heading-2 header-scroll\">\u003cdiv class=\"heading-anchor anchor waypoint\" id=\"game-status-definitions\">\u003c/div>\u003cdiv class=\"heading-text\">Game Status Definitions\u003c/div>\u003ca aria-label=\"Skip link to Game Status Definitions\" class=\"heading-anchor-icon fa fa-regular fa-anchor\" href=\"#game-status-definitions\">\u003c/a>\u003c/h2>\n\u003cp>Below are each of the valid game statuses you can expect to see in the NBA API. Reference these definitions for precise detail on what each game state signifies.\u003c/p>\n\u003cdiv class=\"readme-tailwind\">\u003cul>\n\u003cli>\u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">scheduled\u003c/code> - The game is scheduled to occur.\u003c/li>\n\u003cli>\u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">created\u003c/code> – The game has been created and we have begun logging information.\u003c/li>\n\u003cli>\u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">inprogress\u003c/code> – The game is in progress.\u003c/li>\n\u003cli>\u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">halftime\u003c/code> - The game is currently at halftime.\u003c/li>\n\u003cli>\u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">complete\u003c/code> – The game is over, but stat validation is not complete.\u003c/li>\n\u003cli>\u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">closed\u003c/code> – The game is over and the stats have been validated.\u003c/li>\n\u003cli>\u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">cancelled\u003c/code> – The game has been cancelled. No makeup game will be played as a result.\u003c/li>\n\u003cli>\u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">delayed\u003c/code> – The start of the game is currently delayed or the game has gone from in progress to delayed for some reason.\u003c/li>\n\u003cli>\u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">postponed\u003c/code> – The game has been postponed, to be made up at another day and time. Once the makeup game is announced, a new game and ID will be created and scheduled on the announced makeup date.\u003c/li>\n\u003cli>\u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">time-tbd\u003c/code> – The game has been scheduled, but a time has yet to be announced.\u003c/li>\n\u003cli>\u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">if-necessary\u003c/code> – The game will be scheduled if it is required.\u003c/li>\n\u003cli>\u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">unnecessary\u003c/code> – The series game was scheduled to occur, but will not take place due to one team clinching the series early.\u003c/li>\n\u003c/ul>\u003c/div>\n\u003cbr/>\n\u003chr/>\n\u003ch2 class=\"heading heading-2 header-scroll\">\u003cdiv class=\"heading-anchor anchor waypoint\" id=\"game-workflows\">\u003c/div>\u003cdiv class=\"heading-text\">Game Workflows\u003c/div>\u003ca aria-label=\"Skip link to Game Workflows\" class=\"heading-anchor-icon fa fa-regular fa-anchor\" href=\"#game-workflows\">\u003c/a>\u003c/h2>\n\u003cp>See the below diagrams for common game status flows, with context around each update.\u003c/p>\n\u003cbr/>\n\u003ch3 class=\"heading heading-3 header-scroll\">\u003cdiv class=\"heading-anchor anchor waypoint\" id=\"standard-game\">\u003c/div>\u003cdiv class=\"heading-text\">Standard Game\u003c/div>\u003ca aria-label=\"Skip link to Standard Game\" class=\"heading-anchor-icon fa fa-regular fa-anchor\" href=\"#standard-game\">\u003c/a>\u003c/h3>\n\u003cp>Below is the flow for a typical NBA game from \u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">scheduled\u003c/code> to \u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">closed\u003c/code>.\u003c/p>\n\u003cdiv style=\"border:1px solid #C5CAE9;border-radius:12px;overflow:hidden;margin:4px 0 8px\">\u003cdiv style=\"background:linear-gradient(90deg, #1A237E 0%, #283593 60%, #3949AB 100%);color:#FFFFFF;padding:10px 18px;display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:4px 12px\">\u003cspan style=\"font-weight:700;font-size:14px;letter-spacing:0.02em\">Standard Game Flow\u003c/span>\u003cspan style=\"font-size:12px;opacity:0.8\">scheduled to closed, with what each move signals\u003c/span>\u003c/div>\u003cdiv style=\"padding:12px 18px;background:#FFFFFF;display:flex;flex-direction:column;gap:10px\">\u003cdiv style=\"display:flex;flex-wrap:wrap;gap:8px;align-items:center\">\u003cspan style=\"min-width:96px;font-size:12px;color:#6B7280;font-weight:700\">\u003col>\n\u003cli>Pregame\u003c/li>\n\u003c/ol>\u003c/span>\u003cspan style=\"display:inline-block;min-width:118px;text-align:center;padding:4px 10px;border-radius:999px;border:1px solid #C5CAE9;background:#F3F6FA;color:#1A237E;font-size:12.5px;font-weight:600;font-family:SFMono-Regular, Menlo, Consolas, monospace;white-space:nowrap\">scheduled\u003c/span>\u003cspan style=\"flex:1 1 260px;font-size:12px;color:#6B7280\">The game is scheduled to occur, with a determined date and time. Status appears in every schedule and game feed.\u003c/span>\u003c/div>\u003cdiv style=\"display:flex;flex-wrap:wrap;gap:8px;align-items:center\">\u003cspan style=\"min-width:96px;font-size:12px;color:#6B7280;font-weight:700\">\u003col start=\"2\">\n\u003cli>Preload\u003c/li>\n\u003c/ol>\u003c/span>\u003cspan style=\"display:inline-block;min-width:118px;text-align:center;padding:4px 10px;border-radius:999px;border:1px solid #C5CAE9;background:#F3F6FA;color:#1A237E;font-size:12.5px;font-weight:600;font-family:SFMono-Regular, Menlo, Consolas, monospace;white-space:nowrap\">created\u003c/span>\u003cspan style=\"flex:1 1 260px;font-size:12px;color:#6B7280\">Game data (rosters, officials, and more) pre-loads, and each team&#x27;s roster is applied to the game. Game starters (starters=&quot;true&quot;) display about 45 minutes before the start of the game; player participation (played=&quot;true&quot;) updates for starters before the game, and for other players as they appear in the game.\u003c/span>\u003c/div>\u003cdiv style=\"display:flex;flex-wrap:wrap;gap:8px;align-items:center\">\u003cspan style=\"min-width:96px;font-size:12px;color:#6B7280;font-weight:700\">\u003col start=\"3\">\n\u003cli>Jump ball\u003c/li>\n\u003c/ol>\u003c/span>\u003cspan style=\"display:inline-block;min-width:118px;text-align:center;padding:4px 10px;border-radius:999px;border:1px solid #C5CAE9;background:#F3F6FA;color:#1A237E;font-size:12.5px;font-weight:600;font-family:SFMono-Regular, Menlo, Consolas, monospace;white-space:nowrap\">inprogress\u003c/span>\u003cspan style=\"flex:1 1 260px;font-size:12px;color:#6B7280\">Set after the jump ball. Poll the game feeds for realtime updates; game feeds can reach inprogress before the schedule feeds, whose status updates on a timer.\u003c/span>\u003c/div>\u003cdiv style=\"display:flex;flex-wrap:wrap;gap:8px;align-items:center\">\u003cspan style=\"min-width:96px;font-size:12px;color:#6B7280;font-weight:700\">\u003col start=\"4\">\n\u003cli>Break\u003c/li>\n\u003c/ol>\u003c/span>\u003cspan style=\"display:inline-block;min-width:118px;text-align:center;padding:4px 10px;border-radius:999px;border:1px solid #C5CAE9;background:#F3F6FA;color:#1A237E;font-size:12.5px;font-weight:600;font-family:SFMono-Regular, Menlo, Consolas, monospace;white-space:nowrap\">halftime\u003c/span>\u003cspan style=\"flex:1 1 260px;font-size:12px;color:#6B7280\">The game is at halftime.\u003c/span>\u003c/div>\u003cdiv style=\"display:flex;flex-wrap:wrap;gap:8px;align-items:center\">\u003cspan style=\"min-width:96px;font-size:12px;color:#6B7280;font-weight:700\">\u003col start=\"5\">\n\u003cli>Second half\u003c/li>\n\u003c/ol>\u003c/span>\u003cspan style=\"display:inline-block;min-width:118px;text-align:center;padding:4px 10px;border-radius:999px;border:1px solid #C5CAE9;background:#F3F6FA;color:#1A237E;font-size:12.5px;font-weight:600;font-family:SFMono-Regular, Menlo, Consolas, monospace;white-space:nowrap\">inprogress\u003c/span>\u003cspan style=\"flex:1 1 260px;font-size:12px;color:#6B7280\">Play resumes at the beginning of the second half.\u003c/span>\u003c/div>\u003cdiv style=\"display:flex;flex-wrap:wrap;gap:8px;align-items:center\">\u003cspan style=\"min-width:96px;font-size:12px;color:#6B7280;font-weight:700\">\u003col start=\"6\">\n\u003cli>Final score\u003c/li>\n\u003c/ol>\u003c/span>\u003cspan style=\"display:inline-block;min-width:118px;text-align:center;padding:4px 10px;border-radius:999px;border:1px solid #C5CAE9;background:#F3F6FA;color:#1A237E;font-size:12.5px;font-weight:600;font-family:SFMono-Regular, Menlo, Consolas, monospace;white-space:nowrap\">complete\u003c/span>\u003cspan style=\"flex:1 1 260px;font-size:12px;color:#6B7280\">The game is over and the score is correct; all other game statistics are reviewed and verified in the post-game verification process.\u003c/span>\u003c/div>\u003cdiv style=\"display:flex;flex-wrap:wrap;gap:8px;align-items:center\">\u003cspan style=\"min-width:96px;font-size:12px;color:#6B7280;font-weight:700\">\u003col start=\"7\">\n\u003cli>Validated\u003c/li>\n\u003c/ol>\u003c/span>\u003cspan style=\"display:inline-block;min-width:118px;text-align:center;padding:4px 10px;border-radius:999px;border:1px solid #070D44;background:#070D44;color:#FFFFFF;font-size:12.5px;font-weight:700;font-family:SFMono-Regular, Menlo, Consolas, monospace;white-space:nowrap\">closed\u003c/span>\u003cspan style=\"flex:1 1 260px;font-size:12px;color:#6B7280\">All stats are validated. Post-game verification covers player and team statistics, game attendance and duration, and referees. Adjustments can still land after closed; follow the Daily Change Log.\u003c/span>\u003c/div>\u003c/div>\u003cdiv style=\"padding:8px 18px;border-top:1px solid #E8EAF6;font-size:12px;color:#6B7280;background:#FAFAFA\">complete marks the game over with the score correct; closed marks every stat validated.\u003c/div>\u003c/div>\n\u003cbr/>\n\u003chr/>\n\u003ch3 class=\"heading heading-3 header-scroll\">\u003cdiv class=\"heading-anchor anchor waypoint\" id=\"time-tbd\">\u003c/div>\u003cdiv class=\"heading-text\">Time-TBD\u003c/div>\u003ca aria-label=\"Skip link to Time-TBD\" class=\"heading-anchor-icon fa fa-regular fa-anchor\" href=\"#time-tbd\">\u003c/a>\u003c/h3>\n\u003cp>Below is the flow of a \u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">time-tbd\u003c/code> game. Once this game reaches \u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">scheduled\u003c/code> status it follows the \u003ca href=\"https://developer.sportradar.com/basketball/docs/nba-ig-game-status-workflow#standard-game\" target=\"\" title=\"\">Standard Game\u003c/a> flow.\u003c/p>\n\u003cdiv style=\"border:1px solid #C5CAE9;border-radius:12px;overflow:hidden;margin:4px 0 8px\">\u003cdiv style=\"background:linear-gradient(90deg, #1A237E 0%, #283593 60%, #3949AB 100%);color:#FFFFFF;padding:10px 18px;display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:4px 12px\">\u003cspan style=\"font-weight:700;font-size:14px;letter-spacing:0.02em\">Time TBD\u003c/span>\u003cspan style=\"font-size:12px;opacity:0.8\">a placeholder status that resolves to scheduled\u003c/span>\u003c/div>\u003cdiv style=\"padding:12px 18px;background:#FFFFFF;display:flex;flex-direction:column;gap:10px\">\u003cdiv style=\"display:flex;flex-wrap:wrap;gap:8px;align-items:center\">\u003cspan style=\"min-width:96px;font-size:12px;color:#6B7280;font-weight:700\">No time yet\u003c/span>\u003cspan style=\"display:inline-block;min-width:118px;text-align:center;padding:3px 9px;border-radius:999px;border:2px solid #2962FF;background:#FFFFFF;color:#1A237E;font-size:12.5px;font-weight:600;font-family:SFMono-Regular, Menlo, Consolas, monospace;white-space:nowrap\">time-tbd\u003c/span>\u003cspan style=\"flex:1 1 260px;font-size:12px;color:#6B7280\">The game has been scheduled, but a time has yet to be announced.\u003c/span>\u003c/div>\u003cdiv style=\"display:flex;flex-wrap:wrap;gap:8px;align-items:center\">\u003cspan style=\"min-width:96px;font-size:12px;color:#6B7280;font-weight:700\">Resolved\u003c/span>\u003cspan style=\"display:inline-block;min-width:118px;text-align:center;padding:4px 10px;border-radius:999px;border:1px solid #C5CAE9;background:#F3F6FA;color:#1A237E;font-size:12.5px;font-weight:600;font-family:SFMono-Regular, Menlo, Consolas, monospace;white-space:nowrap\">scheduled\u003c/span>\u003cspan style=\"flex:1 1 260px;font-size:12px;color:#6B7280\">A determined date and time are announced, and the status appears in every schedule and game feed.\u003c/span>\u003c/div>\u003c/div>\u003cdiv style=\"padding:8px 18px;border-top:1px solid #E8EAF6;font-size:12px;color:#6B7280;background:#FAFAFA\">Once the game reaches scheduled, it follows the Standard Game flow.\u003c/div>\u003c/div>\n\u003cbr/>\n\u003chr/>\n\u003ch3 class=\"heading heading-3 header-scroll\">\u003cdiv class=\"heading-anchor anchor waypoint\" id=\"delayed\">\u003c/div>\u003cdiv class=\"heading-text\">Delayed\u003c/div>\u003ca aria-label=\"Skip link to Delayed\" class=\"heading-anchor-icon fa fa-regular fa-anchor\" href=\"#delayed\">\u003c/a>\u003c/h3>\n\u003cp>Below is the flow of a \u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">delayed\u003c/code> game.\u003c/p>\n\u003cp>A game can be delayed before it starts or during play. Once a delayed game moves to \u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">inprogress\u003c/code> it follows the \u003ca href=\"https://developer.sportradar.com/basketball/docs/nba-ig-game-status-workflow#standard-game\" target=\"\" title=\"\">Standard Game\u003c/a> flow.\u003c/p>\n\u003cdiv style=\"border:1px solid #C5CAE9;border-radius:12px;overflow:hidden;margin:4px 0 8px\">\u003cdiv style=\"background:linear-gradient(90deg, #1A237E 0%, #283593 60%, #3949AB 100%);color:#FFFFFF;padding:10px 18px;display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:4px 12px\">\u003cspan style=\"font-weight:700;font-size:14px;letter-spacing:0.02em\">Delayed Game\u003c/span>\u003cspan style=\"font-size:12px;opacity:0.8\">a hold before or during play; the game keeps its ID\u003c/span>\u003c/div>\u003cdiv style=\"padding:12px 18px;background:#FFFFFF;display:flex;flex-direction:column;gap:10px\">\u003cdiv style=\"display:flex;flex-wrap:wrap;gap:8px;align-items:center\">\u003cspan style=\"min-width:96px;font-size:12px;color:#6B7280;font-weight:700\">Held up\u003c/span>\u003cspan style=\"display:inline-block;min-width:118px;text-align:center;padding:4px 10px;border-radius:999px;border:1px solid #C5CAE9;background:#F3F6FA;color:#1A237E;font-size:12.5px;font-weight:600;font-family:SFMono-Regular, Menlo, Consolas, monospace;white-space:nowrap\">scheduled\u003c/span>\u003cspan style=\"display:inline-block;min-width:118px;text-align:center;padding:4px 10px;border-radius:999px;border:1px solid #C5CAE9;background:#F3F6FA;color:#1A237E;font-size:12.5px;font-weight:600;font-family:SFMono-Regular, Menlo, Consolas, monospace;white-space:nowrap\">inprogress\u003c/span>\u003cspan style=\"flex:1 1 260px;font-size:12px;color:#6B7280\">A delay can begin before or during a game: the start of a scheduled game is held up, or a game already in progress is interrupted.\u003c/span>\u003c/div>\u003cdiv style=\"display:flex;flex-wrap:wrap;gap:8px;align-items:center\">\u003cspan style=\"min-width:96px;font-size:12px;color:#6B7280;font-weight:700\">On hold\u003c/span>\u003cspan style=\"display:inline-block;min-width:118px;text-align:center;padding:3px 9px;border-radius:999px;border:2px solid #2962FF;background:#FFFFFF;color:#1A237E;font-size:12.5px;font-weight:600;font-family:SFMono-Regular, Menlo, Consolas, monospace;white-space:nowrap\">delayed\u003c/span>\u003cspan style=\"flex:1 1 260px;font-size:12px;color:#6B7280\">The game is delayed. It keeps its game ID and stays on the schedule and game feeds in delayed status; keep polling for the next status change.\u003c/span>\u003c/div>\u003cdiv style=\"display:flex;flex-wrap:wrap;gap:8px;align-items:center\">\u003cspan style=\"min-width:96px;font-size:12px;color:#6B7280;font-weight:700\">Resumed\u003c/span>\u003cspan style=\"display:inline-block;min-width:118px;text-align:center;padding:4px 10px;border-radius:999px;border:1px solid #C5CAE9;background:#F3F6FA;color:#1A237E;font-size:12.5px;font-weight:600;font-family:SFMono-Regular, Menlo, Consolas, monospace;white-space:nowrap\">inprogress\u003c/span>\u003cspan style=\"flex:1 1 260px;font-size:12px;color:#6B7280\">Play begins, or picks up where it left off, under the same game ID, and the game continues through the Standard Game flow.\u003c/span>\u003c/div>\u003cdiv style=\"display:flex;flex-wrap:wrap;gap:8px;align-items:center\">\u003cspan style=\"min-width:96px;font-size:12px;color:#6B7280;font-weight:700\">Not played\u003c/span>\u003cspan style=\"display:inline-block;min-width:118px;text-align:center;padding:4px 10px;border-radius:999px;border:1px solid #B71C1C;background:#B71C1C;color:#FFFFFF;font-size:12.5px;font-weight:700;font-family:SFMono-Regular, Menlo, Consolas, monospace;white-space:nowrap\">postponed\u003c/span>\u003cspan style=\"flex:1 1 260px;font-size:12px;color:#6B7280\">If the game cannot continue that day, it moves to postponed. Once the makeup game is announced, a new game and ID are created and scheduled on the announced makeup date.\u003c/span>\u003c/div>\u003c/div>\u003cdiv style=\"padding:8px 18px;border-top:1px solid #E8EAF6;font-size:12px;color:#6B7280;background:#FAFAFA\">Delayed is a holding status, not an end state: the game returns to inprogress under the same game ID or moves on to postponed.\u003c/div>\u003c/div>\n\u003cbr/>\n\u003chr/>\n\u003ch3 class=\"heading heading-3 header-scroll\">\u003cdiv class=\"heading-anchor anchor waypoint\" id=\"postponed\">\u003c/div>\u003cdiv class=\"heading-text\">Postponed\u003c/div>\u003ca aria-label=\"Skip link to Postponed\" class=\"heading-anchor-icon fa fa-regular fa-anchor\" href=\"#postponed\">\u003c/a>\u003c/h3>\n\u003cp>Below is the flow of a \u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">postponed\u003c/code> game.\u003c/p>\n\u003cp>Once a new game is created in \u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">scheduled\u003c/code> status, it follows the \u003ca href=\"https://developer.sportradar.com/basketball/docs/nba-ig-game-status-workflow#standard-game\" target=\"\" title=\"\">Standard Game\u003c/a> flow.\u003c/p>\n\u003cdiv style=\"border:1px solid #C5CAE9;border-radius:12px;overflow:hidden;margin:4px 0 8px\">\u003cdiv style=\"background:linear-gradient(90deg, #1A237E 0%, #283593 60%, #3949AB 100%);color:#FFFFFF;padding:10px 18px;display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:4px 12px\">\u003cspan style=\"font-weight:700;font-size:14px;letter-spacing:0.02em\">Postponed Game\u003c/span>\u003cspan style=\"font-size:12px;opacity:0.8\">the makeup arrives as a new game ID\u003c/span>\u003c/div>\u003cdiv style=\"padding:12px 18px;background:#FFFFFF;display:flex;flex-direction:column;gap:10px\">\u003cdiv style=\"display:flex;flex-wrap:wrap;gap:8px;align-items:center\">\u003cspan style=\"min-width:96px;font-size:12px;color:#6B7280;font-weight:700\">\u003col>\n\u003cli>On the books\u003c/li>\n\u003c/ol>\u003c/span>\u003cspan style=\"display:inline-block;min-width:118px;text-align:center;padding:4px 10px;border-radius:999px;border:1px solid #C5CAE9;background:#F3F6FA;color:#1A237E;font-size:12.5px;font-weight:600;font-family:SFMono-Regular, Menlo, Consolas, monospace;white-space:nowrap\">scheduled\u003c/span>\u003cspan style=\"flex:1 1 260px;font-size:12px;color:#6B7280\">The game is scheduled to occur, with a determined date and time. Status appears in every schedule and game feed.\u003c/span>\u003c/div>\u003cdiv style=\"display:flex;flex-wrap:wrap;gap:8px;align-items:center\">\u003cspan style=\"min-width:96px;font-size:12px;color:#6B7280;font-weight:700\">\u003col start=\"2\">\n\u003cli>Pushed\u003c/li>\n\u003c/ol>\u003c/span>\u003cspan style=\"display:inline-block;min-width:118px;text-align:center;padding:4px 10px;border-radius:999px;border:1px solid #B71C1C;background:#B71C1C;color:#FFFFFF;font-size:12.5px;font-weight:700;font-family:SFMono-Regular, Menlo, Consolas, monospace;white-space:nowrap\">postponed\u003c/span>\u003cspan style=\"flex:1 1 260px;font-size:12px;color:#6B7280\">The game will be made up at another day and time. Once the makeup game is announced, a new game and ID are created and scheduled on the announced makeup date; request the schedule feeds regularly to identify makeup games.\u003c/span>\u003c/div>\u003cdiv style=\"display:flex;flex-wrap:wrap;gap:8px;align-items:center\">\u003cspan style=\"min-width:96px;font-size:12px;color:#6B7280;font-weight:700\">\u003col start=\"3\">\n\u003cli>Rescheduled\u003c/li>\n\u003c/ol>\u003c/span>\u003cspan style=\"display:inline-block;min-width:118px;text-align:center;padding:4px 10px;border-radius:999px;border:1px solid #C5CAE9;background:#F3F6FA;color:#1A237E;font-size:12.5px;font-weight:600;font-family:SFMono-Regular, Menlo, Consolas, monospace;white-space:nowrap\">scheduled\u003c/span>\u003cspan style=\"flex:1 1 260px;font-size:12px;color:#6B7280\">A new game, with a new game ID, is created in scheduled status when a determined date and time are announced. The postponed and rescheduled game IDs are not linked within the API.\u003c/span>\u003c/div>\u003c/div>\u003cdiv style=\"padding:8px 18px;border-top:1px solid #E8EAF6;font-size:12px;color:#6B7280;background:#FAFAFA\">The original entry keeps the postponed status; the makeup game follows the Standard Game flow under its new ID.\u003c/div>\u003c/div>\n\u003cbr/>\n\u003chr/>\n\u003ch3 class=\"heading heading-3 header-scroll\">\u003cdiv class=\"heading-anchor anchor waypoint\" id=\"cancelled\">\u003c/div>\u003cdiv class=\"heading-text\">Cancelled\u003c/div>\u003ca aria-label=\"Skip link to Cancelled\" class=\"heading-anchor-icon fa fa-regular fa-anchor\" href=\"#cancelled\">\u003c/a>\u003c/h3>\n\u003cp>Below is the flow of a \u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">cancelled\u003c/code> game.\u003c/p>\n\u003cp>A cancelled game will remain in \u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">cancelled\u003c/code> status. See game \u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">5126d64c-1865-4ef6-87ce-e64ec9581e1b\u003c/code> as an example.\u003c/p>\n\u003cdiv style=\"border:1px solid #C5CAE9;border-radius:12px;overflow:hidden;margin:4px 0 8px\">\u003cdiv style=\"background:linear-gradient(90deg, #1A237E 0%, #283593 60%, #3949AB 100%);color:#FFFFFF;padding:10px 18px;display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:4px 12px\">\u003cspan style=\"font-weight:700;font-size:14px;letter-spacing:0.02em\">Cancelled Game\u003c/span>\u003cspan style=\"font-size:12px;opacity:0.8\">a terminal status with no makeup game\u003c/span>\u003c/div>\u003cdiv style=\"padding:12px 18px;background:#FFFFFF;display:flex;flex-direction:column;gap:10px\">\u003cdiv style=\"display:flex;flex-wrap:wrap;gap:8px;align-items:center\">\u003cspan style=\"min-width:96px;font-size:12px;color:#6B7280;font-weight:700\">\u003col>\n\u003cli>On the books\u003c/li>\n\u003c/ol>\u003c/span>\u003cspan style=\"display:inline-block;min-width:118px;text-align:center;padding:4px 10px;border-radius:999px;border:1px solid #C5CAE9;background:#F3F6FA;color:#1A237E;font-size:12.5px;font-weight:600;font-family:SFMono-Regular, Menlo, Consolas, monospace;white-space:nowrap\">scheduled\u003c/span>\u003cspan style=\"flex:1 1 260px;font-size:12px;color:#6B7280\">The game is scheduled to occur, with a determined date and time. Status appears in every schedule and game feed.\u003c/span>\u003c/div>\u003cdiv style=\"display:flex;flex-wrap:wrap;gap:8px;align-items:center\">\u003cspan style=\"min-width:96px;font-size:12px;color:#6B7280;font-weight:700\">\u003col start=\"2\">\n\u003cli>Called off\u003c/li>\n\u003c/ol>\u003c/span>\u003cspan style=\"display:inline-block;min-width:118px;text-align:center;padding:4px 10px;border-radius:999px;border:1px solid #B71C1C;background:#B71C1C;color:#FFFFFF;font-size:12.5px;font-weight:700;font-family:SFMono-Regular, Menlo, Consolas, monospace;white-space:nowrap\">cancelled\u003c/span>\u003cspan style=\"flex:1 1 260px;font-size:12px;color:#6B7280\">The game has been cancelled, and no makeup game will be played.\u003c/span>\u003c/div>\u003c/div>\u003cdiv style=\"padding:8px 18px;border-top:1px solid #E8EAF6;font-size:12px;color:#6B7280;background:#FAFAFA\">Cancelled is terminal: the game remains in cancelled status.\u003c/div>\u003c/div>\n\u003cbr/>\n\u003chr/>\n\u003ch2 class=\"heading heading-2 header-scroll\">\u003cdiv class=\"heading-anchor anchor waypoint\" id=\"game-state-samples\">\u003c/div>\u003cdiv class=\"heading-text\">Game State Samples\u003c/div>\u003ca aria-label=\"Skip link to Game State Samples\" class=\"heading-anchor-icon fa fa-regular fa-anchor\" href=\"#game-state-samples\">\u003c/a>\u003c/h2>\n\u003cp>Click the links below for sample data of Game feeds by game state.\u003c/p>\n\u003cul>\n\u003cli>\u003ca href=\"https://api-docs.sportradar.us/nba/NBA_API_Scheduled_Samples.zip\" target=\"\" title=\"\">scheduled\u003c/a>\u003c/li>\n\u003cli>\u003ca href=\"https://api-docs.sportradar.us/nba/NBA_API_Created_Samples.zip\" target=\"\" title=\"\">created\u003c/a>\u003c/li>\n\u003cli>\u003ca href=\"https://api-docs.sportradar.us/nba/NBA_API_Inprogress_Samples.zip\" target=\"\" title=\"\">inprogress\u003c/a>\u003c/li>\n\u003cli>\u003ca href=\"https://api-docs.sportradar.us/nba/NBA_API_Closed_Samples.zip\" target=\"\" title=\"\">closed\u003c/a>\u003c/li>\n\u003c/ul>\n\u003cdiv class=\"readme-tailwind\">\u003cblockquote class=\"callout callout_default\" theme=\"🏀\">\u003cspan class=\"callout-icon\">🏀\u003c/span>\u003ch3 class=\"heading heading-3 header-scroll\">\u003cdiv class=\"heading-anchor anchor waypoint\" id=\"simulations\">\u003c/div>\u003cdiv class=\"heading-text\">Simulations\u003c/div>\u003ca aria-label=\"Skip link to Simulations\" class=\"heading-anchor-icon fa fa-regular fa-anchor\" href=\"#simulations\">\u003c/a>\u003c/h3>\u003cp>We would also suggest using our \u003cstrong>\u003ca href=\"https://developer.sportradar.com/getting-started/docs/simulations\" target=\"\" title=\"\">Simulations\u003c/a>\u003c/strong> to view each of these game states and test your integration.\u003c/p>\u003c/blockquote>\u003c/div>\n\u003cbr/>\n\u003chr/>\n\u003ch2 class=\"heading heading-2 header-scroll\">\u003cdiv class=\"heading-anchor anchor waypoint\" id=\"weekly-data-entry\">\u003c/div>\u003cdiv class=\"heading-text\">Weekly Data Entry\u003c/div>\u003ca aria-label=\"Skip link to Weekly Data Entry\" class=\"heading-anchor-icon fa fa-regular fa-anchor\" href=\"#weekly-data-entry\">\u003c/a>\u003c/h2>\n\u003cp>This section provides important NBA data update timings for schedules, statistics, rankings, depth charts, and more.\u003c/p>\n\u003cp>The daily data entry workflow is the same every day of the week:\u003c/p>\n\u003cul>\n\u003cli>Final game times set for the day&#x27;s games (10am CT)\u003c/li>\n\u003cli>Game stats validated and moved to \u003ccode class=\"rdmd-code lang- theme-undefined\" data-lang=\"\">closed\u003c/code> status (60 minutes after the game goes final)\u003c/li>\n\u003cli>Rankings updated (60 minutes after the last game goes final)\u003c/li>\n\u003cli>Seasonal stats validation (all day)\u003c/li>\n\u003cli>Injuries (all day)\u003c/li>\n\u003cli>Transactions (all day)\u003c/li>\n\u003c/ul>\n\u003cp>Transactions and injuries are monitored and updated throughout the day, using a combination of official and reliable sources.\u003c/p>\n\u003cbr/>\n\u003ch3 class=\"heading heading-3 header-scroll\">\u003cdiv class=\"heading-anchor anchor waypoint\" id=\"important-dates\">\u003c/div>\u003cdiv class=\"heading-text\">Important Dates\u003c/div>\u003ca aria-label=\"Skip link to Important Dates\" class=\"heading-anchor-icon fa fa-regular fa-anchor\" href=\"#important-dates\">\u003c/a>\u003c/h3>\n\u003cp>The NBA schedule becomes available in mid-August. Game times and dates are initially validated two weeks before the game and confirmed on the day of the game.\u003c/p>","css":"/*! tailwindcss v4.1.17 | MIT License | https://tailwindcss.com */\n@layer theme, base, components, utilities;\n@layer utilities;\n"},"opts":{"hardBreaks":true,"alwaysThrow":false,"compatibilityMode":false,"copyButtons":true,"correctnewlines":false,"markdownOptions":{"fences":true,"commonmark":true,"gfm":true,"ruleSpaces":false,"listItemIndent":"1","spacedTable":true,"paddedTable":true},"normalize":true,"lazyImages":true,"reusableContent":{"tags":{},"disabled":false,"serialize":true,"wrap":true},"safeMode":false,"settings":{"position":true},"theme":"light","customBlocks":{"NBACoverageLevels":"## Coverage Levels\n\nWe provide two different levels of detail to ensure maximum coverage. We combine coverage levels with the correct feeds to ensure you are getting the most comprehensive data offering in the most efficient manner possible. Full coverage is available for all regular and postseason games. Most preseason games will also have full coverage, though in some rare cases extended boxscore may be used.\n\n\u003cb>Full\u003c/b> – We provide live play-by-play coverage for the entire game. We provide updated scores and time remaining as well as team- and player-level data in near real time.\n\n\u003cb>Extended Boxscore\u003c/b> – We provide scores, time remaining, and team leaders (assists, points, and rebounds), in a timely manner, as the game progresses. We provide team- and player-level data for the game within 30 minutes of the official results being posted.\n\n\u003cCallout icon=\"🏀\" theme=\"default\">\n  ### Preseason Coverage Note:\n\n  Preseason coverage of NBA games may vary. Some games may be **extended boxscore** coverage due to on-venue data-entry being unavailable.\n\n  API data latency will vary compared to regular season games, due to collection and processing differences. Preseason games serve as a testing ground, often resulting in changes and adjustments to data collection methods. As a result, data updates may not be as timely or consistent as the regular season.\n\u003c/Callout>","NBAGameStatusDefinitions":"* `scheduled` - The game is scheduled to occur.\n* `created` – The game has been created and we have begun logging information.\n* `inprogress` – The game is in progress.\n* `halftime` - The game is currently at halftime.\n* `complete` – The game is over, but stat validation is not complete.\n* `closed` – The game is over and the stats have been validated.\n* `cancelled` – The game has been cancelled. No makeup game will be played as a result.\n* `delayed` – The start of the game is currently delayed or the game has gone from in progress to delayed for some reason.\n* `postponed` – The game has been postponed, to be made up at another day and time. Once the makeup game is announced, a new game and ID will be created and scheduled on the announced makeup date. \n* `time-tbd` – The game has been scheduled, but a time has yet to be announced.\n* `if-necessary` – The game will be scheduled if it is required.\n* `unnecessary` – The series game was scheduled to occur, but will not take place due to one team clinching the series early."},"componentTypes":{"NBACoverageLevels":"content","NBAGameStatusDefinitions":"content"},"resourceID":"/branches/8/guides/nba-ig-game-status-workflow","resourceType":"page","components":{"NBACoverageLevels":"## Coverage Levels\n\nWe provide two different levels of detail to ensure maximum coverage. We combine coverage levels with the correct feeds to ensure you are getting the most comprehensive data offering in the most efficient manner possible. Full coverage is available for all regular and postseason games. Most preseason games will also have full coverage, though in some rare cases extended boxscore may be used.\n\n\u003cb>Full\u003c/b> – We provide live play-by-play coverage for the entire game. We provide updated scores and time remaining as well as team- and player-level data in near real time.\n\n\u003cb>Extended Boxscore\u003c/b> – We provide scores, time remaining, and team leaders (assists, points, and rebounds), in a timely manner, as the game progresses. We provide team- and player-level data for the game within 30 minutes of the official results being posted.\n\n\u003cCallout icon=\"🏀\" theme=\"default\">\n  ### Preseason Coverage Note:\n\n  Preseason coverage of NBA games may vary. Some games may be **extended boxscore** coverage due to on-venue data-entry being unavailable.\n\n  API data latency will vary compared to regular season games, due to collection and processing differences. Preseason games serve as a testing ground, often resulting in changes and adjustments to data collection methods. As a result, data updates may not be as timely or consistent as the regular season.\n\u003c/Callout>","NBAGameStatusDefinitions":"* `scheduled` - The game is scheduled to occur.\n* `created` – The game has been created and we have begun logging information.\n* `inprogress` – The game is in progress.\n* `halftime` - The game is currently at halftime.\n* `complete` – The game is over, but stat validation is not complete.\n* `closed` – The game is over and the stats have been validated.\n* `cancelled` – The game has been cancelled. No makeup game will be played as a result.\n* `delayed` – The start of the game is currently delayed or the game has gone from in progress to delayed for some reason.\n* `postponed` – The game has been postponed, to be made up at another day and time. Once the makeup game is announced, a new game and ID will be created and scheduled on the announced makeup date. \n* `time-tbd` – The game has been scheduled, but a time has yet to be announced.\n* `if-necessary` – The game will be scheduled if it is required.\n* `unnecessary` – The series game was scheduled to occur, but will not take place due to one team clinching the series early."},"baseUrl":"/basketball","terms":[{"_id":"65e71b1221b9b7001fe37191","term":"Quad 1","definition":"Home games vs. RPI teams ranked in the top 30; neutral games vs. 1-50; away games vs. 1-75."},{"_id":"65e71b2a21b9b7001fe37194","term":"Quad 2","definition":"Home vs. 31-75 teams; neutral vs. 51-100; away vs. 76-135."},{"_id":"65e71b39d336bd0f86df4881","term":"Quad 3","definition":"Home vs. 76-160 teams; neutral vs. 101-200; away vs. 136-240."},{"_id":"65e71b46e0733e007e48f910","term":"Quad 4","definition":"Home vs. 161-plus teams; neutral vs. 201-plus; away vs. 241-plus."},{"_id":"66563e6a66d6fb000fd5fccc","term":"RESTful","definition":"An architectural style for an application programming interface (API) that uses HTTP requests to access and use data."},{"_id":"667d7697fed2aa002443acee","term":"General Sport API","definition":"The General Sport APIs provide a breadth of coverage across numerous leagues worldwide. All General Sport APIs follow a consistent structure and format between sports, making it easy to consume the data across different leagues or competitions."},{"_id":"66df15b4a637880061088401","term":"GraphQL","definition":"Click [here](https://graphql.org/learn/) to learn more about GraphQL!"},{"_id":"67a0f8eeeed30a00304bafeb","term":"Rolling Quota","definition":"Our rolling 30-day schedule means calls from 31 days prior are removed from your quota each day.\n\nFor example, a rolling 30-day period at the end of a month could include requests from the 1st to the 30th. The following day would take requests made from the 2nd to the 31st."},{"term":"Quad 1","definition":"Home games vs. RPI teams ranked in the top 30; neutral games vs. 1-50; away games vs. 1-75.","_id":"692497cca2be85c6ca237f5b"},{"term":"Quad 2","definition":"Home vs. 31-75 teams; neutral vs. 51-100; away vs. 76-135.","_id":"692497cca2be85c6ca237f5c"},{"term":"Quad 3","definition":"Home vs. 76-160 teams; neutral vs. 101-200; away vs. 136-240.","_id":"692497cca2be85c6ca237f5d"},{"term":"Quad 4","definition":"Home vs. 161-plus teams; neutral vs. 201-plus; away vs. 241-plus.","_id":"692497cca2be85c6ca237f5e"},{"term":"RESTful","definition":"An architectural style for an application programming interface (API) that uses HTTP requests to access and use data.","_id":"692497cca2be85c6ca237f5f"},{"term":"General Sport API","definition":"The General Sport APIs provide a breadth of coverage across numerous leagues worldwide. All General Sport APIs follow a consistent structure and format between sports, making it easy to consume the data across different leagues or competitions.","_id":"692497cca2be85c6ca237f60"},{"term":"GraphQL","definition":"Click [here](https://graphql.org/learn/) to learn more about GraphQL!","_id":"692497cca2be85c6ca237f61"},{"term":"Rolling Quota","definition":"Our rolling 30-day schedule means calls from 31 days prior are removed from your quota each day.\n\nFor example, a rolling 30-day period at the end of a month could include requests from the 1st to the 30th. The following day would take requests made from the 2nd to the 31st.","_id":"692497cca2be85c6ca237f62"},{"term":"Elam Ending","definition":"The game clock is turned off for the final \"Elam\" period. A target score is established based on the leading team’s current score plus a fixed value. The first team to reach the target score on a made basket wins.","_id":"692497cca2be85c6ca237f63"},{"term":"Quad 1","definition":"Home games vs. RPI teams ranked in the top 30; neutral games vs. 1-50; away games vs. 1-75.","_id":"692497cca2be85c6ca237f64"},{"term":"Quad 2","definition":"Home vs. 31-75 teams; neutral vs. 51-100; away vs. 76-135.","_id":"692497cca2be85c6ca237f65"},{"term":"Quad 3","definition":"Home vs. 76-160 teams; neutral vs. 101-200; away vs. 136-240.","_id":"692497cca2be85c6ca237f66"},{"term":"Quad 4","definition":"Home vs. 161-plus teams; neutral vs. 201-plus; away vs. 241-plus.","_id":"692497cca2be85c6ca237f67"},{"term":"RESTful","definition":"An architectural style for an application programming interface (API) that uses HTTP requests to access and use data.","_id":"692497cca2be85c6ca237f68"},{"term":"General Sport API","definition":"The General Sport APIs provide a breadth of coverage across numerous leagues worldwide. All General Sport APIs follow a consistent structure and format between sports, making it easy to consume the data across different leagues or competitions.","_id":"692497cca2be85c6ca237f69"},{"term":"GraphQL","definition":"Click [here](https://graphql.org/learn/) to learn more about GraphQL!","_id":"692497cca2be85c6ca237f6a"},{"term":"Rolling Quota","definition":"Our rolling 30-day schedule means calls from 31 days prior are removed from your quota each day.\n\nFor example, a rolling 30-day period at the end of a month could include requests from the 1st to the 30th. The following day would take requests made from the 2nd to the 31st.","_id":"692497cca2be85c6ca237f6b"},{"term":"marquee","definition":"A big, spotlighted event that is meant to draw attention and generate excitement.","_id":"692497cca2be85c6ca237f6c"},{"term":"Quad 1","definition":"Home games vs. RPI teams ranked in the top 30; neutral games vs. 1-50; away games vs. 1-75.","_id":"692497cca2be85c6ca237f6d"},{"term":"Quad 2","definition":"Home vs. 31-75 teams; neutral vs. 51-100; away vs. 76-135.","_id":"692497cca2be85c6ca237f6e"},{"term":"Quad 3","definition":"Home vs. 76-160 teams; neutral vs. 101-200; away vs. 136-240.","_id":"692497cca2be85c6ca237f6f"},{"term":"Quad 4","definition":"Home vs. 161-plus teams; neutral vs. 201-plus; away vs. 241-plus.","_id":"692497cca2be85c6ca237f70"},{"term":"RESTful","definition":"An architectural style for an application programming interface (API) that uses HTTP requests to access and use data.","_id":"692497cca2be85c6ca237f71"},{"term":"General Sport API","definition":"The General Sport APIs provide a breadth of coverage across numerous leagues worldwide. All General Sport APIs follow a consistent structure and format between sports, making it easy to consume the data across different leagues or competitions.","_id":"692497cca2be85c6ca237f72"},{"term":"GraphQL","definition":"Click [here](https://graphql.org/learn/) to learn more about GraphQL!","_id":"692497cca2be85c6ca237f73"},{"term":"Rolling Quota","definition":"Our rolling 30-day schedule means calls from 31 days prior are removed from your quota each day.\n\nFor example, a rolling 30-day period at the end of a month could include requests from the 1st to the 30th. The following day would take requests made from the 2nd to the 31st.","_id":"692497cca2be85c6ca237f74"},{"term":"GUID","definition":"Global Unique Identifier","_id":"692497cca2be85c6ca237f75"}],"variables":{"user":{},"defaults":[{"name":"x-api-key","source":"security","type":"apiKey","_id":"692496faad25b92dd30fbffd"}]}}},"sidebar":[{"pages":[{"deprecated":false,"hidden":false,"isBodyEmpty":false,"renderable":{"status":true},"slug":"nba-ig-overview","title":"Overview","type":"basic","updatedAt":"2026-09-08T15:44:38.000Z","pages":[],"category":"/branches/8/categories/guides/NBA%20Integration%20Guide","uri":"/branches/8/guides/nba-ig-overview","parent":null},{"deprecated":false,"hidden":false,"isBodyEmpty":false,"renderable":{"status":true},"slug":"nba-ig-api-