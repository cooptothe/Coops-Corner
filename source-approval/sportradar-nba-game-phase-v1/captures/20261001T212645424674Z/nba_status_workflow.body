adar_sr.png","64f1ea667dfe5f005111f49b"],"tocVariant":"line","stylesheet":"","stylesheet_hub2":"header .Button_secondary_text:not(:disabled):not(.Button_secondary_text.Button_disabled):hover, .Button_secondary_text:not(:disabled):not(.Button_secondary_text.Button_disabled)[aria-expanded=true] {\n    background: none;\n    color: white !important;\n}\n\n/* Sticky Header */\n/* Make the header sticky */\n.rm-Header {\n    position: sticky !important;\n    top: 0 !important;\n    z-index: 100;\n}\n\n.rm-VersionDropdown {\n    display: block ! Important;\n}\n\n/* Left Nav Scroll Fix */\n.reference-redesign.Nav3C5f8FcjkaHj {\n    max-height: 80vh !important;\n    overflow-y: auto;\n    padding-bottom: 2vh;\n}\n\n/* Right Side Ref Section - need space up top */\n.rm-Playground {\n    margin-top: 20px;\n}\n\n/* Hide \"Docs\" dropdown (could use JS but causes issuess?) */\n.rm-Header-bottom>div>nav>div:nth-child(2),\n#ssr-main>div>header>div.Header-bottom2eLKOFXMEmh5.rm-Header-bottom>div>nav>div:nth-child(2),\n#ssr-main>div>header>div.Header-bottom2eLKOFXMEmh5.rm-Header-bottom>div>nav>div:nth-child(3) {\n    display: none;\n}\n\n/* browser will scroll down by 100px from the top for anchors*/\ndiv,\na {\n    scroll-margin-top: 100px !important;\n}\n\n.footer-links a:hover {\n    text-decoration: underline !important;\n}\n\n.field-description a[href],\n.field-description a:not([href='']),\n.markdown-body a[href],\n.markdown-body a:not([href='']) {\n    text-decoration: none;\n}\n\n/* Adjust the position of the TOC to account for the sticky header */\n.content-toc {\n    position: sticky !important;\n    top: 91px !important;\n}\n\n.rm-Sidebar {\n    top: 121px !important;\n}\n\n/* ==========================================================\n   SPORTRADAR README PROJECT PICKER — CUSTOM CSS\n   Rewritten 2026-09-10.\n\n   Scoping rules — please keep to these:\n\n   1. Scope ONLY on `.rm-ProjectPicker-menu`. That is a stable class\n      ReadMe commits to. The previous version was scoped on\n      `.Box2uBHSWG8DzPz.Box_pop1YKwQaFwZu8z`, which are webpack\n      CSS-module hashes that ReadMe regenerates whenever that\n      component changes. The menu now ships as\n      `class=\"Box Menu Menu_light rm-ProjectPicker-menu\"` — the\n      hashes are gone, which is why every rule here stopped matching.\n      Never reintroduce a hashed class name.\n\n   2. Select items by `[href^=\"/\u003csubdomain>/\"]`, never by\n      `:nth-child()`. The picker re-indexes whenever a project is\n      added, removed, renamed or reordered in the dash, which\n      scrambled the whole grid.\n\n   To add a sport: add its href to the \"sport tiles\" selector list,\n   give it a grid position in the row block, and add its icon URL.\n   ========================================================== */\n\n/* ---------- WIDE LAYOUT (>= 1100px): 1 service rail + 6-col sport grid ---------- */\n@media screen and (min-width: 1100px) {\n\n  .rm-ProjectPicker-menu {\n    display: grid !important;\n    grid-template-columns: 280px repeat(6, calc((1100px - 280px) / 6)) !important;\n    grid-template-rows: repeat(28, 9px) !important;\n    width: 1100px !important;\n    min-width: 1100px !important;\n    max-width: 1100px !important;\n    height: 252px !important;\n    max-height: 252px !important;\n    overflow: hidden !important;\n    padding: 0 !important;\n    column-count: unset !important;\n    background: #eceff1 !important;\n    align-items: stretch !important;\n    gap: 0 !important;\n  }\n\n  .rm-ProjectPicker-menu a.Menu-Item {\n    box-sizing: border-box !important;\n    line-height: 1.3 !important;\n    max-height: none !important;\n    text-align: left !important;\n    font-family: Source Sans Pro, sans-serif !important;\n    width: auto !important;\n    display: flex !important;\n    align-items: center !important;\n    overflow: hidden !important;\n\n    /* Strip ReadMe's own per-item chrome so tiles sit flush in their grid\n       cell and read as one table. ReadMe's Menu-Item now ships with a\n       margin, a corner radius and a border on all four sides; without\n       these resets every tile is inset inside its cell and looks shrunken.\n       The rules below re-add only the borders this layout wants. */\n    margin: 0 !important;\n    border: none !important;\n    border-radius: 0 !important;\n    box-shadow: none !important;\n    min-height: 0 !important;\n    min-width: 0 !important;\n    height: auto !important;\n    outline: none !important;\n  }\n\n  /* ---------- Service rail (grid column 1) ---------- */\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-getting-started/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-api/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-odds/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-images-content/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-insights/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-widgets/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-broadcast/\"] {\n    grid-column: 1 !important;\n    background: #eceff1 !important;\n    border-bottom: 1px solid #fff !important;\n    border-right: 1px solid #ddd !important;\n    text-transform: uppercase !important;\n    font-size: 11.5px !important;\n    font-weight: 700 !important;\n    color: #1a237e !important;\n    padding: 0 14px !important;\n    letter-spacing: 0.02em !important;\n    transition: background 0.15s, color 0.15s !important;\n    white-space: nowrap !important;\n    align-self: stretch !important;\n  }\n\n  /* Service rail order, top to bottom */\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-getting-started/\"] { grid-row: 1 / span 4 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-api/\"]             { grid-row: 5 / span 4 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-odds/\"]            { grid-row: 9 / span 4 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-images-content/\"]  { grid-row: 13 / span 4 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-insights/\"]        { grid-row: 17 / span 4 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-widgets/\"]         { grid-row: 21 / span 4 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-broadcast/\"]       { grid-row: 25 / span 4 !important; }\n\n  /* Service rail hover (every rail item except SPORTS API, which is a static header) */\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-getting-started/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-odds/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-images-content/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-insights/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-widgets/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-broadcast/\"]:hover {\n    background: #ff0000 !important;\n    color: #fff !important;\n  }\n\n  /* SPORTS API — the label for the sport grid to its right, not a link */\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-api/\"] {\n    background: #1a237e !important;\n    color: #fff !important;\n    border-bottom: 1px solid #283593 !important;\n    border-right: 1px solid #283593 !important;\n    pointer-events: none !important;\n    position: relative !important;\n  }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-api/\"]::after {\n    content: '' !important;\n    position: absolute !important;\n    right: -8px !important;\n    top: 50% !important;\n    transform: translateY(-50%) !important;\n    border: 8px solid transparent !important;\n    border-left-color: #1a237e !important;\n    z-index: 10 !important;\n  }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-api/\"]::before {\n    content: '\\25B6' !important;\n    position: absolute !important;\n    right: 10px !important;\n    top: 50% !important;\n    transform: translateY(-50%) !important;\n    font-size: 14px !important;\n    color: rgba(255, 255, 255, 0.7) !important;\n    pointer-events: none !important;\n    /* override the sport-tile icon box below */\n    width: auto !important;\n    min-width: 0 !important;\n    height: auto !important;\n    margin-right: 0 !important;\n    background-image: none !important;\n    display: inline !important;\n  }\n\n  /* ---------- Sport tiles (grid columns 2-7) ---------- */\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-soccer/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-basketball/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-football/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-baseball/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-hockey/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-cricket/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-racing/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-tennis/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-golf/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-mma/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-rugby/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-handball/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-aussie-football/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-badminton/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-bandy/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-darts/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-field-hockey/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-futsal/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-snooker/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-squash/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-table-tennis/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-volleyball/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-baseline/\"] {\n    background: #fafafa !important;\n    color: #283593 !important;\n    font-size: 12px !important;\n    font-weight: 400 !important;\n    text-transform: none !important;\n    padding: 0 8px !important;\n    justify-content: flex-start !important;\n    border-bottom: 0.5px solid #eeeeee !important;\n    border-right: 0.5px solid #e0e0e0 !important;\n    border-top: none !important;\n    letter-spacing: 0 !important;\n    transition: background 0.12s, color 0.12s !important;\n    white-space: nowrap !important;\n    text-overflow: ellipsis !important;\n    align-self: stretch !important;\n    gap: 6px !important;\n  }\n\n  /* Sport grid row 1 */\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-soccer/\"]          { grid-column: 2 !important; grid-row: 1 / span 7 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-basketball/\"]      { grid-column: 3 !important; grid-row: 1 / span 7 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-football/\"]        { grid-column: 4 !important; grid-row: 1 / span 7 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-baseball/\"]        { grid-column: 5 !important; grid-row: 1 / span 7 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-hockey/\"]          { grid-column: 6 !important; grid-row: 1 / span 7 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-cricket/\"]         { grid-column: 7 !important; grid-row: 1 / span 7 !important; }\n  /* Sport grid row 2 */\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-racing/\"]          { grid-column: 2 !important; grid-row: 8 / span 7 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-tennis/\"]          { grid-column: 3 !important; grid-row: 8 / span 7 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-golf/\"]            { grid-column: 4 !important; grid-row: 8 / span 7 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-mma/\"]             { grid-column: 5 !important; grid-row: 8 / span 7 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-rugby/\"]           { grid-column: 6 !important; grid-row: 8 / span 7 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-handball/\"]        { grid-column: 7 !important; grid-row: 8 / span 7 !important; }\n  /* Sport grid row 3 */\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-aussie-football/\"] { grid-column: 2 !important; grid-row: 15 / span 7 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-badminton/\"]       { grid-column: 3 !important; grid-row: 15 / span 7 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-bandy/\"]           { grid-column: 4 !important; grid-row: 15 / span 7 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-darts/\"]           { grid-column: 5 !important; grid-row: 15 / span 7 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-field-hockey/\"]    { grid-column: 6 !important; grid-row: 15 / span 7 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-futsal/\"]          { grid-column: 7 !important; grid-row: 15 / span 7 !important; }\n  /* Sport grid row 4 */\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-snooker/\"]         { grid-column: 2 !important; grid-row: 22 / span 7 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-squash/\"]          { grid-column: 3 !important; grid-row: 22 / span 7 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-table-tennis/\"]    { grid-column: 4 !important; grid-row: 22 / span 7 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-volleyball/\"]      { grid-column: 5 !important; grid-row: 22 / span 7 !important; }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-baseline/\"]        { grid-column: 6 / span 2 !important; grid-row: 22 / span 7 !important; }\n\n  /* Heavy top border on the sport grid's first row */\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-soccer/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-basketball/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-football/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-baseball/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-hockey/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-cricket/\"] {\n    border-top: 2px solid #1a237e !important;\n  }\n\n  /* Last tile in each sport row loses its right border */\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-cricket/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-handball/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-futsal/\"],\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-baseline/\"] {\n    border-right: none !important;\n  }\n\n  /* Sport tile hover */\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-soccer/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-basketball/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-football/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-baseball/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-hockey/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-cricket/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-racing/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-tennis/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-golf/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-mma/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-rugby/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-handball/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-aussie-football/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-badminton/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-bandy/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-darts/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-field-hockey/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-futsal/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-snooker/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-squash/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-table-tennis/\"]:hover,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-volleyball/\"]:hover {\n    background: #e8eaf6 !important;\n    color: #1a237e !important;\n  }\n\n  /* \"More Sports\" reads as a soft catch-all */\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-baseline/\"] {\n    font-style: italic !important;\n    color: #5c6bc0 !important;\n  }\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-baseline/\"]:hover {\n    background: #e8eaf6 !important;\n    color: #3949ab !important;\n  }\n\n  /* ---------- Sport icons ---------- */\n  /* The icon box. Each sport supplies its own background-image below. */\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-soccer/\"]::before,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-basketball/\"]::before,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-football/\"]::before,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-baseball/\"]::before,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-hockey/\"]::before,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-cricket/\"]::before,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-racing/\"]::before,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-tennis/\"]::before,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-golf/\"]::before,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-mma/\"]::before,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-rugby/\"]::before,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-handball/\"]::before,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-aussie-football/\"]::before,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-badminton/\"]::before,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-bandy/\"]::before,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-darts/\"]::before,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-field-hockey/\"]::before,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-futsal/\"]::before,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-snooker/\"]::before,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-squash/\"]::before,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-table-tennis/\"]::before,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-volleyball/\"]::before,\n  .rm-ProjectPicker-menu a.Menu-Item[href^=\"/sportradar-baseline/\"]::before {\n    content: '' !important;\n    display: inline-block !important;\n    width: 16px !important;\n    min-width: 16px !important;\n    height: 16px !important;\n    margin-right: 8px !important;\n    background-size: contain !important;\n    background-repeat: no-repeat !important;\n    background-position: center !important;\n    flex-shrink: 0 !important;\n  }\n\n  .rm-ProjectPicker-menu a[href^=\"/sportradar-soccer/\"]::before          { background-image: url('https://files.readme.io/c78b3db-Soccer_futbal.svg') !important; }\n  .rm-ProjectPicker-menu a[href^=\"/sportradar-basketball/\"]::before      { background-image: url('https://files.readme.io/512a44d-Basketball.svg') !important; }\n  .rm-ProjectPicker-menu a[href^=\"/sportradar-football/\"]::before        { background-image: url('https://files.readme.io/76aad18-Football_american.svg') !important; }\n  .rm-ProjectPicker-menu a[href^=\"/sportradar-baseball/\"]::before        { background-image: url('https://files.readme.io/7d795d0-baseball_pesapallo.svg') !important; }\n  .rm-ProjectPicker-menu a[href^=\"/sportradar-hockey/\"]::before          { background-image: url('https://files.readme.io/64c609d-Ice_Hockey_puck.svg') !important; }\n  .rm-ProjectPicker-menu a[href^=\"/sportradar-cricket/\"]::before         { background-image: url('https://files.readme.io/e89c1b7-Cricket.svg') !important; }\n  .rm-ProjectPicker-menu a[href^=\"/sportradar-racing/\"]::before          { background-image: url('https://files.readme.io/f3c38af0e6f68eedddfa14ee231580e1fe39493c27bd1880bfcd2da6dc9d6293-Motorsport.png') !important; }\n  .rm-ProjectPicker-menu a[href^=\"/sportradar-tennis/\"]::before          { background-image: url('https://files.readme.io/8ee9958-Tennis.svg') !important; }\n  .rm-ProjectPicker-menu a[href^=\"/sportradar-golf/\"]::before            { background-image: url('https://files.readme.io/6941ae5-Golf.svg') !important; }\n  .rm-ProjectPicker-menu a[href^=\"/sportradar-mma/\"]::before             { background-image: url('https://files.readme.io/9c0eca8-MMA_mixed_martial_arts_UFC_WWE_fight_combat.svg') !important; }\n  .rm-ProjectPicker-menu a[href^=\"/sportradar-rugby/\"]::before           { background-image: url('https://files.readme.io/a70b849-Rugby_Aussie_Rules.svg') !important; }\n  .rm-ProjectPicker-menu a[href^=\"/sportradar-handball/\"]::before        { background-image: url('https://files.readme.io/b3d952f-Handball.svg') !important; }\n  .rm-ProjectPicker-menu a[href^=\"/sportradar-aussie-football/\"]::before { background-image: url('https://files.readme.io/7adc875-Rugby_Aussie_Rules.svg') !important; }\n  .rm-ProjectPicker-menu a[href^=\"/sportradar-badminton/\"]::before       { background-image: url('https://files.readme.io/0888c84-Badminton_birdie.svg') !important; }\n  .rm-ProjectPicker-menu a[href^=\"/sportradar-bandy/\"]::before           { background-image: url('https://files.readme.io/e08d560-Bandy_Stick.svg') !important; }\n  .rm-ProjectPicker-menu a[href^=\"/sportradar-darts/\"]::before           { background-image: url('https://files.readme.io/390cd3b-Darts_target.svg') !important; }\n  .rm-ProjectPicker-menu a[href^=\"/sportradar-field-hockey/\"]::before    { background-image: url('https://files.readme.io/7479e94-Field_Hockey.svg') !important; }\n  .rm-ProjectPicker-menu a[href^=\"/sportradar-futsal/\"]::before          { background-image: url('https://files.readme.io/0db4cff-Futsal.svg') !important; }\n  .rm-ProjectPicker-menu a[href^=\"/sportradar-snooker/\"]::before         { background-image: url('https://files.readme.io/4e537d4-Snooker_Billiards_pool.svg') !important; }\n  .rm-ProjectPicker-menu a[href^=\"/sportradar-squash/\"]::before          { background-image: url('https://files.readme.io/58ff631-Squash_tennis_racket.svg') !important; }\n  .rm-ProjectPicker-menu a[href^=\"/sportradar-table-tennis/\"]::before    { background-image: url('https://files.readme.io/954dfa4-Table_tennis_ping_pong_paddle_racket.svg') !important; }\n  .rm-ProjectPicker-menu a[href^=\"/sportradar-volleyball/\"]::before      { background-image: url('https://files.readme.io/d5f6552-Volleyball_beach_water.svg') !important; }\n  .rm-ProjectPicker-menu a[href^=\"/sportradar-baseline/\"]::before        { background-image: url('https://files.readme.io/5782de5a675dc8cdff56ee7c72cba94f3d99117b3904334353eccb5c0fcd08dc-Arrow_Bullet.png') !important; }\n\n  /* Legacy hook: inline \u003cimg class=\"sr-sport-icon\"> if any item ever carries one */\n  .rm-ProjectPicker-menu a.Menu-Item img.sr-sport-icon {\n    width: 16px !important;\n    height: 16px !important;\n    object-fit: contain !important;\n    opacity: 1 !important;\n    flex-shrink: 0 !important;\n  }\n}\n\n/* ---------- NARROW LAYOUT (\u003c 1100px): plain single-column list ----------\n   This block used to be nested inside the min-width:1100px query above, so\n   it could never match and the dropdown had no styling at all on small\n   screens. Keep it at the top level.                                      */\n@media screen and (max-width: 1099px) {\n  .rm-ProjectPicker-menu {\n    display: flex !important;\n    flex-direction: column !important;\n    width: auto !important;\n    min-width: 200px !important;\n    max-width: 320px !important;\n    height: auto !important;\n    max-height: 70vh !important;\n    overflow-y: auto !important;\n    overflow-x: hidden !important;\n    grid-template-columns: unset !important;\n    grid-template-rows: unset !important;\n    padding: 4px 0 !important;\n    background: #fff !important;\n  }\n  .rm-ProjectPicker-menu a.Menu-Item {\n    grid-column: unset !important;\n    grid-row: unset !important;\n    width: 100% !important;\n    background: #fff !important;\n    color: #1a237e !important;\n    font-size: 13px !important;\n    font-weight: 600 !important;\n    padding: 8px 16px !important;\n    margin: 0 !important;\n    border: none !important;\n    border-bottom: 0.5px solid #f0f0f0 !important;\n    border-radius: 0 !important;\n    box-shadow: none !important;\n    /* min-height:0 drops ReadMe's 36px floor so row height is just text +\n       padding; flex:0 0 auto stops the rows compressing to nothing when\n       something constrains the container's height. Both are needed. */\n    min-height: 0 !important;\n    flex: 0 0 auto !important;\n    text-transform: none !important;\n    white-space: nowrap !important;\n    display: flex !important;\n    align-items: center !important;\n    order: unset !important;\n    position: static !important;\n    pointer-events: auto !important;\n  }\n  .rm-ProjectPicker-menu a.Menu-Item:hover {\n    background: #e8eaf6 !important;\n    color: #1a237e !important;\n  }\n  .rm-ProjectPicker-menu a.Menu-Item::after,\n  .rm-ProjectPicker-menu a.Menu-Item::before {\n    display: none !important;\n  }\n}\n\n/* ---------- Projects hidden from the picker at every width ---------- */\n.rm-ProjectPicker-menu a[href*=\"sportradar-additional\"],\n.rm-ProjectPicker-menu a[href*=\"sportradar-thirdparty\"],\n.rm-ProjectPicker-menu a[href*=\"testbasketball\"],\n.rm-ProjectPicker-menu a[href*=\"sportradar-updates\"] {\n  display: none !important;\n}\n\n/*API Reference Pages - move all custom markdown BELOW body params, etc. */\n.rm-ReferenceMain .rm-Article {\n    display: flex;\n    flex-direction: column;\n}\n\n.rm-ParamContainer {\n    order: 1;\n}\n\n.rm-ReferenceMain .rm-Article .rm-APISectionHeader {\n    order: 3;\n}\n\n[class^=\"APIResponseSchemaPicker\"] {\n    order: 6;\n}\n\n\n.field-description,\n.markdown-body {\n    order: 7;\n    display: flow-root;\n}\n\nheader.APISectionHeader3LN_-QIR0m7x.rm-APISectionHeader {\n    order: 7;\n}\n\n.rm-ReferenceMain .markdown-body {\n    margin-top: 10px\n}\n\n[class^=\"Footer-desktop\"] {\n    order: 8;\n}\n\n/*Hide left mobile nav items*/\n.Header-left-nav2xWPWMNHOGf_ {\n    display: none !important;\n    right: 0px;\n}\n\n.VersionBadge_green3W-ZN3BtOcAO {\n    display: none !important;\n}\n\n/*Hide Request History Section*/\n.rm-ReferenceMain article .Reference-section {\n    display: none;\n}\n\ndiv[class^=\"MobileFlyout\"] a[class^=\"NavItem-item\"]:nth-child(n+2):nth-child(-n+6) {\n    display: none;\n}\n\ndiv[class^=\"MobileFlyout\"] {\n    right: 0px;\n}\n\n\n.Header3zzata9F_ZPQ {\n    background-color: #283593;\n    position: fixed;\n}\n\n.rm-Header-top {\n    background-color: #283593;\n    height: 56px;\n    align-items: center;\n    font-size: 1rem;\n    border-bottom: none;\n}\n\n.Header-topuTMpygDG4e1V,\n.rm-Header-top,\n.Header3zzata9F_ZPQ.rm-Header {\n    height: 56px;\n}\n\n.rm-Header-bottom {\n    font-size: .9rem;\n    background-color: #283593;\n    /*padding-bottom:.2rem;*/\n}\n\n.Header-right21PC2XTT6aMg {\n    display: flex;\n}\n\n.Flyout95xhYIIoTKtc {\n    right: 0;\n    left: auto;\n    -webkit-animation: none;\n}\n\n\n.Flyout95xhYIIoTKtc.Flyout_opened3uIGGx28QgO7.rm-Flyout {\n    right: 0;\n    left: auto;\n    -webkit-animation: none;\n}\n\n.footer.container>* {\n    justify-content: center;\n    max-width: 1440px !important;\n    padding-left: 2rem !important;\n    padding-right: 2rem !important;\n    display: flex;\n    padding-top: .75rem !important;\n    padding-bottom: .75rem !important;\n    margin-left: auto !important;\n    margin-right: auto !important;\n}\n\n/*hide staging preview*/\n.Header-staging2fhBvH-z5mvq.Banner2qY-Hhfqm_Gx.Banner_secondary1reFai47T0j4.Banner_smUPcJRlth4_Dl.Banner_fixeda1mFpjcc1TJ6 {\n    display: none;\n}\n\n.App {\n    font-family: Source Sans Pro !important;\n    text-rendering: geometricPrecision;\n}\n\n/*targets fonts in body*/\nh1,\nh2,\na:not(.fa),\np,\n.toc-list,\n.Sidebar-item23D-2Kd61_k3 {\n    font-family: Source Sans Pro !important;\n    text-rendering: geometricPrecision;\n    /*font-size:1rem;*/\n}\n\n/*left side bar*/\n.reference-redesign .Sidebar-link2Dsha-r-GKh2 {\n    font-size: 1rem;\n}\n\n/*table of contents font size*/\n.content-toc a {\n    font-size: 1rem;\n}\n\n/*Release Log H1 Class*/\nh1.ChangelogPost_title1wfGHpCMrYb1.ChangelogPost_titleexcerpttFbeBG-OZgYd a {\n    font-family: Source Sans Pro !important;\n    text-rendering: geometricPrecision;\n    font-size: 1.35rem;\n    font-weight: 600;\n}\n\nh2.heading.heading-2.header-scroll {\n    font-family: Source Sans Pro !important;\n    text-rendering: geometricPrecision;\n    font-size: 1.35rem;\n    font-weight: 600;\n}\n\nh3.heading.heading-3.header-scroll {\n    font-family: Source Sans Pro;\n    text-rendering: geometricPrecision;\n    font-size: 1.15rem;\n    font-weight: 600;\n}\n\n/*entire center column*/\n.rm-Article {\n    font-family: Source Sans Pro;\n    text-rendering: geometricPrecision;\n    padding: 64px 40px !important;\n}\n\n/*code font*/\n.cm-s-neo {\n    font-size: 100%;\n}\n\n/*code snippet font*/\n.cm-s-neo>* {\n    font-size: 95%;\n}\n\n.CodeTabs-toolbar {\n    font-family: Source Sans Pro;\n    text-rendering: geometricPrecision;\n    font-size: 115%;\n}\n\n.rm-Header-bottom {\n    margin: 0;\n}\n\n.Main-QuickNav-container1OiLvjSDusO6 {\n    padding: 4px 20px 10px;\n}\n\n.reference-redesign.Nav3C5f8FcjkaHj.rm-Sidebar_guides .rm-Sidebar {\n    padding-top: 0px;\n}\n\n.reference-redesign .Sidebar1t2G1ZJq-vU1 {\n    padding: 12px;\n}\n\n/*.Box2uBHSWG8DzPz.Box_pop1YKwQaFwZu8z.Menu.Menu_light.Box>* {\n  width:10%;\n} */\n\n/*Secondary Dropdown Items -  */\n.Menu-Item.Menu-Item-alignIcon_left.Menu-Item_link {\n    font-size: .95rem;\n}\n\n/*Remove GET from sidebar display*/\n.rm-Sidebar-list .APIMethod {\n    display: none;\n}\n\n/*Remove \"Defaults to\" text in sandboxes*/\ndiv[class^=\"Param-default-label\"] {\n    display: none !important;\n}\n\n/*h1 in body*/\n.App .rm-SuggestedEdits header h1,\n.App .rm-SuggestionDiff header h1,\n.App .rm-Guides header h1,\n.App .rm-ReferenceMain header h1,\n.App .rm-Changelog header h1,\n.App .rm-Discuss header h1,\n.App .rm-CustomPage header h1 {\n    font-weight: 600;\n}\n\ncode {\n    font-size: 85%;\n}\n\n/*Sandbox text*/\n.rm-ParamContainer a {\n  font-size: inherit !important;\n}\n\np {font-size:1rem;}\n\n.rm-ReferenceMain .rm-Article {\n    padding: 60px 20px !important;\n}\n\n/* Tables only when inside \u003cdetails class=\"Accordion\"> */\ndetails.Accordion :is(table, thead, tbody, tfoot, th, td) {\n  font-size: 12px !important;\n}\n\n.rm-ReferenceMain  .markdown-body table td, .markdown-body table th {\n  padding: 6px 10px !important;\n}\n\n.Accordion-content a {\n    font-size: 12px !important;\n}\n\n/* Accordion-content only if it contains a table */\n.rm-ReferenceMain .Accordion-content {\n  padding:0 !important;\n\n}\n\n/* Hide sandbox enums */\n[class^=\"Param-enum-section\"] {\n    display: none;\n}\n\n/* Custom Cards styles - added by ReadMe Support */\n.readme-tailwind .Card {\n  --Card-bg-color: rgba(var(--color-bg-page-inverse-rgb, 0, 0, 0), 0);\n  --Card-bg-color-hover: rgba(var(--color-bg-page-inverse-rgb, 0, 0, 0), 0.05);\n  --Card-border-color: var(--color-border-default, #e5e5e5);\n  --Card-layout: column;\n  --Card-padding: 1.5em;\n}\n\n.readme-tailwind .CardsGrid {\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)) !important;\n}\n\n.readme-tailwind .Card .Card-icon.text-gray-100 {\n  color: var(--Card-icon-color, #6b7280) !important;\n}\n\n.readme-tailwind .Card img {\n  margin-left: 0;\n  margin-bottom: 0.5em;\n}\n\n.readme-tailwind .Card .Card-title {\n  margin-bottom: 0;\n}\n\n\n@media screen and (max-width: 768px) {\n.Header-topuTMpygDG4e1V,\n.rm-Header-top,\n.Header3zzata9F_ZPQ.rm-Header {\n    height: auto;\n}\n}\n\n\n@media (max-width: 768px) {\n    .Header-leftADQdGVqx1wqU {\n        display: block;\n    }\n\nnav.Header-leftADQdGVqx1wqU.Header-subnavnVH8URdkgvEl {\n    display: none;\n}\n}\n\n/* Sign Up Button */\n/* Container fix for Desktop */\n.rm-Article-header {\n  display: flex !important;\n  justify-content: space-between !important;\n  align-items: center !important;\n  width: 100% !important;\n  border-bottom: 1px solid #eeeeee;\n  padding-bottom: 15px;\n  margin-bottom: 20px;\n}\n\n/* Blue Sportradar CTA Button Styles */\n#sr-signup-cta.custom-cta-button {\n  display: inline-flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n  \n  background-color: #001E62 !important; /* Sportradar Dark Blue */\n  color: #ffffff !important;\n  \n  padding: 10px 22px !important;\n  border-radius: 4px !important;\n  font-weight: 700 !important;\n  font-size: 14px !important;\n  text-decoration: none !important;\n  white-space: nowrap !important;\n  margin-left: 20px !important; \n  \n  transition: all 0.2s ease-in-out !important;\n  box-shadow: 0 2px 5px rgba(0, 30, 98, 0.2) !important;\n}\n\n#sr-signup-cta.custom-cta-button:hover {\n  background-color: #002d91 !important;\n  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15) !important;\n  transform: translateY(-1px);\n}\n\n/** * MOBILE/TABLET FIX\n * Hide the button on screens smaller than 991px \n * to prevent squishing the header text.\n */\n@media (max-width: 991px) {\n  #sr-signup-cta.custom-cta-button {\n    display: none !important;\n  }\n  \n  .rm-Article-header {\n    display: block !important; /* Resets to standard ReadMe title layout */\n  }\n}\n\n/* ============================================================\n   Statistics Summary - Custom CSS\n   Paste into ReadMe:  Project Settings > Appearance > Custom CSS\n   ------------------------------------------------------------\n   Scoped to the .stat-card / .stat-availability classes so it\n   will not affect any other page in the project.\n   All sizing uses variables at the top - change once, applies\n   to every Statistics Summary page (MLB, NBA, NFL, etc.).\n   ============================================================ */\n\n:root {\n  --stat-card-bg:        #ffffff;     /* explicit - do NOT use a theme var; some ReadMe themes paint these dark */\n  --stat-card-border:    #e3e3df;\n  --stat-accent:         #1d6fb8;   /* Sportradar-ish link blue; adjust to brand */\n  --stat-text:           #2b2b2b;\n  --stat-muted:          #6b6b6b;\n  --stat-radius:         8px;\n  --stat-font-size:      13px;       /* shrink terms slightly so nothing wraps */\n  --stat-col-min:        220px;      /* min column width before count drops */\n  --stat-gap:            28px;\n  --stat-highlight:      #fff3bf;    /* yellow behind a matched term */\n  --stat-highlight-text: #1a1a1a;\n}\n\n/* ---------- Filter / search box ---------- */\n.stat-filter {\n  position: sticky;        /* stays in view while the customer scrolls */\n  top: 0;\n  z-index: 5;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 12px 0;\n  margin-bottom: 8px;\n  background: var(--color-bg-page, #fff);\n}\n.stat-filter input,\n.stat-filter-input {\n  flex: 1 1 auto;\n  max-width: 420px;\n  font-size: 14px;\n  padding: 9px 14px;\n  border: 1px solid var(--stat-card-border);\n  border-radius: var(--stat-radius);\n  outline: none;\n  transition: border-color 0.12s ease, box-shadow 0.12s ease;\n}\n.stat-filter input:focus,\n.stat-filter-input:focus {\n  border-color: var(--stat-accent);\n  box-shadow: 0 0 0 3px rgba(29, 111, 184, 0.15);\n}\n.stat-filter-count {\n  font-size: 13px;\n  color: var(--stat-muted);\n  white-space: nowrap;\n}\n\n/* Highlight state - a data point whose text matches the filter */\n.stat-card .stat-points li.is-match,\n.stat-card .stat-points li.is-match a {\n  background: var(--stat-highlight) !important;\n  color: var(--stat-highlight-text) !important;\n  font-weight: 500;\n  border-radius: 3px;\n  padding-left: 4px;\n  margin-left: -4px;\n}\n/* Dim state - non-matching points fade back when a filter is active */\n.stat-points.filtering li:not(.is-match) {\n  opacity: 0.25;\n}\n/* A whole category with zero matches collapses out of the way. The JS\n   sets .is-empty directly on the card AND its dropdown, and\n   .is-empty-heading on the heading. ReadMe's theme sets headings to\n   display:flex with high specificity, so we over-specify here (html\n   prefix + attribute selector) AND use !important to guarantee the win. */\nhtml .stat-card.is-empty,\nhtml .stat-availability.is-empty {\n  display: none !important;\n}\n/* Heading of a category with no matches. Multiple selectors of rising\n   specificity so at least one beats ReadMe's heading layout rule. */\nh2.is-empty-heading,\nhtml h2.is-empty-heading,\nh2[class].is-empty-heading,\n.is-empty-heading {\n  display: none !important;\n  visibility: hidden !important;\n  height: 0 !important;\n  margin: 0 !important;\n  padding: 0 !important;\n  overflow: hidden !important;\n}\n/* Any stray note paragraph belonging to an emptied category */\nhtml .stat-card.is-empty + p { display: none !important; }\n\n/* ---------- The data-point card ---------- */\n/* High-specificity, !important background because some ReadMe themes\n   render these container divs with a dark code-block style. We force a\n   light card so the terms and the yellow filter highlight stay legible. */\n.stat-card,\ndiv.stat-card {\n  background: var(--stat-card-bg) !important;\n  color: var(--stat-text) !important;\n  border: 1px solid var(--stat-card-border);\n  border-left: 3px solid var(--stat-accent);\n  border-radius: 0 var(--stat-radius) var(--stat-radius) 0;\n  padding: 18px 22px;\n  margin: 8px 0 0 0;\n}\n.stat-card .stat-points li,\n.stat-card .stat-points li a {\n  color: var(--stat-text) !important;   /* ensure dark text on the light card */\n}\n\n/* The key fix: terms live in ONE flat list and CSS flows them into\n   columns automatically. No hand-balanced 3-column tables, so every\n   card spans the full content width and adding a term needs no\n   re-balancing. */\n.stat-card .stat-points {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  column-width: var(--stat-col-min);   /* auto column count by width */\n  column-gap: var(--stat-gap);\n}\n\n.stat-card .stat-points li {\n  break-inside: avoid;                 /* never split a term across columns */\n  font-size: var(--stat-font-size);\n  line-height: 1.45;                   /* tighter - less empty vertical gap */\n  margin-bottom: 1px;\n  color: var(--stat-text);\n  white-space: nowrap;                 /* keep each term on one line       */\n  overflow: hidden;\n  text-overflow: ellipsis;             /* safety net for any extreme term  */\n  padding-right: 6px;\n}\n\n/* ---------- The \"Available in\" dropdown ---------- */\n.stat-availability,\ndetails.stat-availability {\n  margin: 0 0 28px 0;\n  border: 1px solid var(--stat-card-border);\n  border-top: none;                    /* visually continues the card      */\n  border-radius: 0 0 var(--stat-radius) var(--stat-radius);\n  background: var(--stat-card-bg) !important;\n}\n\n.stat-availability > summary {\n  cursor: pointer;\n  list-style: none;                    /* remove default disclosure marker */\n  padding: 11px 18px;\n  font-size: 13px;\n  font-weight: 500;\n  color: var(--stat-accent);\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  user-select: none;\n  transition: background 0.12s ease;\n}\n.stat-availability > summary::-webkit-details-marker { display: none; }\n\n/* Custom chevron that clearly signals \"this opens\" and rotates on open */\n.stat-availability > summary::before {\n  content: \"\";\n  width: 8px;\n  height: 8px;\n  border-right: 2px solid var(--stat-accent);\n  border-bottom: 2px solid var(--stat-accent);\n  transform: rotate(-45deg);           /* points right when closed         */\n  transition: transform 0.15s ease;\n  flex: 0 0 auto;\n}\n.stat-availability[open] > summary::before {\n  transform: rotate(45deg);            /* points down when open            */\n}\n.stat-availability > summary:hover {\n  background: #f3f6fa;\n}\n\n.stat-count {\n  color: var(--stat-muted);\n  font-weight: 400;\n  font-size: 12px;\n}\n\n/* Endpoint links flow into responsive columns, same as data points */\n.stat-availability .stat-endpoints {\n  list-style: none;\n  margin: 0;\n  padding: 4px 18px 16px 34px;\n  column-width: 240px;\n  column-gap: var(--stat-gap);\n}\n.stat-availability .stat-endpoints li {\n  break-inside: avoid;\n  line-height: 1.9;\n  font-size: 13px;\n}\n.stat-availability .stat-endpoints a {\n  text-decoration: none;\n  border-bottom: 1px solid transparent;\n}\n.stat-availability .stat-endpoints a:hover {\n  border-bottom-color: currentColor;\n}\n\n/* ---------- Always light ---------- */\n/* These cards intentionally stay light in every mode. We do NOT follow\n   prefers-color-scheme: a dark card made the yellow filter highlight and\n   the dimmed non-matches illegible. Forcing light keeps the reference\n   page predictable and print-friendly. */\n\n/* ---------- Print / PDF ---------- */\n/* When a customer prints to PDF, expand all dropdowns and drop the\n   interactive chrome so every endpoint list is fully visible. */\n@media print {\n  /* --- FIX FOR \"only one page prints\" --- */\n  /* ReadMe renders the page inside a fixed-height, internally-scrolling\n     container. The print engine only captures the visible slice and then\n     emits blank pages for the rest. These rules release every common\n     wrapper ReadMe uses so the full document flows onto paper.\n     If a future ReadMe update renames a wrapper and this regresses,\n     inspect the page, find the element with its own scrollbar, and add\n     its selector to this list. */\n  html, body,\n  #root, .App, .rm-Guides, .rm-Article, .rm-Container,\n  [class*=\"rm-\"][class*=\"Content\"],\n  [class*=\"content\"], main, article {\n    height: auto !important;\n    max-height: none !important;\n    overflow: visible !important;\n    position: static !important;\n  }\n\n  /* Hide the logged-in editor toolbar / admin chrome that prints as a\n     floating dark bar on every page. */\n  [class*=\"SuggestedEdit\"],\n  [class*=\"AdminBar\"],\n  [class*=\"rm-Header\"],\n  nav, header { display: none !important; }\n\n  .stat-availability[open],\n  .stat-availability {\n    border-color: #ccc;\n  }\n  /* Force-open content for print even if collapsed on screen */\n  .stat-availability .stat-endpoints { display: block !important; }\n  .stat-card,\n  .stat-availability { break-inside: avoid; }\n  .stat-availability > summary::before { transform: rotate(45deg); }\n  .stat-card { background: #fff; }\n}\n\n/* Move Reference page indentation */\narticle.rm-Article#content {\n  padding-left: 1.5rem;\n}\n\n\n/* Hide AskAI button during trial */\n.rm-AskAi button,\n.rm-AskAi-button,\n[class*=\"Header-ask-ai-button\"] {\n  display: none !important;\n}\n\n/* Only reveal when JS sees ?askai=1 */\nhtml.askai-enabled .rm-AskAi button,\nhtml.askai-enabled .rm-AskAi-button,\nhtml.askai-enabled [class*=\"Header-ask-ai-button\"] {\n  display: inline-flex !important;\n}","stylesheet_hub3":"","javascript":"","javascript_hub2":"// ******************************************************************************************\n\n\n// ****PiwikPro*****\n\n(function(window, document, dataLayerName, id) {\n  window[dataLayerName]=window[dataLayerName]||[],window[dataLayerName].push({start:(new Date).getTime(),event:\"stg.start\"});var scripts=document.getElementsByTagName('script')[0],tags=document.createElement('script');\n  function stgCreateCookie(a,b,c){var d=\"\";if(c){var e=new Date;e.setTime(e.getTime()+24*c*60*60*1e3),d=\"; expires=\"+e.toUTCString();f=\"; SameSite=Strict\"}document.cookie=a+\"=\"+b+d+f+\"; path=/\"}\n  var isStgDebug=(window.location.href.match(\"stg_debug\")||document.cookie.match(\"stg_debug\"))&&!window.location.href.match(\"stg_disable_debug\");stgCreateCookie(\"stg_debug\",isStgDebug?1:\"\",isStgDebug?14:-1);\n  var qP=[];dataLayerName!==\"dataLayer\"&&qP.push(\"data_layer_name=\"+dataLayerName),isStgDebug&&qP.push(\"stg_debug\");var qPString=qP.length>0?(\"?\"+qP.join(\"&\")):\"\";\n  tags.async=!0,tags.src=\"https://sportradar.containers.piwik.pro/\"+id+\".js\"+qPString,scripts.parentNode.insertBefore(tags,scripts);\n  !function(a,n,i){a[n]=a[n]||{};for(var c=0;c\u003ci.length;c++)!function(i){a[n][i]=a[n][i]||{},a[n][i].api=a[n][i].api||function(){var a=[].slice.call(arguments,0);\"string\"==typeof a[0]&&window[dataLayerName].push({event:n+\".\"+i+\":\"+a[0],parameters:[].slice.call(arguments,1)})}}(i[c])}(window,\"ppms\",[\"tm\",\"cm\"]);\n  })(window, document, 'dataLayer', 'c90e0d31-40ac-4bfd-8b5f-ef633dfbbe37');\n  \n  \n  \n  // **Signup Button**\n  (function() {\n    const marketMap = {\n      'mlb': 'https://marketplace.sportradar.com/products/64076f13822569c8fbf1fd7c',\n      'global-baseball': 'https://marketplace.sportradar.com/products/652fadc8459a02f489d9ff7c',\n      'nfl': 'https://marketplace.sportradar.com/products/64d179bb0a92ec119620d9d5',\n      'ncaafb': 'https://marketplace.sportradar.com/products/64d18a87d2568e006318b660',\n      'ufl': 'https://marketplace.sportradar.com/products/65c4f5fe1c99c00ecd81872a',\n      'global-american-football': 'https://marketplace.sportradar.com/products/652fbab03bc9b0cb71d1d6a9',\n      'global-basketball': 'https://marketplace.sportradar.com/products/652fb0103bc9b0cb71d1d134',\n      'nba': 'https://marketplace.sportradar.com/products/64d186778ad4bfe2bd064a26',\n      'g-league': 'https://marketplace.sportradar.com/products/64d2ce434d1090ba4a675cba',\n      'ncaamb': 'https://marketplace.sportradar.com/products/6504a21b5f79552ba0b8003c',\n      'ncaawb': 'https://marketplace.sportradar.com/products/6504a1af5f79552ba0b7ff9e',\n      'synergy-basketball': 'https://marketplace.sportradar.com/products/68a87e46e87e4b2ecbfc7212',\n      'unrivaled': 'https://marketplace.sportradar.com/products/69148fd83a35998993f91409',\n      'wnba': 'https://marketplace.sportradar.com/products/64d2c7dd6b8b339e3ce4f7b8',\n      'aussie-rules': 'https://marketplace.sportradar.com/products/652fa7f511a759a67b0640d9',\n      'bandminton': 'https://marketplace.sportradar.com/products/652fa9d03bc9b0cb71d1cf7f',\n      'bandy': 'https://marketplace.sportradar.com/products/652faced459a02f489d9fbff',\n      'beach-soccer': 'https://marketplace.sportradar.com/products/652fbba4cf0671cf96f980dd',\n      'cricket': 'https://marketplace.sportradar.com/products/652fb2675ab138506bb6f672',\n      'curling': 'https://marketplace.sportradar.com/products/652fb305459a02f489da04d9',\n      'cycling': 'https://marketplace.sportradar.com/products/652fb3e6459a02f489da0878',\n      'darts': 'https://marketplace.sportradar.com/products/652fb497459a02f489da0c17',\n      'field-hockey': 'https://marketplace.sportradar.com/products/652fb564459a02f489da0fbe',\n      'floorball': 'https://marketplace.sportradar.com/products/652fba153bc9b0cb71d1d2f5',\n      'futsal': 'https://marketplace.sportradar.com/products/652fc0293bc9b0cb71d1d8a0',\n      'golf': 'https://marketplace.sportradar.com/products/6501ee32cd795eb374057bc5',\n      'handball': 'https://marketplace.sportradar.com/products/652fc0fe3bc9b0cb71d1dc67',\n      'global-ice-hockey': 'https://marketplace.sportradar.com/products/652fc75f91cb7d6acdef2142',\n      'ncaamh': 'https://marketplace.sportradar.com/products/64ef566c9b750f4d54d28555',\n      'nhl': 'https://marketplace.sportradar.com/products/64ef56469b750f4d54d28503',\n      'mma': 'https://marketplace.sportradar.com/products/652fc88991cb7d6acdef2532',\n      'f1': 'https://marketplace.sportradar.com/products/652fca7c91cb7d6acdef2ed6',\n      'formula-e': 'https://marketplace.sportradar.com/products/652fcaeb91cb7d6acdef32b9',\n      'indy-lights': 'https://marketplace.sportradar.com/products/652fcbbc91cb7d6acdef36a0',\n      'indycar': 'https://marketplace.sportradar.com/products/652fcc44604a88e96bd77d0e',\n      'motogp': 'https://marketplace.sportradar.com/products/652fccb3604a88e96bd780fd',\n      'nascar': 'https://marketplace.sportradar.com/products/64efb181a6abd32e000d8450',\n      'rally': 'https://marketplace.sportradar.com/products/652fcd54604a88e96bd784f0',\n      'olympic-medals': 'https://marketplace.sportradar.com/products/66507d78729b8b37add601bd',\n      'pesapallo': 'https://marketplace.sportradar.com/products/652fc9b791cb7d6acdef290d',\n      'rugby': 'https://marketplace.sportradar.com/products/652fcdeb8805049528df13b5',\n      'snooker': 'https://marketplace.sportradar.com/products/6530f1bd9092f74387e646f8',\n      'soccer': 'https://marketplace.sportradar.com/products/64ff63efabf21f142352ee6b',\n      'squash': 'https://marketplace.sportradar.com/products/653153e64c579e32d10a0f52',\n      'table-tennis': 'https://marketplace.sportradar.com/products/653154816a6635c3544c0750',\n      'tennis': 'https://marketplace.sportradar.com/products/6501e20f236aba44b550bdae',\n      'beach-volleyball': 'https://marketplace.sportradar.com/products/653155ba6a6635c3544c0be2',\n      'indoor-volleyball': 'https://marketplace.sportradar.com/products/6531568e4c579e32d10a16c5',\n      'waterpolo': 'https://marketplace.sportradar.com/products/653158004c579e32d10a1b1b',\n      'winter-sports': 'https://marketplace.sportradar.com/products/65315989feb01a58ef689029',\n      'images': 'https://marketplace.sportradar.com/products/categories/images-editorials?domain=media-tech',\n      'editorial': 'https://marketplace.sportradar.com/products/categories/images-editorials?domain=media-tech',\n      'oc-futures': 'https://marketplace.sportradar.com/products/6553a74b4f5b4577563927bd',\n      'oc-live-odds': 'https://marketplace.sportradar.com/products/6765996ea1f380e469a27947',\n      'oc-player-props': 'https://marketplace.sportradar.com/products/6553a6f6d0d7bbe334422809',\n      'oc-prematch': 'https://marketplace.sportradar.com/products/6553a667d0d7bbe334421e30',\n      'oc-regular': 'https://marketplace.sportradar.com/products/6553a5954f5b4577563917ce',\n      'probabilities': 'https://marketplace.sportradar.com/products/6531638f69406a56c7137c50',\n      'gen-ai-overview': 'https://marketplace.sportradar.com/products/6a1f348945048ac218efb97d',\n      'default': 'https://marketplace.sportradar.com/signup'\n    };\n  \n    function updateCTA() {\n      const pageTitle = document.querySelector('h1');\n      if (!pageTitle) return;\n  \n      const currentPath = window.location.pathname.toLowerCase();\n      let btn = document.getElementById('sr-signup-cta');\n  \n      // 1. HARD EXCLUSION: Never show on Widgets project\n      if (currentPath.includes('/widgets/')) {\n        if (btn) btn.remove();\n        return;\n      }\n\n      // 1b. HARD EXCLUSION: Pages that should never show the CTA\n    const excludedPaths = [\n      '/getting-started/docs/simulations',\n      '/getting-started/docs/api-security-enhancements',\n    ];\n    if (excludedPaths.some(path => currentPath.includes(path))) {\n      if (btn) btn.remove();\n      return;\n    }\n  \n      // 2. CHECK FOR OVERVIEW: Button only appears if path contains 'overview' or 'getting-started'\n      const isOverviewPage = currentPath.includes('overview');\n      const isGettingStarted = currentPath.includes('getting-started');\n  \n      if (!isOverviewPage && !isGettingStarted) {\n        if (btn) btn.remove();\n        return;\n      }\n  \n      // 3. Determine the specific sport link\n      let targetLink = null;\n      const sortedKeys = Object.keys(marketMap).sort((a, b) => b.length - a.length);\n  \n      for (const key of sortedKeys) {\n        if (currentPath.includes(key) && key !== 'default') {\n          targetLink = marketMap[key];\n          break;\n        }\n      }\n  \n      // 4. Fallback for Getting Started if no sport match found\n      if (!targetLink && isGettingStarted) {\n        targetLink = marketMap['default'];\n      }\n  \n      // 5. Render/Update/Remove\n      if (targetLink) {\n        if (!btn) {\n          btn = document.createElement('a');\n          btn.id = 'sr-signup-cta';\n          btn.innerText = 'Add Trial in Marketplace';\n          btn.className = 'custom-cta-button';\n          btn.target = '_blank';\n          btn.rel = 'noopener noreferrer';\n          \n          const headerContainer = pageTitle.parentElement;\n          if (headerContainer) {\n            headerContainer.style.display = 'flex';\n            headerContainer.style.width = '100%';\n            headerContainer.style.justifyContent = 'space-between';\n            headerContainer.style.alignItems = 'center';\n            pageTitle.after(btn);\n          }\n        }\n        btn.href = targetLink;\n      } else {\n        if (btn) btn.remove();\n      }\n    }\n  \n    const observer = new MutationObserver(updateCTA);\n    observer.observe(document.body, { childList: true, subtree: true });\n    updateCTA();\n  })();\n  \n  // ===========================\n  // Ask AI gated auto-open\n  // ===========================\n  \n  (() => {\n    const PARAM_NAME = 'askai';\n    const PARAM_VALUE = '1';\n    const HTML_CLASS = 'askai-enabled';\n  \n    const params = new URLSearchParams(window.location.search);\n    const shouldOpenAskAi = params.get(PARAM_NAME) === PARAM_VALUE;\n  \n    // No ?askai=1 = do nothing. CSS should keep Ask AI hidden.\n    if (!shouldOpenAskAi) return;\n  \n    // Temporarily reveal Ask AI so we can click it.\n    document.documentElement.classList.add(HTML_CLASS);\n  \n    const findAskAiButton = () => {\n      const directMatches = [\n        document.querySelector('.rm-AskAi button'),\n        document.querySelector('.rm-AskAi-button'),\n        document.querySelector('[class*=\"Header-ask-ai-button\"]'),\n      ].filter(Boolean);\n  \n      const byText = [...document.querySelectorAll('button')].find(btn =>\n        btn.textContent &&\n        btn.textContent.trim().toLowerCase().includes('ask ai')\n      );\n  \n      return [...directMatches, byText].find(Boolean) || null;\n    };\n  \n    const clickButton = btn => {\n      btn.scrollIntoView({ block: 'center', inline: 'center' });\n  \n      ['pointerdown', 'mousedown', 'mouseup', 'click'].forEach(type => {\n        btn.dispatchEvent(new MouseEvent(type, {\n          bubbles: true,\n          cancelable: true,\n          view: window\n        }));\n      });\n    };\n  \n    const cleanupUrlAndHideButton = () => {\n      const url = new URL(window.location.href);\n      url.searchParams.delete(PARAM_NAME);\n      window.history.replaceState({}, '', url.toString());\n  \n      // Give the Ask AI panel a moment to open, then hide the button again.\n      setTimeout(() => {\n        document.documentElement.classList.remove(HTML_CLASS);\n      }, 250);\n    };\n  \n    const openAskAi = () => {\n      const btn = findAskAiButton();\n      if (!btn) return false;\n  \n      clickButton(btn);\n      cleanupUrlAndHideButton();\n  \n      console.log('Ask AI auto-opened');\n      return true;\n    };\n  \n    const start = () => {\n      if (openAskAi()) return;\n  \n      const askAiObserver = new MutationObserver(() => {\n        if (openAskAi()) {\n          askAiObserver.disconnect();\n          clearTimeout(timeout);\n        }\n      });\n  \n      askAiObserver.observe(document.documentElement, {\n        childList: true,\n        subtree: true\n      });\n  \n      const timeout = setTimeout(() => {\n        askAiObserver.disconnect();\n        document.documentElement.classList.remove(HTML_CLASS);\n        console.warn('Ask AI button was not found.');\n      }, 10000);\n    };\n  \n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', start);\n    } else {\n      start();\n    }\n  })();\n  \n  \n  // ******************************************************************************************\n  // ****Dropdown Parent Clip****\n  // Clips the project picker dropdown container to prevent empty space below sport grid\n  // ******************************************************************************************\n  \n  /* ==========================================================\n     SPORTRADAR README DROPDOWN — CUSTOM JS\n     Paste into: Appearance > Custom JS\n     ========================================================== */\n  \n  // Clip parent on dropdown open — scoped to project picker ONLY\n  const observer = new MutationObserver(() => {\n      // Only target the Dropdown-content that belongs to the project picker,\n      // not any other dropdown on the page (e.g. Request Examples, field tooltips).\n      const projectPickerMenu = document.querySelector('.rm-ProjectPicker-menu');\n      const parent = projectPickerMenu && projectPickerMenu.closest('.Dropdown-content_opened');\n      if (parent) {\n        if (window.innerWidth >= 1100) {\n          parent.style.setProperty('overflow', 'hidden', 'important');\n          parent.style.setProperty('max-height', '252px', 'important');\n          parent.style.setProperty('padding', '0', 'important');\n          parent.style.setProperty('margin-top', '0', 'important');\n          parent.style.setProperty('min-width', '1100px', 'important');\n        } else {\n          parent.style.removeProperty('overflow');\n          parent.style.removeProperty('max-height');\n          parent.style.removeProperty('padding');\n          parent.style.removeProperty('margin-top');\n          parent.style.removeProperty('min-width');\n        }\n      }\n  });\n  observer.observe(document.body, { subtree: true, attributes: true, attributeFilter: ['class'] });\n  \n  // ============================================================\n  //  Statistics Summary - Custom JS\n  //  Paste into ReadMe: Project Settings > Appearance > Custom JS\n  //  ------------------------------------------------------------\n  //   1. FILTER BOX - the script builds its own search box and\n  //      inserts it directly above the first stat card. It does not\n  //      depend on any HTML surviving in the Markdown.\n  //   2. PRINT EXPAND - opens every \"Available in\" dropdown before\n  //      printing, then restores them.\n  //\n  //  Defensive install: retries on a timer AND via MutationObserver,\n  //  inserts relative to the first card (no sibling-walking), and\n  //  wraps insertion in try/catch so a DOM quirk can't silently kill\n  //  it. Logs to console with a [StatsFilter] prefix so issues are\n  //  visible if anything goes wrong.\n  // ============================================================\n  \n  (function () {\n    \"use strict\";\n  \n    var BOX_ID = \"statFilter\";\n    var COUNT_ID = \"statFilterCount\";\n    var LOG = \"[StatsFilter] \";\n\n    // Placeholder examples for the filter box.\n    //\n    // Resolution order:\n    //   1. PER-PAGE MARKER (most specific, always wins): if the page\n    //      includes an element like\n    //        \u003cspan class=\"stat-filter-examples\" data-examples=\"a, b, c\" hidden>\u003c/span>\n    //      its data-examples value is used verbatim. This lets any single\n    //      page declare its own examples regardless of URL, which matters\n    //      because some products share a sport-word path (e.g. both NFL and\n    //      Global American Football live under /football/).\n    //   2. URL PATH MAP (fallback): sport-word match for the deeper,\n    //      play-level products.\n    //   3. GENERIC FALLBACK: terms that exist across virtually every feed.\n    function filterExamples() {\n      // 1. Per-page marker.\n      try {\n        var marker = document.querySelector(\".stat-filter-examples\");\n        if (marker) {\n          var ex = (marker.getAttribute(\"data-examples\") || \"\").trim();\n          if (ex) return ex;\n        }\n      } catch (e) { /* fall through to path logic */ }\n\n      // 2. URL path map.\n      var path = (window.location.pathname || \"\").toLowerCase();\n      var map = [\n        [\"handball\",   \"goals, shots, saves\"],\n        [\"rugby\",      \"tries, tackles, scrums\"],\n        [\"baseball\",   \"pitch, stolen, on-base\"],\n        [\"basketball\", \"rebounds, assists, fouls\"],\n        [\"football\",   \"rushing, tackles, sacks\"],\n        [\"hockey\",     \"goals, assists, penalties\"],\n        [\"soccer\",     \"goals, assists, offside\"],\n        [\"tennis\",     \"aces, break points, serves\"],\n        [\"golf\",       \"strokes, birdies, fairways\"],\n        [\"racing\",     \"laps, position, points\"],\n        [\"odds\",       \"market, odds, book\"]\n      ];\n      for (var i = 0; i \u003c map.length; i++) {\n        if (path.indexOf(map[i][0]) !== -1) return map[i][1];\n      }\n\n      // 3. Generic fallback.\n      return \"competitor, score, season\";\n    }\n\n    function buildBox() {\n      // Only trust the live DOM. Do NOT rely on a cached \"installed\"\n      // flag: ReadMe re-renders the page client-side and can remove the\n      // box while a flag would still say it exists, blocking reinstall.\n      if (document.getElementById(BOX_ID)) return true;\n  \n      var firstCard = document.querySelector(\".stat-card\");\n      if (!firstCard) return false;            // cards not rendered yet\n  \n      try {\n        var wrap = document.createElement(\"div\");\n        wrap.className = \"stat-filter\";\n  \n        var input = document.createElement(\"input\");\n        input.type = \"text\";\n        input.id = BOX_ID;\n        input.className = \"stat-filter-input\";\n        input.setAttribute(\"autocomplete\", \"off\");\n        input.placeholder = \"Filter data points (e.g. \" + filterExamples() + \")...\";\n  \n        var count = document.createElement(\"span\");\n        count.className = \"stat-filter-count\";\n        count.id = COUNT_ID;\n  \n        wrap.appendChild(input);\n        wrap.appendChild(count);\n  \n        // Insert the box immediately before the first card. Use the\n        // card's OWN parent so we never rely on DOM structure we can't\n        // see. If a heading sits right above, place the box above that.\n        var ref = firstCard;\n        var prev = firstCard.previousElementSibling;\n        if (prev && prev.tagName === \"H2\") ref = prev;\n  \n        ref.parentNode.insertBefore(wrap, ref);\n        console.log(LOG + \"filter box installed\");\n        return true;\n      } catch (err) {\n        console.log(LOG + \"install failed:\", err);\n        return false;\n      }\n    }\n  \n    function runFilter(query) {\n      var q = (query || \"\").trim().toLowerCase();\n      var total = 0;\n  \n      document.querySelectorAll(\".stat-card\").forEach(function (card) {\n        var list = card.querySelector(\".stat-points\");\n        if (!list) return;\n        var cardMatches = 0;\n  \n        list.querySelectorAll(\"li\").forEach(function (li) {\n          var term = (li.getAttribute(\"data-term\") || li.textContent || \"\").toLowerCase();\n          var hit = q !== \"\" && term.indexOf(q) !== -1;\n          li.classList.toggle(\"is-match\", hit);\n          if (hit) cardMatches++;\n        });\n  \n        list.classList.toggle(\"filtering\", q !== \"\");\n  \n        var heading = card.previousElementSibling;\n        while (heading && heading.tagName !== \"H2\") heading = heading.previousElementSibling;\n  \n        var empty = q !== \"\" && cardMatches === 0;\n        card.classList.toggle(\"is-empty\", empty);\n        if (heading) heading.classList.toggle(\"is-empty-heading\", empty);\n\n        // Also hide the category's \"available in\" dropdown when the card\n        // is empty. The \u003cdetails class=\"stat-availability\"> is a SIBLING of\n        // the card (not a child), so walk forward to the next one. Stop if\n        // we hit the next heading/card so we never grab another category's\n        // dropdown.\n        var drop = card.nextElementSibling;\n        while (drop &&\n               !(drop.classList && drop.classList.contains(\"stat-availability\"))) {\n          if (drop.tagName === \"H2\" ||\n              (drop.classList && drop.classList.contains(\"stat-card\"))) {\n            drop = null;\n            break;\n          }\n          drop = drop.nextElementSibling;\n        }\n        if (drop) drop.classList.toggle(\"is-empty\", empty);\n\n        total += cardMatches;\n      });\n  \n      var c = document.getElementById(COUNT_ID);\n      if (c) c.textContent = q === \"\" ? \"\" : total + (total === 1 ? \" match\" : \" matches\");\n    }\n  \n    // Delegated listeners survive ReadMe's client-side re-renders\n    document.addEventListener(\"input\", function (e) {\n      if (e.target && e.target.id === BOX_ID) runFilter(e.target.value);\n    });\n    document.addEventListener(\"keydown\", function (e) {\n      if (e.key === \"Escape\" && e.target && e.target.id === BOX_ID) {\n        e.target.value = \"\";\n        runFilter(\"\");\n      }\n    });\n  \n    // --- Install strategy: try now, on a short poll, and on DOM changes ---\n    function attempt() { return buildBox(); }\n  \n    // 1) Immediate + DOM ready\n    attempt();\n    if (document.readyState === \"loading\") {\n      document.addEventListener(\"DOMContentLoaded\", attempt);\n    }\n  \n    // 2) Short poll (handles ReadMe rendering cards a beat after load)\n    var tries = 0;\n    var poll = setInterval(function () {\n      tries++;\n      if (attempt() || tries > 40) clearInterval(poll);  // ~10s max\n    }, 250);\n  \n    // 3) MutationObserver for client-side page navigation. If the box\n    //    gets removed by a page swap, rebuild it.\n    var obs = new MutationObserver(function () {\n      if (!document.getElementById(BOX_ID) && document.querySelector(\".stat-card\")) {\n        attempt();\n      }\n    });\n    if (document.body) obs.observe(document.body, { childList: true, subtree: true });\n  \n    // ---------- PRINT EXPAND ----------\n    var opened = [];\n    window.addEventListener(\"beforeprint\", function () {\n      opened = [];\n      document.querySelectorAll(\"details.stat-availability\").forEach(function (d) {\n        if (!d.open) { d.open = true; opened.push(d); }\n      });\n    });\n    window.addEventListener(\"afterprint\", function () {\n      opened.forEach(function (d) { d.open = false; });\n      opened = [];\n    });\n  \n    console.log(LOG + \"loaded\");\n  })();","html_promo":"","html_body":"","html_footer":"","html_head":"\u003c!-- TRUENDO Privacy Center -->\n\u003cscript id=\"truendoAutoBlock\" type=\"text/javascript\" src=\"https://cdn-geo.priv.center/a684e5d8-c7ac-43b2-8ae3-1cbbc0091beb/?id=a684e5d8-c7ac-43b2-8ae3-1cbbc0091beb\">\u003c/script>\n\u003c!-- End TRUENDO Privacy Center -->\n\n\u003clink rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n\u003clink rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n\u003clink href=\"https://fonts.googleapis.com/css2?family=Source+Sans+Pro:ital,wght@0,200;0,300;0,400;0,600;0,700;0,900;1,200;1,300;1,400;1,600;1,700;1,900&display=swap\" rel=\"stylesheet\">\n\n\u003cscript>\n  // Utility sleep function.\n  const sleep = (ms) => new Promise(resolve => setTimeout(resolve, ms));\n\n  // Global flag to ensure auto-toggle happens only once.\n  window.autoToggleDone = window.autoToggleDone || false;\n\n  async function processRefinementList() {\n    console.log(\"Processing refinement list...\");\n\n    // Phase 1: Wait for the \"More\" button each time, and click it only if its text is \"MORE\".\n    let moreButton = null;\n    const maxWaitTime = 10000; // 10 seconds max wait time\n    const startTime = Date.now();\n    while (!moreButton && (Date.now() - startTime) \u003c maxWaitTime) {\n      moreButton = document.querySelector(\"button.RefinementList-Button2fUR5J_rHDXh\");\n      if (!moreButton) {\n        console.log(\"More button not found yet, waiting 500ms...\");\n        await sleep(500);\n      }\n    }\n    if (moreButton) {\n      // Only click if its text is exactly \"MORE\" (case-insensitive).\n      if (moreButton.textContent.trim().toUpperCase() === \"MORE\") {\n        console.log(\"Found More button with text 'MORE'. Clicking it.\");\n        moreButton.click();\n      } else {\n        console.log(\"Button text is not 'MORE' (likely 'LESS'); not clicking to avoid closing the list.\");\n      }\n    } else {\n      console.warn(\"More button was not found within the wait period.\");\n    }\n\n    // Phase 2: Wait 1 second for the list to load.\n    console.log(\"Waiting 1 second for the list to load...\");\n    await sleep(500);\n\n    // Phase 3: Process the list items.\n    const examples = document.querySelector(\"[class*='RefinementList']\");\n    if (!examples) {\n      console.warn(\"RefinementList container not found.\");\n      return;\n    }\n    console.log(\"Found RefinementList container.\");\n\n    const categoryLabels = examples.querySelectorAll(\".Toggle-label\");\n    const checkboxes = examples.querySelectorAll(\".Toggle-input\");\n    const urlPath = window.location.pathname.toLowerCase();\n    let toggledCategoryIndex = -1;\n\n    // Define unwanted categories.\n    const isUnwanted = (categoryTitle) => {\n      return categoryTitle.startsWith(\"sportradar\") || categoryTitle === \"sports api\";\n    };\n\n    // Auto-toggle the checkbox only the first time.\n    if (!window.autoToggleDone) {\n      for (let index = 0; index \u003c categoryLabels.length; index++) {\n        const label = categoryLabels[index];\n        const categoryTitle = label.textContent.trim().toLowerCase();\n\n        // Skip unwanted categories.\n        if (isUnwanted(categoryTitle)) {\n          console.log(`Skipping toggling for unwanted category: ${categoryTitle}`);\n          continue;\n        }\n\n        // Create a slug and check against the URL.\n        const slug = categoryTitle.replace(/ /g, \"-\");\n        if (urlPath.includes(slug) && toggledCategoryIndex === -1) {\n          const checkbox = checkboxes[index];\n          if (checkbox) {\n            console.log(`Toggling checkbox for category: ${categoryTitle}`);\n            // If already checked, uncheck first.\n            if (checkbox.checked) {\n              console.log(`Checkbox for ${categoryTitle} is already checked. Unchecking first.`);\n              checkbox.click();\n              await sleep(500); // Brief pause after unchecking.\n            }\n            checkbox.click();\n            console.log(`Checkbox for ${categoryTitle} is now checked.`);\n            toggledCategoryIndex = index;\n          }\n        }\n      }\n      // Mark that auto-toggle is complete.\n      window.autoToggleDone = true;\n    } else {\n      console.log(\"Auto-toggle already performed; skipping toggling step.\");\n    }\n\n    // Phase 4: Wait 1 second after toggling.\n    console.log(\"Waiting 1 second after toggling for list rearrangement...\");\n    await sleep(800);\n\n    // Phase 5: Hide unwanted categories.\n    categoryLabels.forEach(label => {\n      const categoryTitle = label.textContent.trim().toLowerCase();\n      if (isUnwanted(categoryTitle)) {\n        const listItem = label.closest(\"li\");\n        if (listItem) {\n          console.log(`Hiding list item for unwanted category: ${categoryTitle}`);\n          listItem.style.display = 'none';\n        } else {\n          console.warn(`List item for ${categoryTitle} not found.`);\n        }\n      }\n    });\n  }\n\n  // Utility: Wait for a specific element to be available.\n  function waitForElement(selector, timeout = 10000) {\n    return new Promise((resolve, reject) => {\n      const startTime = Date.now();\n      const interval = setInterval(() => {\n        const el = document.querySelector(selector);\n        if (el) {\n          clearInterval(interval);\n          resolve(el);\n        } else if (Date.now() - startTime > timeout) {\n          clearInterval(interval);\n          reject(new Error(`Element not found: ${selector}`));\n        }\n      }, 100);\n    });\n  }\n\n  // Attach a listener to the specific header search button.\n  async function initSearchButtonListener() {\n    try {\n      // Use a specific selector to target the correct search button.\n      const searchButton = await waitForElement('div.rm-Header-search.Header-searchtb6Foi0-D9Vx > button.rm-SearchToggle');\n      searchButton.addEventListener('click', () => {\n        // Allow a brief delay for the modal to render.\n        setTimeout(() => {\n          processRefinementList();\n        }, 300); // Adjust the delay if needed.\n      });\n      console.log(\"Search button listener attached.\");\n    } catch (error) {\n      console.error(\"Failed to attach search button listener:\", error);\n    }\n  }\n\n  // Initialize when the DOM is fully loaded.\n  document.addEventListener('DOMContentLoaded', () => {\n    initSearchButtonListener();\n  });\n\u003c/script>","html_footer_meta":"\u003cdiv style=\"background:#E7EAF6;float:left; width:100%; max-width:100%; margin:0 auto;\" class=\"footer container\">\n  \u003cdiv style=\"max-width:960px; margin:0 auto; padding-left:2rem; padding-right:2rem: display: flex; justify-content: space-between; align-items: center;\">\n    \u003cp style=\"color:#1A237E;display:inline-block;\">&copy; Sportradar AG, St. Gallen, Switzerland\u003c/p>\n    \u003cnav class=\"footer-links\">\n      \u003ca style=\"color:#1A237E;\" href=\"https://sportradar.com/privacy-notice\">Privacy Policy\u003c/a>&nbsp;&nbsp;&nbsp;|&nbsp;&nbsp;&nbsp;\n      \u003ca style=\"color:#1A237E;\" href=\"/terms-and-conditions\">Terms and Conditions\u003c/a>&nbsp;&nbsp;&nbsp;|&nbsp;&nbsp;&nbsp;\n      \u003ca style=\"color:#1A237E;\" href=\"https://sportradar.com/contact\">Contact Us\u003c/a>\n    \u003c/nav>\n  \u003c/div>\n\u003c/div>","global_landing_page":{"html":"\u003c!DOCTYPE html>\n\u003chtml lang=\"en\">\n\n\u003cstyle>\n  \n  .rm-Header-bottom {\ndisplay:none;\n }\n  \n  .MobileFlyout1hHJpUd-nYkd>*:nth-child(4,6) {\n    display:none;\n  }\n    .App {\n         font-family: Source Sans Pro !important;\n         text-rendering: geometricPrecision;  \n    }\n  \n  .hub-footer {\n    display:none;\n  }\n  \n  .Banner2qY-Hhfqm_Gx, .Banner_secondary1reFai47T0j4, .Banner_smUPcJRlth4_Dl, .Banner_fixeda1mFpjcc1TJ6, .hub-footer {\n    display:none;\n  }\n  \n  .footer.container>*{\n  padding-left:2rem;\n  padding-right:2rem;\n    display:flex;\n    padding:.75rem;\n  \tmargin:0;\n  }\n  \n    /*readme nav parent header container*/\n   .Header3zzata9F_ZPQ, .rm-Header  {\n     display:flex;\n     width:100%;\n     background-color:#283593;\n     position: fixed !important;\n  top: 0 !important;\n  z-index: 100;\n    }\n  \n  .rm-Container.rm-Container_flex {\n    height: 56px;\n    background-color:#283593;\n  }\n  \n  \n  /*hide staging/production indicator row*/\n  .Header-staging2fhBvH-z5mvq.Banner2qY-Hhfqm_Gx.Banner_secondary1reFai47T0j4.Banner_smUPcJRlth4_Dl.Banner_fixeda1mFpjcc1TJ6 {\n    display:none; }\n  \n  .App .rm-Container {\n        height: 56px\n  }\n    \n  \n  /*readme search row hidden*/\n  .rm-Header-bottom, .Header-bottom2eLKOFXMEmh5, .Header-bottom_withProjects2M-cAt2wdVuU  {\n    display:none;\n  }\n  \n  /*nav links*/\n  .ThemeContext_dark .rm-ThemeToggle, .ThemeContext_line.ThemeContext_light .rm-ThemeToggle, .ThemeContext_dark .rm-Header-top-link, .ThemeContext_line.ThemeContext_light .rm-Header-top-link, .ThemeContext_dark .rm-Header-bottom-link, .ThemeContext_line.ThemeContext_light .rm-Header-bottom-link {\n    color:white;\n    padding:1rem;\n    height:56px;\n    border-width:0px;\n    border-radius:0px;\n    font-size:1rem;\n  }\n  \n  /*nav links hover*/\n   .ThemeContext_dark:hover .rm-ThemeToggle:hover, .ThemeContext_line.ThemeContext_light:hover .rm-ThemeToggle:hover, .ThemeContext_dark:hover .rm-Header-top-link:hover, .ThemeContext_line.ThemeContext_light:hover .rm-Header-top-link:hover, .ThemeContext_dark:hover .rm-Header-bottom-link:hover, .ThemeContext_line.ThemeContext_light:hover .rm-Header-bottom-link:hover {\n    background-color: #4552b5;\n  \tcolor: white !important;\n  }\n  \n   /*readme deafult header bottom border removed*/\n  .Header-topuTMpygDG4e1V {\n    border-bottom:0px;\n  }\n  \n  /*header padding*/\n  .Header-right21PC2XTT6aMg, .Header-leftADQdGVqx1wqU {\n    padding-top:0px;\n    padding-bottom:0px;\n    display:flex;\n    gap:0px;\n  }\n    \n  .Header-right21PC2XTT6aMg {\n    display:flex;\n\t\t@media (max-width:750px){\n  \t\tdisplay:none;}\n  }\n  \n  .menu3d6DYNDa3tk5 {\n    display:flex;\n    @media (min-width:750px){\n      display:none;}\n  }\n  \n.Header-logo-img3YvV4lcGKkeb, .rm-Logo-img {\n  margin-top:6px;\n  }\n  \n  .menu3d6DYNDa3tk5 {\n    color:white;\n\n  }\n  \n  .Header-topuTMpygDG4e1V .Header-searchtb6Foi0-D9Vx {\n    display:none;\n  }\n  \n  .Flyout95xhYIIoTKtc {\n    right:0;\n    left:auto;\n    -webkit-animation:none;\n  }\n  \n /* .Flyout_overlay1M3UuWE_hk3r {\n    right:0;\n  }\n  */\n\n  \nhtml,\nbody {\n    overflow-x: hidden;\n    min-height: 100vh;\n    color-scheme: dark;\n    font-family: 'source sans 3', sans-serif;\n    margin-block-start: 0rem;\n    margin-block-end: 0px;\n    transition-duration: 1000ms;\n    justify-content: center;\n    margin-left: auto;\n    margin-right: auto;\n    margin: 0;\n    padding: 0;\n  background-color: #283493;\n}\n\n:root {\n    --primary: #1A237E;\n    --linkblue: #2962FF;\n    --linkred: #D32F2F;\n    --outline: #E8EAF6;\n    --gridgap: .75rem;\n}\n\n.d2 {\n    font-size: 2.5rem;\n    line-height: 2.5rem;\n    font-weight: 700;\n}\n\nh1 {\n    font-size: 2rem;\n    line-height: 2rem;\n    font-weight: 700;\n    margin-block-start: 0rem;\n    margin-block-end: 0px;\n}\n\np {\n    font-size: 1rem;\n    font-weight: 400;\n    margin-block-start: .5rem;\n    margin-block-end: .5rem;\n\n    @media screen and (max-width:700px) {\n        font-size: .95rem;\n    }\n}\n\n.p2 {\n    font-size: .875rem;\n    font-weight: 400;\n    margin-block-start: .5rem;\n    margin-block-end: 0px;\n}\n\nh2 {\n    font-size: 1.5rem;\n    line-height: 2rem;\n    margin-block-start: .5rem;\n    margin-block-end: 0px;\n}\n\nh3 {\n    line-height: 1.25rem;\n    font-size: 1.125rem;\n    font-weight: 700;\n    margin-block-start: 0px;\n    margin-block-end: 0px;\n}\n\nh6 {\n    line-height: 1rem;\n    font-size: 1rem;\n    font-weight: 600;\n    margin-block-start: .25rem;\n    margin-block-end: 0px;\n}\n\nh5 {\n    font-size: 1.125rem;\n    font-weight: 400;\n    margin-block-start: .5rem;\n    margin-block-end: 0px;\n}\n\n.hero, .products, .sports, .quicklinks, .helplinks {\n    background-color: white;\n    color: var(--primary);\n    padding: 5rem 10%;\n    justify-content: center;\n}\n\n.logo {\n    height: 20px;\n    margin-left: 1.5rem;\n    transition-duration: 1000ms;\n\n\n}\n\n.nav {\n    align-items: center;\n    background-color: #283493;\n    color: white;\n    display: none;\n    justify-content: space-between;\n    position: fixed;\n    padding: 0rem 0rem;\n  margin: 0;\n    z-index: 100;\n    width: 100%;\n    height: 52px;\n}\n\n.sidebar {\n    height: 100%;\n    box-shadow: -10px 0 10px rgba(0, 0, 0, 0.1);\n    align-items: flex-start;\n    justify-content: flex-start;\n    background-color: #1a227ef9;\n    backdrop-filter: blur(20px);\n    color: white;\n    display: none;\n    flex-direction: column;\n    position: fixed;\n    top: 0;\n    right: 0;\n    z-index: 999;\n    width: 240px;\n    padding: 0;\n    transition: left 1s ease;\n\n\n    @media (max-width:350px) {\n        width: 100%;\n    }\n}\n\n.sidebar>* {\n    color: white;\n    align-items: flex-start;\n    justify-content: flex-start;\n    padding: 1.15rem 1.5rem;\n    width: 100%;\n  height:54px;\n\n}\n\n.open-menu,\n.close-menu {\n    width: 1.75rem;\n    height: 1.75rem;\n    padding: .75rem 1.15rem;\n    margin-right: 0rem;\n}\n\n.close-menu {\n    justify-content: flex-end;\n}\n\n.nav-links {\n    display: flex;\n    text-decoration: none;\n    margin-right: 1rem;\n    align-items:center;\n}\n\n\n.nav-links>* {\n    text-decoration: none;\n    color: white;\n  padding: 1rem;\n  padding-top: .75rem;\n}\n\n.nav-links>*:hover,\n.open-menu:hover,\n.sidebar>*:hover {\n    background-color: #4552b5;\n  color: white;\n\n}\n\n.wrapper {\n    max-width: 900px;\n    margin-inline: auto;\n}\n\n.hero {\n    background-color: #162173;\n    color: white;\n    background-image: url(https://files.readme.io/92707b6-Basketball_Landing_Page_Desktop.svg), url(https://files.readme.io/8837edc-sidebar-bg-bottom-left.svg);\n    background-repeat: no-repeat;\n    background-position: right -8rem bottom 0px, left -2rem bottom;\n    background-size: 36rem, 12rem;\n    padding-bottom: 5rem;\n    padding-top:8.5rem;\n    align-items: center;\n    transition-duration: 2000ms;\n\n     @media (width:0px) {\n        padding-bottom: 16rem;\n    }\n\n    @media screen and (max-width:620px) {\n        background-size: 24rem, 12rem;\n        background-position: right -8rem bottom 0px, left -2rem bottom;\n        padding-bottom: 8rem;\n    }\n\n    @media screen and (min-width:700px) {\n        background-size: 24rem, 12rem;\n        background-position: right -6rem bottom 0px, left -2rem bottom;\n        padding-bottom: 5rem;\n    }\n\n    @media screen and (min-width:800px)  {\n        background-position: right -16rem bottom 0px, left -2rem bottom;\n    background-size: 36rem, 12rem;\n    padding-bottom: 5rem;\n    }\n\n    @media screen and (orientation:landscape)  {\n        background-position: right -12rem bottom 0px, left -2rem bottom;\n    background-size: 32rem, 12rem;\n    padding-bottom: 5rem;\n    }\n\n    @media screen and (min-width:840px) {\n        background-position: right -10rem bottom 0px, left -2rem bottom;\n        background-size: 36rem, 12rem;\n        padding-bottom: 5rem;\n    }\n\n    @media screen and (min-width:980px) {\n        background-position: right -4rem bottom 0px, left -2rem bottom;\n        background-size: 36rem, 12rem;\n        padding-bottom: 5rem;\n    }\n\n    @media screen and (min-width:1200px) {\n        background-position: right 1rem bottom 0px, left -2rem bottom;\n        background-size: 36rem, 12rem;\n        padding-bottom: 5rem;\n    }\n\n    @media screen and (min-width:1400px) {\n        background-position: right 7rem bottom 0px, left -2rem bottom;\n        background-size: 36rem, 12rem;\n        padding-bottom: 5rem;\n    }\n\n    @media screen and (min-width:1600px) {\n        background-position: right 14rem bottom 0px, left -2rem bottom;\n        background-size: 36rem, 12rem;\n        padding-bottom: 5rem;\n    }\n\n    @media screen and (min-width:1900px) {\n        background-position: right 24rem bottom 0px, left -2rem bottom;\n        background-size: 36rem, 12rem;\n        padding-bottom: 5rem;\n    }\n\n}\n\n@media (max-width:700px) {\n    .hero {\n        background-size: 24rem, 12rem;\n        background-position: right -8rem bottom 0px, left -2rem bottom;\n        padding-bottom: 14rem;\n    }\n}\n\n@media (min-width:750px) {\n    .open-menu {\n        display: none;\n    }\n\n    .nav-link {\n        display: block;\n    }\n}\n\n@media (max-width:750px) {\n    .open-menu {\n        display: block;\n    }\n\n    .nav-links {\n        display: none;\n    }\n}\n\n\n.hero>* {\n    max-width: 900px;\n    margin-left: auto;\n    margin-right: auto;\n}\n\n.hero-links {\n    margin-top: 1rem;\n    display: flex;\n    gap: var(--gridgap);\n    flex-wrap: wrap;\n}\n\n.hero-links>*,\n.cta-1,\n.cta-2 {\n    display: flex;\n    flex-grow: 0;\n    padding: .75rem;\n    text-decoration: none;\n    color: white;\n    min-width: max-content;\n    border-radius: 6px;\n    font-weight: 600;\n}\n\n.cta-1:hover {\n    background-color: #b40a0a;\n  color:white;\n}\n\n.cta-2:hover {\n    background-color: #1045d6;\n    color:white;\n}\n\n.hero-info {\n    display: grid;\n    grid-template-columns: repeat(1, 1fr);\n\n    @media (max-width:750px) {\n        width: 100%;\n    }\n}\n\n.hero-info>* {\n    max-width: 64ch;\n}\n\n.cta-1 {\n    background-color: var(--linkred);\n}\n\n.cta-2 {\n    background-color: var(--linkblue);\n}\n\n.cta-3 {\n    display: flex;\n    justify-content: center;\n    margin-top: 1.5rem;\n    margin-left: auto;\n    margin-right: auto;\n    margin-bottom: 1rem;\n    gap: .5rem;\n    padding: .75rem;\n    text-decoration: none;\n    color: var(--primary);\n    width: 140px;\n    outline-color: #E8EAF6;\n    outline-width: 1px;\n    /*outline-style: solid;*/\n    font-weight: 700;\n}\n\n.cta-4 {\n    display: flex;\n    gap: .5rem;\n    align-items: center;\n    width: 100%;\n    justify-content: space-between;\n}\n\n.right-arrow {\n    padding: 2rem;\n}\n\n/*.hero-links>*:hover {\n    outline: 5px;\n    outline-color: violet;\n    outline: solid;\n}*/\n\n.grid-caption {\n    display: block;\n    text-align: left;\n    padding-bottom: 1rem;\n}\n\n\n.products {\n    background-color: white;\n    color: var(--primary);\n    background-repeat: no-repeat;\n    background-position: right -5rem top 2.5rem;\n    background-size: 30vh;\n    background-image: url(https://files.readme.io/ed67756-bg-login_page.svg);\n}\n\n.product-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: var(--gridgap);\n\n    @media (max-width:850px) {\n        grid-template-columns: repeat(2, 1fr)\n    }\n\n    @media (max-width:600px) {\n        grid-template-columns: repeat(1, 1fr)\n    }\n}\n\n\n\n.product-grid>*,\n.sport-grid>*,\n.league-grid>*,\n.all-sports,\n.quicklinks-grid>*,\n.helplinks-grid>* {\n    background-color: white;\n    border-width: 1px;\n    border-style: solid;\n    border-color: #E8EAF6;\n    padding: 1.125rem 1rem;\n    text-align: center;\n    justify-content: center;\n}\n\n.help-item {\n    display: flex;\n    gap: 1rem;\n}\n\n.right-arrow {\n    position: flex-end;\n}\n\n.helplinks-grid>* {\n    background-color: white;\n    border-width: 1px;\n    border-style: solid;\n    border-color: #E8EAF6;\n    padding: 1.125rem 1rem;\n    text-align: left;\n    justify-content: left;\n}\n\n.product-item {\n    justify-content: left;\n    align-self: auto;\n    min-height: 8rem;\n}\n\n.sports,\n.helplinks {\n    background-color: #FAFAFA;\n    color: #1A237E;\n}\n\n.grid-caption {\n\n    padding-bottom: .625rem;\n\n}\n\n.content {\n    padding-bottom: 3rem;\n\n    @media (min-width:650px) {\n        text-align: center;\n    }\n}\n\n.content-1 {\n    padding-bottom: 2rem;\n    text-align: center;\n}\n\n.league-grid {\n    display: grid;\n    grid-template-columns: repeat(5, 1fr);\n    gap: var(--gridgap);\n    padding-bottom: 2rem;\n\n    @media (max-width:750px) {\n        grid-template-columns: repeat(2, 1fr)\n    }\n\n    @media (max-width:375px) {\n        grid-template-columns: repeat(2, 1fr)\n    }\n}\n\n.sport-grid {\n    display: grid;\n    grid-template-columns: repeat(5, 1fr);\n    gap: var(--gridgap);\n\n    @media (max-width:750px) {\n        grid-template-columns: repeat(2, 1fr)\n    }\n\n    @media (max-width:375px) {\n        grid-template-columns: repeat(2, 1fr)\n    }\n}\n\na {\n    text-decoration: none;\n    color: #1A237E;\n}\n\n.league-icon {\n    padding: 0;\n    margin: 0;\n    width: 40px;\n    height: 40px;\n}\n\n.mlb {\n    width: 40px;\n    height: auto;\n    padding-top: 9.22px;\n    padding-bottom: 9.22px;\n}\n\n.sport-icon {\n    padding: 0;\n    margin: 0;\n    height: 32px;\n}\n\n.product-icon {\n    height: 32px;\n}\n\n.product-title-row {\n    display: flex;\n    justify-content: left;\n    gap: .5rem;\n    align-items: center;\n    text-align: left;\n}\n\n.product-description {\n    text-align: left;\n    ;\n}\n\n.products,\n.sports {\n    justify-content: center;\n    align-items: center;\n    margin-left: auto;\n    margin-right: auto;\n}\n\n.products>*,\n.sports>*,\n.quicklinks>*,\n.helplinks>* {\n    max-width: 900px;\n    justify-content: center;\n    margin-left: auto;\n    margin-right: auto;\n}\n\n.quicklinks-grid,\n.helplinks-grid {\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    gap: var(--gridgap);\n\n    @media (max-width:600px) {\n        grid-template-columns: repeat(1, 1fr)\n    }\n}\n\n.quicklink-image {\n    width: 85%;\n}\n\n.all-sports {\n    grid-column-start: 1;\n    grid-column-end: 6;\n    padding-top: 1.5rem;\n    padding-bottom: 1.5rem;\n\n    @media (max-width:750px) {\n        grid-column-end: 3;\n    }\n}\n\n\n.product-grid>*:hover,\n.sport-grid>*:hover,\n.league-grid>*:hover,\n.sport-grid>*:hover,\n.all-sports:hover,\n.quicklinks-grid>*:hover,\n.helplinks-grid>*:hover {\n    border-color: #1A237E;\n  \tcolor: #1A237E;\n    background-color: rgb(255, 255, 255);\n    box-shadow: 0px 4px 6px rgba(0, 0, 139, 0.149);\n}\n    \n\u003c/style>\n\n  \n  \u003cdiv class=\"nav\">\n        \u003cimg src=\"https://files.readme.io/32d691b-Sportradar_White.svg\" class=\"logo\">\n        \u003cdiv class=\"links\">\n            \u003cdiv class=\"nav-links\">\n                \u003ca href=\"https://developer.sportradar.com/getting-started/docs\">\u003ch6>Documentation\u003c/h6>\u003c/a>\n                \u003ca href=\"https://console.sportradar.com/signup\">\u003ch6>Sign Up\u003c/h6>\u003c/a>\n                \u003ca href=\"https://console.sportradar.com\">\u003ch6>Log In\u003c/h6>\u003c/a>\n                \u003ca href=\"https://sportradar.com/contact/\">\u003ch6>Contact Us\u003c/h6>\u003c/a>\n            \u003c/div>\n            \u003cimg onclick=showSidebar() src=\"https://files.readme.io/ef0021a-menu_hamburger_three_lines.svg\"\n                class=\"open-menu\">\n        \u003c/div>\n    \u003c/div>\n\n    \u003cdiv class=\"sidebar\">\n        \u003cimg onclick=hideSidebar() src=\"https://files.readme.io/c86267b-close_delete_x_exit_collapse.svg\"\n            class=\"close-menu\">\n        \u003ca class=\"link\" href=\"https://developer.sportradar.com/getting-started/docs\">Documentation\u003c/a>\n        \u003ca class=\"link\" href=\"https://console.sportradar.com/signup\">Sign Up\u003c/a>\n        \u003ca class=\"link\" href=\"https://console.sportradar.com\">Log In\u003c/a>\n    \u003c/div>\n\n    \u003cscript>\n        function showSidebar() {\n            const sidebar = document.querySelector('.sidebar')\n            sidebar.style.display = 'flex'\n            sidebar.style.right = '0px'\n\n        }\n\n        function hideSidebar() {\n            const sidebar = document.querySelector('.sidebar')\n            sidebar.style.display = 'none'\n        }\n\n    \u003c/script>\n\n    \u003cdiv class=\"hero\">\n        \u003cdiv class=\"hero-info\">\n            \u003cdiv class=\"hero-text\">\n                \u003cspan class=\"d2\">Sports Data for Developers\u003c/span>\n                \u003cp>You'll find comprehensive guides and documentation to help you start working with Sportradar as\n                    quickly as possible.\u003cbr>\n                    Contact us below if you need help!\u003c/p>\n            \u003c/div>\n            \u003cdiv class=\"hero-links\">\n                \u003ca href=\"https://console.sportradar.com/signup\" class=\"cta-1\">Sign Up For Free Trials\u003c/a>\n                \u003ca href=\"https://developer.sportradar.com/getting-started/docs\" class=\"cta-2\">View Documentation\u003c/a>\n            \u003c/div>\n        \u003c/div>\n    \u003c/div>\n\n    \u003cdiv class=\"products\">\n        \u003cdiv class=\"content\">\n            \u003ch1>Our Products\u003c/h1>\n            \u003cp>We've got state-of-the-art products to power your sport experience. \u003cbr>\n                Select a product below to learn more!\u003c/p>\n        \u003c/div>\n        \u003cdiv class=\"product-grid\">\n            \u003ca class=\"product-item\" href=\"https://developer.sportradar.com/getting-started/docs\">\n                \u003cdiv class=\"product-title-row\">\n                    \u003cimg alt=\"Sports API\" src=\"https://files.readme.io/11f0990-Sports_API.svg\" class=\"product-icon\">\n                    \u003ch3>Sports API\u003c/h3>\n                \u003c/div>\n                \u003cdiv class=\"product-description\">\n                    \u003cp class=\"p2\">\n                        Easy-to-consume API feeds that set the standard for speed and accuracy.\u003c/p>\n                \u003c/div>\n            \u003c/a>\n            \u003ca class=\"product-item\" href=\"https://developer.sportradar.com/insights/reference/overview\">\n                \u003cdiv class=\"product-title-row\">\n                    \u003cimg alt=\"Insights\" src=\"https://files.readme.io/b927e46-Insights_Information-01.svg\"\n                        class=\"product-icon\">\n                    \u003ch3>Insights\u003c/h3>\n                \u003c/div>\n                \u003cdiv class=\"product-description\">\n                    \u003cp class=\"p2\">\n                        Deliver content that converts by adding context to raw sports data.\u003c/p>\n                \u003c/div>\n            \u003c/a>\n            \u003ca class=\"product-item\" href=\"https://developer.sportradar.com/widgets/docs\">\n                \u003cdiv class=\"product-title-row\">\n                    \u003cimg alt=\"Widgets\" src=\"https://files.readme.io/e76011e-Widgets_Performance_widgets.svg\"\n                        class=\"product-icon\">\n                    \u003ch3>Widgets\u003c/h3>\n                \u003c/div>\n                \u003cdiv class=\"product-description\">\n                    \u003cp class=\"p2\">\n                        Engaging content that’s easy to integrate. Perfect for improving your site or testing new ideas.\n                    \u003c/p>\n                \u003c/div>\n            \u003c/a>\n            \u003ca class=\"product-item\" href=\"https://developer.sportradar.com/images-and-editorials/reference/images-overview\">\n                \u003cdiv class=\"product-title-row\">\n                    \u003cimg alt=\"Images\" src=\"https://files.readme.io/31d728f-Images_Visualisation_Image_CMS.svg\"\n                        class=\"product-icon\">\n                    \u003ch3>Images & Editorials\u003c/h3>\n                \u003c/div>\n                \u003cdiv class=\"product-description\">\n                    \u003cp class=\"p2\">\n                        Official logos, headshots, action shots and live news articles from a variety of top publications.\u003c/p>\n                \u003c/div>\n            \u003c/a>\n            \u003ca class=\"product-item\"\n                href=\"https://developer.sportradar.com/broadcast/docs/intro\">\n                \u003cdiv class=\"product-title-row\">\n                    \u003cimg alt=\"Broadcast\"\n                        src=\"https://files.readme.io/ee2bd49-Live_Broadcast_On_Air_Content_Solution.svg\"\n                        class=\"product-icon\">\n                    \u003ch3>Broadcast\u003c/h3>\n                \u003c/div>\n                \u003cdiv class=\"product-description\">\n                    \u003cp class=\"p2\">\n                        All the tools needed to create the most compelling and unforgettable viewing experiences.\u003c/p>\n                \u003c/div>\n            \u003c/a>\n            \u003ca class=\"product-item\" href=\"https://developer.sportradar.com/odds/reference/intro\">\n                \u003cdiv class=\"product-title-row\">\n                    \u003cimg alt=\"Odds Comparison\" src=\"https://files.readme.io/ed8b0ce-Betting_Odds_Comparison.svg\"\n                        class=\"product-icon\">\n                    \u003ch3>Odds Comparison\u003c/h3>\n                \u003c/div>\n                \u003cdiv class=\"product-description\">\n                    \u003cp class=\"p2\">\n                        Props, Futures, Prematch, and Live odds from top bookmakers, including consensus odds.\u003c/span>\n                \u003c/div>\n            \u003c/a>\n        \u003c/div>\n    \u003c/div>\n\n    \u003cdiv class=\"sports\">\n        \u003cdiv class=\"content\">\n            \u003ch1>Our Sports Coverage\u003c/h1>\n            \u003cp>Here’s a quick look at the popular sports and products we cover.\u003cbr>\n                For an in-depth look at our Sports API offering, check out our \u003ca\n                    href=\"https://coverage-matrix.sportradar.com/\" target=\"_blank\">\n                    \u003cfont color=\"#2962FF\">Coverage Matrix\u003c/font>.\n                \u003c/a>\u003c/p>\n        \u003c/div>\n        \u003ch6 class=\"grid-caption\">Popular\u003c/h6>\n\n        \u003cdiv class=\"league-grid\">\n            \u003ca class=\"sport-item\" href=\"https://developer.sportradar.com/basketball/reference/nba-overview\">\n                \u003cimg src=\"https://files.readme.io/9901459-NBA.svg\" class=\"league-icon\">\n                \u003ch6>NBA\u003c/h6>\n            \u003c/a>\n            \u003ca class=\"sport-item\" href=\"https://developer.sportradar.com/football/reference/nfl-overview\">\n                \u003cimg src=\"https://files.readme.io/76aad18-Football_american.svg\" class=\"league-icon\">\n                \u003ch6>NFL\u003c/h6>\n            \u003c/a>\n            \u003ca class=\"sport-item\" href=\"https://developer.sportradar.com/baseball/reference/mlb-overview\">\n                \u003cimg src=\"https://files.readme.io/111b2a7-MLB.svg\" class=\"league-icon mlb\">\n                \u003ch6>MLB\u003c/h6>\n            \u003c/a>\n            \u003ca class=\"sport-item\" href=\"https://developer.sportradar.com/ice-hockey/reference/nhl-overview\">\n                \u003cimg src=\"https://files.readme.io/f47fe38-NHL.svg\" class=\"league-icon\">\n                \u003ch6>NHL\u003c/h6>\n            \u003c/a>\n            \u003ca class=\"sport-item\" href=\"https://developer.sportradar.com/football/reference/ncaafb-overview\">\n                \u003cimg src=\"https://files.readme.io/a763fc3-NCAA.svg\" class=\"league-icon\">\n                \u003ch6>NCAA FB\u003c/h6>\n            \u003c/a>\n        \u003c/div>\n\n        \u003ch6 class=\"grid-caption\">Browse By Sport\u003c/h6>\n\n        \u003cdiv class=\"sport-grid\">\n            \u003ca class=\"sport-item\" href=\"https://developer.sportradar.com/soccer/reference/soccer-api-overview\">\n                \u003cimg src=\"https://files.readme.io/1505fcb-Soccer_Football-01.svg\" class=\"sport-icon\">\n                \u003ch6>Soccer\u003c/h6>\n                \u003c/av>\n                \u003ca class=\"sport-item\" href=\"https://developer.sportradar.com/tennis/reference/overview\">\n                    \u003cimg src=\"https://files.readme.io/dae654b-Tennis-01.svg\" class=\"sport-icon\">\n                    \u003ch6>Tennis\u003c/h6>\n                \u003c/a>\n                \u003ca class=\"sport-item\" href=\"https://developer.sportradar.com/cricket/reference/cricket-overview\">\n                    \u003cimg src=\"https://files.readme.io/f88524c-Cricket-01.svg\" class=\"sport-icon\">\n                    \u003ch6>Cricket\u003c/h6>\n                \u003c/a>\n                \u003ca class=\"sport-item\" href=\"https://developer.sportradar.com/golf/reference/golf-overview\">\n                    \u003cimg src=\"https://files.readme.io/bb0f1be-Golf-01.svg\" class=\"sport-icon\">\n                    \u003ch6>Golf\u003c/h6>\n                \u003c/a>\n\n                \u003ca class=\"sport-item\" href=\"https://developer.sportradar.com/racing/reference/overview\">\n                    \u003cimg src=\"https://files.readme.io/d92d012-Racing_flag.svg\" class=\"sport-icon\">\n                    \u003ch6>Racing\u003c/h6>\n                \u003c/a>\n                \u003ca class=\"sport-item\"\n                    href=\"https://developer.sportradar.com/aussie-rules-football/reference/aussie-rules-overview\">\n                    \u003cimg src=\"https://files.readme.io/2ccc210-Rugby_Aussie_Rules-01.svg\" class=\"sport-icon\">\n                    \u003ch6>Aussie Rules\u003c/h6>\n                \u003c/a>\n                \u003ca class=\"sport-item\" href=\"https://developer.sportradar.com/baseball/reference/overview\">\n                    \u003cimg src=\"https://files.readme.io/64ab4db-Baseball_US_Sports-01.svg\" class=\"sport-icon\">\n                    \u003ch6>Baseball\u003c/h6>\n                \u003c/a>\n                \u003ca class=\"sport-item\" href=\"https://developer.sportradar.com/basketball/reference/overview\">\n                    \u003cimg src=\"https://files.readme.io/8c7af1a-Basketball_NBA-01.svg\" class=\"sport-icon\">\n                    \u003ch6>Basketball\u003c/h6>\n                \u003c/a>\n                \u003ca class=\"sport-item\" href=\"https://developer.sportradar.com/football/reference/overview\">\n                    \u003cimg src=\"https://files.readme.io/76aad18-Football_american.svg\" class=\"sport-icon\">\n                    \u003ch6>Football\u003c/h6>\n                \u003c/a>\n                \u003ca class=\"sport-item\" href=\"https://developer.sportradar.com/ice-hockey/reference/overview\">\n                    \u003cimg src=\"https://files.readme.io/89856ec-Ice_Hockey_US_Sports.s