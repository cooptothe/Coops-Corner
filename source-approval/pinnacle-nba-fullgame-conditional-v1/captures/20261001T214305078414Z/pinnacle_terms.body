            var _this = $(this);
            _this.nextUntil(".content-container .terms-and-conditions h2").wrapAll("<div class='mobile-container' />")
        });

        var accordion = $(".content-container .terms-and-conditions .accordion-toggle");
        accordion.click(function () {
            var _this = $(this);
            _this.next().slideToggle('fast');
            _this.find(".arrow-up, .arrow-down").toggle();

